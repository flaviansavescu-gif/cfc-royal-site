---
// VerificaPedigree.astro — verificarea publică a unui Certificat de Origine.
// Randată la două adrese: /verifica-pedigree/ (română) și /en/verifica-pedigree/
// (engleză). Limba se fixează la generare, ca antetul și corpul paginii să spună
// același lucru.
//
// Ținta codului QR de pe act. Fără cod de acces: oricine ține certificatul în mână —
// un cumpărător, un arbitru la intrarea în ring, o altă asociație — trebuie să poată
// afla în două secunde dacă e real.
//
// Se arată DOAR identitatea câinelui și tipul certificatului. Numele și adresa
// proprietarului nu au ce căuta la o adresă publică pe care o poate deschide oricine
// fotografiază un act. Afixul crescătorului se arată: e numele unei canise, public prin
// natura lui.
import type { Lang } from "../i18n/ui";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const T = (ro: string, en: string) => (lang === "en" ? en : ro);

// Fișa completă trebuie să se deschidă în aceeași limbă cu verificarea.
const bazaFisa = lang === "en" ? "/en/caine/" : "/caine/";
---

<section class="v-sect" data-limba={lang} data-fisa={bazaFisa}>
  {/* Fără comutator propriu: pagina ascultă de cel din antet, comun întregului site. */}
  <p class="v-eyebrow">{T("Registrul genealogic", "Stud book")}</p>
  <h1 class="v-title">{T("Verificarea certificatului", "Verify a certificate")}</h1>
  <p class="v-sub">
    {T(
      "Scrie seria de pe certificat sau scanează codul QR de pe act. Verificarea arată datele de identificare ale câinelui, așa cum sunt înregistrate la asociație.",
      "Enter the serial number printed on the certificate, or scan the QR code on it. The check shows the dog's identification data exactly as recorded by the association.",
    )}
  </p>

  <form class="v-form" id="v-form">
    <label for="v-serie">{T("Seria certificatului", "Certificate serial number")}</label>
    <input id="v-serie" name="serie" type="text" placeholder="ex. CFCR-P-2026-0001"
           autocomplete="off" spellcheck="false" required />
    <button class="btn btn--primary" type="submit">{T("Verifică", "Verify")}</button>
  </form>

  <p class="v-eroare" id="v-eroare" role="alert" hidden></p>

  <div class="v-rezultat" id="v-rezultat" hidden>
    <p class="v-valid" id="v-valid"></p>
    <table class="v-tabel" id="v-tabel"></table>
    <p class="v-fisa" id="v-fisa" hidden>
      <a class="btn btn--outline" href={bazaFisa}>
        {T(
          "Vezi fișa completă: ascendență, frați de cuib, descendenți →",
          "Open the full record: pedigree, littermates, progeny →",
        )}
      </a>
    </p>
    <p class="v-nota">
      {T(
        "Verificarea confirmă că seria există în registrul asociației și că datele afișate sunt cele înregistrate. Datele proprietarului nu se afișează public. Pentru orice neconcordanță între actul tipărit și această pagină, scrie la contact@cfc-royal.ro.",
        "The check confirms that the serial number exists in the association's register and that the data shown is what was recorded. Owner details are not published. For any discrepancy between the printed certificate and this page, write to contact@cfc-royal.ro.",
      )}
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    const F = "/.netlify/functions/registru-pedigree";
    const sectiune = document.querySelector(".v-sect");
    const form = document.getElementById("v-form");
    const input = document.getElementById("v-serie");
    const eroare = document.getElementById("v-eroare");
    const rezultat = document.getElementById("v-rezultat");

    const el = (tag, cls, text) => {
      const x = document.createElement(tag);
      if (cls) x.className = cls;
      if (text != null) x.textContent = text;
      return x;
    };

    // —— Limba ——
    // Fixată la generarea paginii. Pentru engleză există o adresă proprie,
    // /en/verifica-pedigree/, cu antetul și meniul traduse.
    const limba = sectiune.dataset.limba === "en" ? "en" : "ro";
    const BAZA_FISA = sectiune.dataset.fisa || "/caine/";

    // Textele construite din date (cele fixe sunt deja randate în limba paginii).
    const L = {
      ro: {
        valabil: (s) => "✓ Certificatul " + s + " este înregistrat și valabil.",
        anulat: (s) => "⚠ Certificatul " + s + " a fost ANULAT.",
        tip: "Tipul certificatului", tipA: " — ascendență completă pe patru generații",
        tipB: " — ascendență incompletă",
        nume: "Numele câinelui", rasa: "Rasa", sex: "Sexul", mascul: "mascul", femela: "femelă",
        nastere: "Data nașterii", culoare: "Culoarea", microcip: "Microcip / tatuaj",
        cuib: "Nr. cuib WDF", afix: "Afixul crescătorului", emitere: "Data emiterii",
        seCauta: "Se verifică…", butonul: "Verifică", esec: "Verificarea a eșuat.",
      },
      en: {
        valabil: (s) => "✓ Certificate " + s + " is registered and valid.",
        anulat: (s) => "⚠ Certificate " + s + " has been CANCELLED.",
        tip: "Certificate type", tipA: " — complete four-generation pedigree",
        tipB: " — incomplete pedigree",
        nume: "Dog's name", rasa: "Breed", sex: "Sex", mascul: "male", femela: "female",
        nastere: "Date of birth", culoare: "Colour", microcip: "Microchip / tattoo",
        cuib: "WDF litter no.", afix: "Breeder's affix", emitere: "Date of issue",
        seCauta: "Checking…", butonul: "Verify", esec: "The check failed.",
      },
    };

    const dataRo = (s) => {
      const x = new Date(s);
      return isNaN(x) ? String(s || "") : x.toLocaleDateString(limba === "ro" ? "ro-RO" : "en-GB");
    };

    function deseneaza(c) {
      const T = L[limba];
      const valid = document.getElementById("v-valid");
      valid.className = "v-valid " + (c.anulat ? "is-anulat" : "is-bun");
      valid.textContent = c.anulat ? T.anulat(c.serie) : T.valabil(c.serie);

      const t = document.getElementById("v-tabel");
      t.textContent = "";
      const rand = (a, b) => {
        const tr = document.createElement("tr");
        tr.appendChild(el("th", null, a));
        tr.appendChild(el("td", null, b || "—"));
        t.appendChild(tr);
      };
      rand(T.tip, "Tip " + c.tip + (c.tip === "A" ? T.tipA : T.tipB));
      rand(T.nume, c.caine.nume);
      rand(T.rasa, c.caine.rasa + (c.caine.varietate ? " · " + c.caine.varietate : ""));
      rand(T.sex, c.caine.sex === "M" ? T.mascul : T.femela);
      rand(T.nastere, dataRo(c.caine.dataNasterii));
      rand(T.culoare, c.caine.culoare);
      rand(T.microcip, c.caine.microcip);
      rand(T.cuib, c.numarWDF);
      rand(T.afix, c.afixCrescator);
      rand(T.emitere, dataRo(c.emis));

      const catreFisa = document.getElementById("v-fisa");
      catreFisa.hidden = false;
      catreFisa.querySelector("a").href = BAZA_FISA + "?r=" + encodeURIComponent(c.serie);
      rezultat.hidden = false;
    }

    async function verifica(serie) {
      eroare.hidden = true;
      rezultat.hidden = true;
      const btn = form.querySelector("button[type=submit]");
      btn.disabled = true; btn.textContent = L[limba].seCauta;
      try {
        const r = await fetch(F, { method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ actiune: "verifica", serie }) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.eroare || L[limba].esec);
        deseneaza(d.certificat);
      } catch (err) {
        eroare.hidden = false;
        eroare.textContent = err.message;
      }
      btn.disabled = false; btn.textContent = L[limba].butonul;
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const s = input.value.trim().toUpperCase();
      if (s) verifica(s);
    });

    // Comutatorul din antet e generat static, deci nu știe ce certificat e cerut.
    // Îi lipim parametrii din adresă, ca trecerea în cealaltă limbă să păstreze seria.
    (function () {
      const a = document.querySelector(".langswitch__link");
      if (a) a.href = a.getAttribute("href").split("?")[0] + location.search;
    })();

    // Venit prin QR: seria e deja în adresă, deci verificăm pe loc.
    const dinAdresa = (new URLSearchParams(location.search).get("s") || "").trim().toUpperCase();
    if (dinAdresa) { input.value = dinAdresa; verifica(dinAdresa); }
  })();
</script>

<style>
  .v-sect { max-width: 46rem; margin-inline: auto; padding: 3rem 1.25rem 4rem; }
  .v-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; color: var(--color-accent-dark); margin: 0; }
  .v-title { font-family: var(--font-serif); color: var(--color-primary); margin: 0.35rem 0 0.5rem; }
  .v-sub { color: var(--color-text-muted); }
  .v-form { display: grid; gap: 0.6rem; max-width: 24rem; margin: 2rem 0; }
  .v-form label { font-weight: 600; color: var(--color-primary); }
  .v-form input { padding: 0.7rem 0.9rem; border: 1px solid var(--color-border);
    border-radius: var(--radius); font-size: 1.02rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .v-form .btn { justify-self: start; }
  .v-eroare { padding: 0.7rem 1rem; border-radius: var(--radius);
    background: #f9efef; border: 1px solid #8c1d2f; color: #8c1d2f; }
  .v-eroare[hidden],
  .v-rezultat[hidden] { display: none; }
  :global(.v-valid) { padding: 0.8rem 1rem; border-radius: var(--radius); font-weight: 700; }
  :global(.v-valid.is-bun) { background: #eef5f0; border: 1px solid var(--color-primary); color: var(--color-primary); }
  :global(.v-valid.is-anulat) { background: #f9efef; border: 1px solid #8c1d2f; color: #8c1d2f; }
  .v-tabel { border-collapse: collapse; width: 100%; margin-top: 1rem; }
  :global(.v-tabel th),
  :global(.v-tabel td) { text-align: left; padding: 0.45rem 0.6rem; font-size: 0.92rem;
    border-bottom: 1px solid var(--color-border); }
  :global(.v-tabel th) { color: var(--color-primary); width: 42%; font-weight: 600; }
  .v-fisa[hidden] { display: none; }
  .v-fisa { margin-top: 1.2rem; }
  .v-nota { font-size: 0.85rem; color: var(--color-text-muted); margin-top: 1.2rem; }
  .v-nota a { color: var(--color-accent-dark); }
</style>
