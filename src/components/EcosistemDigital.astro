---
// EcosistemDigital.astro — pagina de prezentare a ecosistemului digital CFC-Royal:
// CINCI piloni (Site · Școala de Arbitraj · Manager de Expoziții · Registrul genealogic ·
// Registratura), fluxurile dintre ei și nucleul comun. Bilingv RO/EN.
//
// Au fost trei până în iulie 2026. Registrul genealogic exista deja, dar era socotit o
// parte a site-ului; Registratura s-a adăugat ca al cincilea. Sunt piloni, nu module: un
// pilon poate fi scos doar dărâmând clădirea. Fără registru nu există pedigree, iar fără
// Registratură pedigree-ul e o părere frumos tipărită.
interface Props { lang: "ro" | "en"; }
const { lang } = Astro.props;

const T = {
  ro: {
    kicker: "Ecosistemul digital",
    titlu: "Ecosistemul Digital CFC-Royal",
    tagline: "Tehnologie. Transparență. Profesionalism. Totul pentru viitorul chinologiei.",
    imgAlt: "Ecosistemul digital CFC-Royal — site-ul oficial, Școala de Arbitraj, Managerul de Expoziții, Registrul genealogic și Registratura, cu un laptop, un telefon și o carte de origine.",
    imgCaption: "Cinci piloni, un singur scop — dezvoltarea responsabilă a chinologiei.",

    intro: "Asociația Club Federal Chinologic – Royal își desfășoară activitatea pe cinci piloni proprii, construiți integral pe regulamentele World Dog Federation și legați între ei printr-un nucleu comun. Împreună, ei acoperă întregul parcurs al chinologiei de performanță: formarea arbitrilor, organizarea expozițiilor, evidența originilor și verificarea actelor. Fiecare informație are o singură sursă de adevăr și circulă automat acolo unde e nevoie de ea.",

    piloniTitlu: "Cinci piloni, un singur ecosistem",
    piloni: [
      {
        icon: "🌐", nume: "Site-ul oficial", sub: "Asociația Club Federal Chinologic – Royal",
        desc: "Prezența oficială și comunicarea cu comunitatea chinologică.",
        feats: ["Informații, noutăți și proiecte", "Comunitate și membri", "Evenimente și calendar expozițional", "Documente publice și regulamente"],
        link: "/ro/organizatia/despre", linkTxt: "Despre asociație →",
      },
      {
        icon: "🎓", nume: "Școala de Arbitraj", sub: "Centrul de Dezvoltare a Competențelor Chinologice",
        desc: "Pregătirea și formarea arbitrilor, pe standardele WDF.",
        feats: ["Module de studiu și resurse educaționale", "Examene și certificări pe grupe WDF", "Asistențe la ring și dosar de stagiu", "Formare continuă și menținere"],
        link: "/ro/educatie/centrul-competentelor-chinologice", linkTxt: "Descoperă Școala →",
      },
      {
        icon: "🏆", nume: "Managerul de Expoziții", sub: "CFC-Royal Expo Manager",
        desc: "Organizarea expozițiilor, din înscriere până la diplomă.",
        feats: ["Înscrieri online și administrarea ringurilor", "Arbitraj pe ecran, cu calificative WDF", "Cataloage, rezultate și diplome", "Statistici și evidența performanțelor"],
        link: "/ro/manager-expozitii", linkTxt: "Descoperă Managerul →",
      },
      {
        icon: "📜", nume: "Registrul genealogic", sub: "Cartea de origini · Certificate Pedigree",
        desc: "Pilonul central: evidența originilor și trasabilitatea lor.",
        feats: ["Declarații de montă și fătare", "Ascendență pe patru generații", "Certificate Pedigree cu număr de cuib WDF", "Verificare publică prin cod QR"],
        link: "/verifica-pedigree/", linkTxt: "Verifică un certificat →",
      },
      {
        icon: "🗂️", nume: "Registratura", sub: "Al cincilea pilon al asociației",
        desc: "Pilonul care le ține pe toate la un loc: verificarea actelor.",
        feats: ["Verificarea dosarelor de montă și fătare", "Verificarea înscrierilor la expoziții", "Transcrierea ascendenței și tipul certificatului", "Urmă documentată la fiecare verificare"],
        link: "/ro/registratura", linkTxt: "Descoperă Registratura →",
      },
    ],

    fluxTitlu: "Cum lucrează împreună",
    fluxIntro: "Pilonii nu sunt insule: informația circulă între ei automat și securizat.",
    flux: [
      "Managerul publică expoziția pe site → membrii se înscriu online → Registratura verifică actele și dovada plății → abia apoi înscrierile intră în catalog.",
      "În ziua expoziției, programul ringurilor e transmis live pe site, iar adresele rămân stabile pentru codurile QR tipărite.",
      "Rezultatele oficiale (doar titlurile) se publică automat pe site și ajung pe fișa fiecărui câine din registrul genealogic.",
      "Crescătorul depune declarația de montă și fătare, proprietarul masculului o confirmă, Registratura verifică dosarul — și abia apoi se emite Certificatul Pedigree, verificabil public prin cod QR.",
      "Candidații de arbitru sunt numiți în Școală, iar prestația lor la stagiul practic e evaluată în Manager și consemnată în dosarul lor.",
      "Arbitrii certificați de Școală apar automat în registrul public, iar autorizările lor pe grupe ghidează repartizarea din Manager.",
    ],

    nucleuTitlu: "Nucleul ecosistemului digital",
    nucleu: [
      { t: "Autentificare unică (SSO)", d: "Acces simplu și securizat pentru toate platformele." },
      { t: "Bază de date comună", d: "Informații centralizate, coerente și mereu actualizate." },
      { t: "Sincronizare în timp real", d: "Date actualizate instant între toate modulele ecosistemului." },
      { t: "Drepturi de acces", d: "Roluri și permisiuni clare pentru fiecare utilizator." },
      { t: "Istoric și audit", d: "Evidența completă a acțiunilor și modificărilor." },
      { t: "API intern și integrări", d: "Extensibil și pregătit pentru integrări viitoare." },
    ],

    scopTitlu: "Un singur scop: dezvoltarea responsabilă a chinologiei",
    scopText: "Tot ce construim pornește de la aceeași convingere: chinologia de performanță merită instrumente pe măsură. De la formarea riguroasă a arbitrilor, la expoziții organizate impecabil și documente pe care oricine le poate verifica — ecosistemul digital CFC-Royal ridică standardul pentru întreaga comunitate.",

    ctaBtnEdu: "Educație și cursuri",
    ctaBtnMgr: "Manager de Expoziții",
    ctaBtnReg: "Registratura",
    ctaBtnInsc: "Înscriere la expoziție",
    wdf: "Club Federal Chinologic – Royal · Membru World Dog Federation",
  },
  en: {
    kicker: "The digital ecosystem",
    titlu: "The CFC-Royal Digital Ecosystem",
    tagline: "Technology. Transparency. Professionalism. All for the future of cynology.",
    imgAlt: "The CFC-Royal digital ecosystem — the official website, the Judging School, the Exhibition Manager, the stud book and the Registry Office, with a laptop, a phone and a certificate of origin.",
    imgCaption: "Five pillars, one goal — the responsible development of cynology.",

    intro: "The Royal Federal Canine Club operates on five dedicated pillars, built entirely on World Dog Federation regulations and linked by a common core. Together, they cover the whole journey of competitive cynology: training judges, organising shows, recording origins and verifying documents. Every piece of information has a single source of truth and flows automatically to where it is needed.",

    piloniTitlu: "Five pillars, one ecosystem",
    piloni: [
      {
        icon: "🌐", nume: "The official website", sub: "Royal Federal Canine Club",
        desc: "Official presence and communication with the cynological community.",
        feats: ["Information, news and projects", "Community and members", "Events and show calendar", "Public documents and regulations"],
        link: "/en/organizatia/despre", linkTxt: "About us →",
      },
      {
        icon: "🎓", nume: "The Judging School", sub: "Centre for the Development of Cynological Competencies",
        desc: "Training and forming judges, to WDF standards.",
        feats: ["Study modules and educational resources", "Examinations and WDF-group certification", "Ring assistantships and training file", "Continuing education and maintenance"],
        link: "/en/educatie/centrul-competentelor-chinologice", linkTxt: "Explore the School →",
      },
      {
        icon: "🏆", nume: "The Exhibition Manager", sub: "CFC-Royal Expo Manager",
        desc: "Running shows, from entry to diploma.",
        feats: ["Online entries and ring administration", "On-screen judging with WDF gradings", "Catalogues, results and diplomas", "Statistics and performance records"],
        link: "/en/manager-expozitii", linkTxt: "Explore the Manager →",
      },
      {
        icon: "📜", nume: "The stud book", sub: "Book of origins · Pedigree Certificates",
        desc: "The central pillar: the record of origins and their traceability.",
        feats: ["Mating and whelping declarations", "Four generations of ancestry", "Pedigree Certificates with a WDF litter number", "Public verification by QR code"],
        link: "/verifica-pedigree/", linkTxt: "Verify a certificate →",
      },
      {
        icon: "🗂️", nume: "The Registry Office", sub: "The association's fifth pillar",
        desc: "The pillar that holds the others together: checking the documents.",
        feats: ["Checking mating and whelping files", "Checking show entries", "Transcribing ancestry and setting the certificate type", "A documented trace at every check"],
        link: "/en/registratura", linkTxt: "Explore the Registry Office →",
      },
    ],

    fluxTitlu: "How they work together",
    fluxIntro: "The pillars are not islands: information flows between them automatically and securely.",
    flux: [
      "The Manager publishes the show on the site → members enter online → the Registry Office checks the documents and the proof of payment → only then do entries reach the catalogue.",
      "On show day, the ring schedule is broadcast live on the site, and addresses stay stable for the printed QR codes.",
      "Official results (titles only) are published automatically on the site and reach each dog's record in the stud book.",
      "The breeder files the mating and whelping declaration, the sire's owner confirms it, the Registry Office checks the file — and only then is the Pedigree Certificate issued, publicly verifiable by QR code.",
      "Judge candidates are appointed in the School, and their practical-stage performance is assessed in the Manager and recorded in their file.",
      "Judges certified by the School appear automatically in the public register, and their group authorisations guide ring assignments in the Manager.",
    ],

    nucleuTitlu: "The core of the digital ecosystem",
    nucleu: [
      { t: "Single sign-on (SSO)", d: "Simple, secure access across all platforms." },
      { t: "Shared database", d: "Centralised, consistent and always up-to-date information." },
      { t: "Real-time sync", d: "Data updated instantly across all modules." },
      { t: "Access rights", d: "Clear roles and permissions for every user." },
      { t: "History and audit", d: "Full record of actions and changes." },
      { t: "Internal API & integrations", d: "Extensible and ready for future integrations." },
    ],

    scopTitlu: "One goal: the responsible development of cynology",
    scopText: "Everything we build starts from the same conviction: competitive cynology deserves tools worthy of it. From rigorous judge training, to flawlessly organised shows and documents anyone can verify — the CFC-Royal digital ecosystem raises the standard for the whole community.",

    ctaBtnEdu: "Education & courses",
    ctaBtnMgr: "Exhibition Manager",
    ctaBtnReg: "Registry Office",
    ctaBtnInsc: "Show entry",
    wdf: "Club Federal Chinologic – Royal · World Dog Federation member",
  },
}[lang];

const IMG = "/images/ecosistem-cfc-royal.webp";
const linkEdu = lang === "en" ? "/en/educatie/centrul-competentelor-chinologice" : "/ro/educatie/centrul-competentelor-chinologice";
const linkMgr = lang === "en" ? "/en/manager-expozitii" : "/ro/manager-expozitii";
const linkInsc = lang === "en" ? "/en/inscriere-expozitie" : "/ro/inscriere-expozitie";
const linkReg = lang === "en" ? "/en/registratura" : "/ro/registratura";
---

<article class="ec">
  <header class="ec__hero">
    <p class="ec__kicker">{T.kicker}</p>
    <h1 class="ec__titlu">{T.titlu}</h1>
    <p class="ec__tagline">{T.tagline}</p>
  </header>

  <figure class="ec__fig">
    <img src={IMG} alt={T.imgAlt} width="1254" height="1254" loading="eager" />
    <figcaption>{T.imgCaption}</figcaption>
  </figure>

  <p class="ec__intro">{T.intro}</p>

  <section class="ec__sect">
    <h2 class="ec__h2">{T.piloniTitlu}</h2>
    <div class="ec__piloni">
      {T.piloni.map((p) => (
        <div class="ec__pilon">
          <div class="ec__pilon-cap"><span class="ec__pilon-ic">{p.icon}</span></div>
          <h3>{p.nume}</h3>
          <p class="ec__pilon-sub">{p.sub}</p>
          <p class="ec__pilon-desc">{p.desc}</p>
          <ul>{p.feats.map((f) => <li>{f}</li>)}</ul>
          <a class="ec__pilon-link" href={p.link}>{p.linkTxt}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="ec__sect">
    <h2 class="ec__h2">{T.fluxTitlu}</h2>
    <p class="ec__lead">{T.fluxIntro}</p>
    <ol class="ec__flux">
      {T.flux.map((f, i) => (
        <li><span class="ec__num">{i + 1}</span><span>{f}</span></li>
      ))}
    </ol>
  </section>

  <section class="ec__sect ec__sect--dark">
    <h2 class="ec__h2 ec__h2--light">{T.nucleuTitlu}</h2>
    <div class="ec__nucleu">
      {T.nucleu.map((n) => (
        <div class="ec__chip">
          <h3>{n.t}</h3>
          <p>{n.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="ec__scop">
    <h2>★ {T.scopTitlu} ★</h2>
    <p>{T.scopText}</p>
    <div class="ec__cta-btns">
      <a class="btn btn--primary" href={linkMgr}>{T.ctaBtnMgr}</a>
      <a class="btn btn--ghost" href={linkEdu}>{T.ctaBtnEdu}</a>
      <a class="btn btn--ghost" href={linkReg}>{T.ctaBtnReg}</a>
      <a class="btn btn--ghost" href={linkInsc}>{T.ctaBtnInsc}</a>
    </div>
    <p class="ec__wdf">{T.wdf}</p>
  </section>
</article>

<style>
  .ec { max-width: 62rem; margin-inline: auto; }
  .ec__hero { text-align: center; max-width: 48rem; margin-inline: auto; }
  .ec__kicker { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; font-weight: 700; color: var(--color-accent-dark); margin: 0 0 0.5rem; }
  .ec__titlu { font-family: var(--font-serif); color: var(--color-primary); font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.08; margin: 0 0 0.6rem; text-wrap: balance; }
  .ec__tagline { color: var(--color-text-muted); font-size: 1.1rem; line-height: 1.6; }

  .ec__fig { margin: 2.25rem 0 0; }
  .ec__fig img { width: 100%; height: auto; display: block; border-radius: var(--radius); border: 1px solid var(--color-border); box-shadow: 0 8px 30px rgba(22, 58, 44, 0.14); }
  .ec__fig figcaption { text-align: center; color: var(--color-text-muted); font-size: 0.9rem; font-style: italic; margin-top: 0.7rem; }

  .ec__intro { margin: 2rem auto 0; max-width: 52rem; color: var(--color-text); font-size: 1.06rem; line-height: 1.7; }

  .ec__h2 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.6rem; margin: 0 0 0.6rem; text-align: center; }
  .ec__h2--light { color: #fbfaf7; }
  .ec__lead { color: var(--color-text-muted); font-size: 1.02rem; line-height: 1.6; text-align: center; max-width: 46rem; margin: 0 auto; }
  .ec__sect { margin-top: 3rem; }

  .ec__piloni { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); margin-top: 1.5rem; }
  .ec__pilon { background: var(--color-surface); border: 1px solid var(--color-border); border-top: 4px solid var(--color-primary); border-radius: var(--radius); padding: 1.4rem 1.35rem; display: flex; flex-direction: column; }
  .ec__pilon-cap { display: flex; justify-content: center; margin-bottom: 0.5rem; }
  .ec__pilon-ic { font-size: 2rem; line-height: 1; }
  .ec__pilon h3 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.25rem; text-align: center; margin: 0 0 0.15rem; }
  .ec__pilon-sub { text-align: center; color: var(--color-accent-dark); font-size: 0.82rem; font-weight: 600; margin: 0 0 0.75rem; line-height: 1.35; }
  .ec__pilon-desc { color: var(--color-text); font-size: 0.98rem; line-height: 1.55; margin: 0 0 0.75rem; }
  .ec__pilon ul { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.45rem; }
  .ec__pilon li { position: relative; padding-left: 1.25rem; color: var(--color-text-muted); font-size: 0.92rem; line-height: 1.45; }
  .ec__pilon li::before { content: "✓"; position: absolute; left: 0; color: var(--color-primary); font-weight: 700; }
  .ec__pilon-link { margin-top: auto; font-weight: 600; color: var(--color-primary); text-decoration: none; }
  .ec__pilon-link:hover { color: var(--color-accent-dark); }

  .ec__flux { list-style: none; margin: 1.3rem auto 0; max-width: 50rem; padding: 0; display: grid; gap: 0.9rem; }
  .ec__flux li { display: flex; gap: 0.85rem; align-items: flex-start; color: var(--color-text); line-height: 1.55; }
  .ec__num { flex: 0 0 auto; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--color-accent); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 0.95rem; }

  .ec__sect--dark { background: var(--color-primary-dark); border-radius: var(--radius); padding: 2rem 1.6rem; }
  .ec__nucleu { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin-top: 1.3rem; }
  .ec__chip { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(176, 141, 46, 0.4); border-radius: var(--radius); padding: 0.95rem 1.1rem; }
  .ec__chip h3 { font-size: 0.98rem; color: var(--color-accent); margin: 0 0 0.3rem; }
  .ec__chip p { margin: 0; color: #e8e5db; font-size: 0.9rem; line-height: 1.5; }

  .ec__scop { margin-top: 3rem; text-align: center; background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 2.25rem 1.6rem; }
  .ec__scop h2 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.55rem; letter-spacing: 0.02em; margin: 0 0 0.6rem; }
  .ec__scop > p { color: var(--color-text-muted); max-width: 44rem; margin: 0 auto 1.4rem; line-height: 1.65; }
  .ec__cta-btns { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .btn--ghost { background: transparent; color: var(--color-primary); border: 1px solid var(--color-primary); padding: 0.6rem 1.2rem; border-radius: var(--radius); font-weight: 600; text-decoration: none; }
  .ec__wdf { margin: 1.5rem 0 0; font-size: 0.82rem; letter-spacing: 0.03em; color: var(--color-text-muted); }

  @media (max-width: 480px) { .ec__sect--dark, .ec__scop { padding-inline: 1.1rem; } }
</style>
