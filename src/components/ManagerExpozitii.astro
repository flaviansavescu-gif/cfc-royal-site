---
// ManagerExpozitii.astro — pagina-vitrină a CFCR Expo Manager: descrierea aplicației
// și scopul ei, orientat spre PROFESIONALISM și servicii de calitate pentru membri.
// Bilingv RO/EN. Design instituțional (tokens). Infograficul ecosistemului sus.
interface Props { lang: "ro" | "en"; }
const { lang } = Astro.props;

const T = {
  ro: {
    kicker: "Infrastructura digitală a expozițiilor",
    titlu: "Manager de Expoziții CFC-Royal",
    intro: "Fiecare expoziție a Clubului Federal Chinologic – Royal este condusă de o platformă proprie, construită integral pe regulamentele World Dog Federation. Scopul ei este unul singur: profesionalism și servicii de calitate pentru membrii noștri, de la prima înscriere până la certificatul oficial.",
    imgAlt: "Ecosistemul digital CFC-Royal — Școala de Arbitraj, Managerul de Expoziții și Site-ul Asociației, legate printr-un nucleu comun.",
    imgCaption: "Ecosistemul digital CFC-Royal: trei platforme, un singur scop — excelență în chinologie.",

    deQuoTitlu: "De ce contează pentru tine, ca membru",
    deQuo: "Nu e doar un instrument intern. Este garanția că expoziția la care participi se desfășoară corect, transparent și cu acte pe care le poți verifica oricând.",

    benefTitlu: "Ce îți oferă",
    benef: [
      { t: "Înscriere online simplă", d: "Îți înscrii câinele de pe telefon în câteva minute, cu confirmare imediată pe e-mail. Clasa de concurs se verifică automat după vârstă, iar taxa și datele de plată îți sunt afișate clar." },
      { t: "Transparență în ziua expoziției", d: "Un panou public, actualizat în timp real, îți arată ce rasă se arbitrează acum și la ce oră estimativă intri în ring — orele se recalculează din ritmul real al arbitrajului." },
      { t: "Arbitraj riguros, conform WDF", d: "Calificativele, plasamentele și titlurile (CAJC, CAC, CACIB, BOB, Best in Show) urmează exact Regulamentul Oficial WDF, cu reguli impuse la fiecare pas — fără erori, fără improvizații." },
      { t: "Documente oficiale, imediat", d: "După expoziție primești pe e-mail, într-un singur mesaj, diploma, fișa de arbitraj și certificatele câștigate — fiecare cu serie, număr și cod QR de verificare." },
      { t: "Certificate care se pot verifica", d: "Orice act emis poartă un cod QR: oricine îl scanează confirmă pe loc autenticitatea, direct pe cfc-royal.ro. Un titlu CFC-Royal nu poate fi contrafăcut." },
      { t: "Palmares și campionate", d: "Titlurile câinelui tău se acumulează de la o ediție la alta. Sistemul urmărește automat îndeplinirea condițiilor de campionat, conform Art. 39 WDF." },
    ],

    cumTitlu: "Cum funcționează, pe scurt",
    cum: [
      "Te înscrii online pe acest site; înscrierea intră în platformă și e validată de secretariat.",
      "La închiderea catalogului primești numărul de concurs definitiv și ecusonul de tipărit.",
      "În ziua expoziției urmărești programul live; arbitrii notează rezultatele de pe tabletă/telefon, sub reguli WDF.",
      "După eveniment primești documentele oficiale pe e-mail, iar rezultatele (doar titlurile) se publică pe site.",
    ],

    nucleuTitlu: "Nucleul ecosistemului digital",
    nucleu: [
      { t: "Autentificare unică (SSO)", d: "Acces simplu și securizat pentru toate platformele." },
      { t: "Bază de date comună", d: "Informații centralizate, coerente și mereu actualizate." },
      { t: "Sincronizare în timp real", d: "Date actualizate instant între toate modulele ecosistemului." },
      { t: "Drepturi de acces", d: "Roluri și permisiuni clare pentru fiecare utilizator." },
      { t: "Istoric și audit", d: "Trasabilitate completă a acțiunilor și modificărilor." },
      { t: "API intern și integrări", d: "Extensibil și pregătit pentru integrări viitoare." },
    ],

    incredereTitlu: "Construit pe încredere și pe regulament",
    incredere: "Platforma funcționează local, în ziua expoziției, chiar și fără internet — datele nu se pierd. Copiile de siguranță sunt criptate și păstrate în afara laptopului. Fiecare regulă a World Dog Federation este impusă de sistem, nu lăsată la voia întâmplării. Datele tale personale rămân protejate: nu apar niciodată pe panourile publice, iar rezultatele publicate conțin doar titlurile.",

    ctaTitlu: "Participă la o expoziție CFC-Royal",
    ctaText: "Înscrie-ți câinele online și beneficiază de o experiență expozițională la standarde profesionale.",
    ctaBtn: "Înscriere online",
    ctaBtn2: "Calendar competițional",
    wdf: "Club Federal Chinologic – Royal · Membru World Dog Federation",
  },
  en: {
    kicker: "The digital backbone of our dog shows",
    titlu: "CFC-Royal Exhibition Manager",
    intro: "Every show of Club Federal Chinologic – Royal is run by a dedicated platform, built entirely on World Dog Federation regulations. Its single purpose: professionalism and quality service for our members, from the first entry to the official certificate.",
    imgAlt: "The CFC-Royal digital ecosystem — the Judging School, the Exhibition Manager and the Association Website, linked by a common core.",
    imgCaption: "The CFC-Royal digital ecosystem: three platforms, one goal — excellence in cynology.",

    deQuoTitlu: "Why it matters to you, as a member",
    deQuo: "It is not merely an internal tool. It is the guarantee that the show you enter runs correctly, transparently, and with documents you can verify at any time.",

    benefTitlu: "What it gives you",
    benef: [
      { t: "Simple online entry", d: "Enter your dog from your phone in minutes, with instant email confirmation. The competition class is checked automatically by age, and the fee and payment details are shown clearly." },
      { t: "Transparency on show day", d: "A public board, updated in real time, shows which breed is being judged now and your estimated ring time — recalculated from the actual judging pace." },
      { t: "Rigorous, WDF-compliant judging", d: "Qualifications, placements and titles (CAJC, CAC, CACIB, BOB, Best in Show) follow the WDF Official Regulations exactly, with rules enforced at every step." },
      { t: "Official documents, right away", d: "After the show you receive, in a single email, the diploma, the judging sheet and the certificates won — each with a series, number and verification QR code." },
      { t: "Verifiable certificates", d: "Every document carries a QR code: anyone who scans it confirms its authenticity on the spot, on cfc-royal.ro. A CFC-Royal title cannot be forged." },
      { t: "Track record and championships", d: "Your dog's titles accumulate from one edition to the next. The system automatically tracks championship conditions, under WDF Art. 39." },
    ],

    cumTitlu: "How it works, in short",
    cum: [
      "You enter online on this site; the entry reaches the platform and is validated by the secretariat.",
      "When the catalogue closes you receive the final competition number and printable armband.",
      "On show day you follow the live schedule; judges record results on a tablet/phone, under WDF rules.",
      "After the event you receive the official documents by email, and results (titles only) are published on the site.",
    ],

    nucleuTitlu: "The core of the digital ecosystem",
    nucleu: [
      { t: "Single sign-on (SSO)", d: "Simple, secure access across all platforms." },
      { t: "Shared database", d: "Centralised, consistent and always up-to-date information." },
      { t: "Real-time sync", d: "Data updated instantly across all modules." },
      { t: "Access rights", d: "Clear roles and permissions for every user." },
      { t: "History and audit", d: "Full traceability of actions and changes." },
      { t: "Internal API & integrations", d: "Extensible and ready for future integrations." },
    ],

    incredereTitlu: "Built on trust and on the regulations",
    incredere: "The platform runs locally on show day, even without internet — no data is lost. Backups are encrypted and kept off the laptop. Every World Dog Federation rule is enforced by the system, not left to chance. Your personal data stays protected: it never appears on public boards, and published results contain only the titles.",

    ctaTitlu: "Take part in a CFC-Royal show",
    ctaText: "Enter your dog online and enjoy a show experience at professional standards.",
    ctaBtn: "Online entry",
    ctaBtn2: "Show calendar",
    wdf: "Club Federal Chinologic – Royal · World Dog Federation member",
  },
}[lang];

const linkInscriere = lang === "en" ? "/en/inscriere-expozitie" : "/ro/inscriere-expozitie";
const linkCalendar = lang === "en" ? "/en/expozitii" : "/ro/expozitii";
const IMG = "/images/ecosistem-digital-cfc-royal.png";
---

<article class="mx">
  <header class="mx__hero">
    <p class="mx__kicker">{T.kicker}</p>
    <h1 class="mx__titlu">{T.titlu}</h1>
    <p class="mx__intro">{T.intro}</p>
  </header>

  <figure class="mx__fig">
    <img src={IMG} alt={T.imgAlt} width="1536" height="1024" loading="eager" />
    <figcaption>{T.imgCaption}</figcaption>
  </figure>

  <section class="mx__band">
    <h2 class="mx__h2">{T.deQuoTitlu}</h2>
    <p class="mx__lead">{T.deQuo}</p>
  </section>

  <section class="mx__sect">
    <h2 class="mx__h2">{T.benefTitlu}</h2>
    <div class="mx__grid">
      {T.benef.map((b) => (
        <div class="mx__card">
          <h3>{b.t}</h3>
          <p>{b.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx__sect">
    <h2 class="mx__h2">{T.cumTitlu}</h2>
    <ol class="mx__steps">
      {T.cum.map((c, i) => (
        <li><span class="mx__num">{i + 1}</span><span>{c}</span></li>
      ))}
    </ol>
  </section>

  <section class="mx__sect mx__sect--dark">
    <h2 class="mx__h2 mx__h2--light">{T.nucleuTitlu}</h2>
    <div class="mx__grid mx__grid--nucleu">
      {T.nucleu.map((n) => (
        <div class="mx__chip">
          <h3>{n.t}</h3>
          <p>{n.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx__band">
    <h2 class="mx__h2">{T.incredereTitlu}</h2>
    <p class="mx__lead">{T.incredere}</p>
  </section>

  <section class="mx__cta">
    <h2>{T.ctaTitlu}</h2>
    <p>{T.ctaText}</p>
    <div class="mx__cta-btns">
      <a class="btn btn--primary" href={linkInscriere}>{T.ctaBtn}</a>
      <a class="btn btn--ghost" href={linkCalendar}>{T.ctaBtn2}</a>
    </div>
    <p class="mx__wdf">{T.wdf}</p>
  </section>
</article>

<style>
  .mx { max-width: 60rem; margin-inline: auto; }
  .mx__hero { text-align: center; max-width: 46rem; margin-inline: auto; }
  .mx__kicker { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; font-weight: 700; color: var(--color-accent-dark); margin: 0 0 0.5rem; }
  .mx__titlu { font-family: var(--font-serif); color: var(--color-primary); font-size: clamp(1.9rem, 4vw, 2.75rem); line-height: 1.1; margin: 0 0 0.75rem; text-wrap: balance; }
  .mx__intro { color: var(--color-text-muted); font-size: 1.08rem; line-height: 1.65; }

  .mx__fig { margin: 2.25rem 0 0; }
  .mx__fig img { width: 100%; height: auto; display: block; border-radius: var(--radius); border: 1px solid var(--color-border); box-shadow: 0 6px 24px rgba(22, 58, 44, 0.12); }
  .mx__fig figcaption { text-align: center; color: var(--color-text-muted); font-size: 0.9rem; font-style: italic; margin-top: 0.7rem; }

  .mx__h2 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.5rem; margin: 0 0 0.6rem; }
  .mx__h2--light { color: #fbfaf7; }
  .mx__lead { color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.65; margin: 0; }

  .mx__band { margin-top: 2.5rem; background: var(--color-surface-alt); border-left: 4px solid var(--color-accent); border-radius: var(--radius); padding: 1.4rem 1.6rem; }
  .mx__sect { margin-top: 2.75rem; }

  .mx__grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr)); margin-top: 1.1rem; }
  .mx__card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.1rem 1.2rem; }
  .mx__card h3 { font-size: 1.02rem; color: var(--color-primary); margin: 0 0 0.35rem; }
  .mx__card p { margin: 0; color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.55; }

  .mx__steps { list-style: none; margin: 1.1rem 0 0; padding: 0; display: grid; gap: 0.85rem; }
  .mx__steps li { display: flex; gap: 0.85rem; align-items: flex-start; color: var(--color-text); line-height: 1.55; }
  .mx__num { flex: 0 0 auto; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--color-primary); color: #fbfaf7; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 0.95rem; }

  .mx__sect--dark { background: var(--color-primary-dark); border-radius: var(--radius); padding: 1.75rem 1.6rem; }
  .mx__grid--nucleu .mx__chip { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(176, 141, 46, 0.4); border-radius: var(--radius); padding: 0.95rem 1.1rem; }
  .mx__chip h3 { font-size: 0.98rem; color: var(--color-accent); margin: 0 0 0.3rem; }
  .mx__chip p { margin: 0; color: #e8e5db; font-size: 0.9rem; line-height: 1.5; }

  .mx__cta { margin-top: 2.75rem; text-align: center; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 2rem 1.5rem; }
  .mx__cta h2 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.5rem; margin: 0 0 0.5rem; }
  .mx__cta > p { color: var(--color-text-muted); margin: 0 auto 1.25rem; max-width: 34rem; }
  .mx__cta-btns { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .btn--ghost { background: transparent; color: var(--color-primary); border: 1px solid var(--color-primary); padding: 0.6rem 1.2rem; border-radius: var(--radius); font-weight: 600; text-decoration: none; }
  .mx__wdf { margin: 1.5rem 0 0; font-size: 0.82rem; letter-spacing: 0.03em; color: var(--color-text-muted); }

  @media (max-width: 480px) { .mx__band, .mx__sect--dark { padding-inline: 1.1rem; } }
</style>
