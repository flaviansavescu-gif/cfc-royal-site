---
// CarteaOrigini.astro — fișa publică a unui exemplar din cartea de origini.
// Randată la două adrese: /caine/ (română) și /en/caine/ (engleză). Limba se fixează
// la generare, nu se mai ghicește din browser: antetul, meniul, titlul din tab și
// corpul paginii trebuie să spună toate același lucru.
//
// Echivalentul paginii de câine din baza World Dog Federation, cu aceleași alegeri de
// fond, luate deliberat:
//
//   • CĂUTAREA merge după serie, număr WDF sau MICROCIP — nu după nume. Numele se repetă
//     între canise și se scriu în zece feluri; microcipul e unic și nu se poate greși.
//   • CRESCĂTORUL apare cu numele și afixul; PROPRIETARUL doar printr-un cod (P-000115).
//     Creșterea e o activitate publică, asumată — deținerea unui câine de companie nu.
//   • ARBORELE arată patru generații, cu linia tatălui în verde și a mamei în auriu.
//     Pozițiile fără număr de înregistrare se văd punctate: de acolo vine Tipul B.
import { RASE_WDF } from "../data/nomenclator-wdf";
import type { Lang } from "../i18n/ui";

interface Props { lang: Lang; }
const { lang } = Astro.props;

/** Textul potrivit limbii paginii. */
const T = (ro: string, en: string) => (lang === "en" ? en : ro);

// Adresa proprie a paginii: legăturile către alte exemplare și `history.replaceState`
// trebuie să rămână în aceeași limbă. Fără asta, un click pe bunic te muta în română.
const baza = lang === "en" ? "/en/caine/" : "/caine/";

// Numele raselor în engleză, pentru vizitatorii din alte țări. Se trimit în pagină ca
// JSON, nu ca script: sunt date, nu cod, iar așa rămân în afara verificării de sintaxă.
const raseEn: Record<string, string> = {};
for (const r of RASE_WDF) raseEn[r.ro] = r.en;
---

<script type="application/json" id="k-rase" set:html={JSON.stringify(raseEn)}></script>

<section class="k-sect" data-limba={lang} data-baza={baza}>
  {/* Fără comutator propriu de limbă: pagina ascultă de cel din antet, comun întregului
      site. Două comutatoare pe același ecran se contraziceau — sus scria RO, în
      pagină era apăsat English, și amândouă păreau adevărate. */}
  <p class="k-eyebrow">{T("Registrul genealogic", "Stud book")}</p>
  <h1 class="k-title">{T("Cartea de origini", "Stud book")}</h1>
  {lang === "en" ? (
    <p class="k-sub">
      Search by <strong>certificate serial number</strong>, <strong>WDF number</strong> or <strong>microchip</strong>. Names are not searchable: they repeat across kennels, while a
      microchip is unique.
    </p>
  ) : (
    <p class="k-sub">
      Caută după <strong>seria certificatului</strong>, <strong>numărul WDF</strong>
      sau <strong>microcip</strong>. Numele nu se caută: se repetă între canise, iar microcipul e unic.
    </p>
  )}

  <form class="k-cauta" id="k-form">
    <input id="k-input" type="text" placeholder="CFCR-P-2026-0001 · WDF.RO… · 941000024600001"
           autocomplete="off" spellcheck="false" required
           aria-label={T("Serie, număr WDF sau microcip", "Serial, WDF number or microchip")} />
    <button class="btn btn--primary" type="submit">{T("Caută", "Search")}</button>
  </form>

  <p class="k-rasfoieste">
    <a href="/registru-public/">{T("… sau răsfoiește tot registrul (toți câinii și afixele)", "… or browse the whole register (all dogs and affixes)")} →</a>
  </p>

  <p class="k-eroare" id="k-eroare" role="alert" hidden></p>

  <article id="k-fisa" hidden>
    <!-- ——— Identitatea ——— -->
    <div class="fisa">
      <div class="fisa__stanga">
        <p class="fisa__reg"><span>{T("Nr. înregistrare", "Reg. number")}</span><strong id="k-reg"></strong></p>
        <div class="fisa__poza" aria-hidden="true">🐾</div>
        <table class="fisa__mic">
          <tr><th>{T("Crescător", "Breeder")}</th><td id="k-crescator"></td></tr>
          <tr><th>{T("Proprietar", "Owner")}</th><td id="k-proprietar"></td></tr>
        </table>
      </div>
      <div class="fisa__dreapta">
        <h2 class="fisa__nume" id="k-nume"></h2>
        <p class="fisa__stare" id="k-stare"></p>
        <div class="fisa__sanatate" id="k-sanatate" hidden>
          <p class="fisa__recomandare" id="k-recomandare" hidden></p>
          <h3 class="fisa__sanatate-t" id="k-sanatate-t"></h3>
          <div class="k-insigne" id="k-insigne"></div>
        </div>
        <table class="fisa__date" id="k-date"></table>
      </div>
    </div>

    <!-- ——— Taburile ——— -->
    <nav class="tab" role="tablist">
      <button class="tab__b is-activ" type="button" data-t="pedigree" role="tab">Pedigree</button>
      <button class="tab__b" type="button" data-t="frati" role="tab">{T("Frați de cuib", "Littermates")}</button>
      <button class="tab__b" type="button" data-t="descendenti" role="tab">{T("Descendenți", "Progeny")}</button>
      <button class="tab__b" type="button" data-t="titluri" role="tab">{T("Expoziții și titluri", "Shows and titles")}</button>
    </nav>

    <div class="panou" id="panou-pedigree">
      <div class="arbore-cadru"><div class="arbore" id="k-arbore"></div></div>
      <p class="panou__nota" id="k-tip-nota"></p>
    </div>
    <div class="panou" id="panou-frati" hidden></div>
    <div class="panou" id="panou-descendenti" hidden></div>
    <div class="panou" id="panou-titluri" hidden></div>
  </article>
</section>

<script is:inline>
  (function () {
    const F = "/.netlify/functions/registru-pedigree";
    const F_SAN = "/.netlify/functions/registru-sanatate";
    const sectiune = document.querySelector(".k-sect");
    const form = document.getElementById("k-form");
    const input = document.getElementById("k-input");
    const eroare = document.getElementById("k-eroare");
    const fisa = document.getElementById("k-fisa");

    // Datele vin din dosarele crescătorilor: doar textContent, niciodată innerHTML.
    const el = (tag, cls, text) => {
      const x = document.createElement(tag);
      if (cls) x.className = cls;
      if (text != null) x.textContent = text;
      return x;
    };

    // —— Limba ——
    // Vine din pagină, fixată la generare. Nu se ghicește din browser și nu se schimbă
    // aici: pentru engleză există o adresă proprie, /en/caine/, cu tot antetul tradus.
    const limba = sectiune.dataset.limba === "en" ? "en" : "ro";
    const BAZA = sectiune.dataset.baza || "/caine/";

    // Textele construite din date (cele fixe sunt randate deja în limba paginii).
    const L = {
      ro: {
        generatii: { 1: "Părinți", 2: "Bunici", 3: "Străbunici", 4: "Stră-străbunici" },
        tipA: "Certificat de Tip A — ascendență completă",
        tipB: "Certificat de Tip B — ascendență incompletă",
        anulat: "⚠ Certificat anulat",
        necunoscut: "necunoscut", faraNr: "fără nr. de înregistrare",
        rasa: "Rasa", varietate: "Varietatea", sex: "Sexul", mascul: "mascul", femela: "femelă",
        nastere: "Data nașterii", culoare: "Culoarea", par: "Tipul de păr", microcip: "Microcip",
        nrWdf: "Nr. WDF", serie: "Seria certificatului", cuib: "Cuibul",
        declaratie: "Declarația de origine", emis: "Emis la",
        faraFrati: "Nu sunt înregistrați alți pui din acest cuib.",
        faraDescendenti: "Niciun cuib înregistrat de la acest exemplar.",
        faraTitluri: "Niciun titlu înregistrat. Titlurile se preiau din Managerul de Expoziții, după fiecare ediție.",
        capTitluri: ["Titlul", "Expoziția", "Data", "Clasa", "Arbitru"],
        cuib2: (s, rol, alt) => "Cuib " + s + " · ca " + rol + (alt ? ", cu " + alt : ""),
        tata: "tată", mama: "mamă", fatare: "fătare",
        notaB: (n) => (n === 1
          ? "O poziție din 30 nu are detalii complete de înregistrare"
          : n + " din 30 de poziții nu au detalii complete de înregistrare") +
          " — de aceea certificatul e de Tip B.",
        notaA: "Toate cele 30 de poziții au detalii de înregistrare — certificat de Tip A.",
        seCauta: "Se caută…", butonul: "Caută", esec: "Căutarea a eșuat.",
      },
      en: {
        generatii: { 1: "Parents", 2: "Grandparents", 3: "Great-grandparents", 4: "Great-great-grandparents" },
        tipA: "Type A certificate — complete pedigree",
        tipB: "Type B certificate — incomplete pedigree",
        anulat: "⚠ Certificate cancelled",
        necunoscut: "unknown", faraNr: "no registration number",
        rasa: "Breed", varietate: "Variety", sex: "Sex", mascul: "male", femela: "female",
        nastere: "Date of birth", culoare: "Colour", par: "Coat", microcip: "Microchip",
        nrWdf: "WDF number", serie: "Certificate serial", cuib: "Litter",
        declaratie: "Mating declaration", emis: "Issued on",
        faraFrati: "No other puppies from this litter are registered.",
        faraDescendenti: "No litters registered from this dog.",
        faraTitluri: "No titles recorded. Titles are imported from the Show Manager after each event.",
        capTitluri: ["Title", "Show", "Date", "Class", "Judge"],
        cuib2: (s, rol, alt) => "Litter " + s + " · as " + rol + (alt ? ", with " + alt : ""),
        tata: "sire", mama: "dam", fatare: "whelped",
        notaB: (n) => (n === 1
          ? "One of the 30 pedigree positions lacks complete registration details"
          : n + " of the 30 pedigree positions lack complete registration details") +
          " — hence a Type B certificate.",
        notaA: "All 30 pedigree positions carry registration details — Type A certificate.",
        seCauta: "Searching…", butonul: "Search", esec: "The search failed.",
      },
    };

    let RASE_EN = {};
    try { RASE_EN = JSON.parse(document.getElementById("k-rase").textContent || "{}"); } catch (e) {}
    const numeRasa = (ro) => (limba === "en" && RASE_EN[ro]) ? RASE_EN[ro] : ro;

    const dataRo = (s) => {
      const x = new Date(s);
      return isNaN(x) ? String(s || "") : x.toLocaleDateString(limba === "ro" ? "ro-RO" : "en-GB");
    };
    const legatura = (ref, text, cls) => {
      const a = document.createElement("a");
      a.className = cls || "";
      a.href = BAZA + "?r=" + encodeURIComponent(ref);
      a.textContent = text;
      return a;
    };

    // Doar numerele din registrul propriu se pot deschide. Ascendența unui câine cuprinde
    // aproape întotdeauna exemplare din alte registre — COR A 3670-15/343, ROI 13/71519 —
    // pe care nu le avem. Legate oricum, ar duce toate în gol.
    const ePropriu = (ref) => /^(CFCR-P-|WDF\.)/i.test(String(ref || "").trim());

    function arataEroare(m) {
      eroare.hidden = false; eroare.textContent = m;
      fisa.hidden = true;
    }

    /**
     * Arborele de ascendență, așezat pe perechi, cu linii de legătură.
     *
     * Înainte, cele 2/4/8/16 cutii stăteau pur și simplu înșirate pe coloane. Arăta
     * ordonat, dar ascundea tocmai ce trebuie citit dintr-un pedigree: CARE bunic ține
     * de CARE părinte. Fără linii, cititorul trebuie să numere pozițiile ca să afle
     * dacă un strămoș vine pe linia tatălui sau a mamei — adică să facă în cap munca
     * pe care o face orice pedigree tipărit cu o acoladă.
     *
     * Acum fiecare generație împarte aceleași 16 rânduri: un părinte acoperă 8, un
     * bunic 4, un străbunic 2, un stră-străbunic 1. Așa, fiecare cutie cade exact la
     * mijlocul perechii pe care o generează, iar acoladele desenate în CSS leagă ce
     * trebuie legat. Ordinea codurilor (T, M, TT, TM, MT, MM…) e deja imbricată: nodul
     * `i` dintr-o generație are copiii pe pozițiile `2i` și `2i+1` din următoarea.
     */
    function deseneazaArbore(asc, pozitii) {
      const zona = document.getElementById("k-arbore");
      zona.textContent = "";
      for (let gen = 1; gen <= 4; gen++) {
        const col = el("div", "arbore__col");
        col.appendChild(el("p", "arbore__cap", L[limba].generatii[gen]));
        const grila = el("div", "arbore__grila");
        const inaltime = Math.pow(2, 4 - gen);   // câte rânduri din 16 revin unui nod
        pozitii.filter((x) => x.generatie === gen).forEach((p, i) => {
          // Prima literă a codului spune linia: T = tatăl (verde), M = mama (auriu).
          const linia = p.cod[0] === "T" ? "t" : "m";
          // Nodurile de la generația a doua încolo intră într-o acoladă: cel de sus al
          // perechii coboară spre părinte, cel de jos urcă.
          const celula = el("div", "arbore__celula is-" + linia +
            (gen > 1 ? (i % 2 === 0 ? " is-sus" : " is-jos") : ""));
          celula.style.gridRow = "span " + inaltime;

          const cutie = el("div", "nod is-" + linia);
          cutie.title = p.eticheta;
          if (a2(asc, p) && asc[p.cod].nume) {
            const a = asc[p.cod];
            if (a.nr && ePropriu(a.nr)) cutie.appendChild(legatura(a.nr, a.nume, "nod__nume"));
            else cutie.appendChild(el("strong", "nod__nume", a.nume));
            if (a.titluri) cutie.appendChild(el("span", "nod__titluri", a.titluri));
            cutie.appendChild(el("span", "nod__nr", a.nr || L[limba].faraNr));
            if (!a.nr) cutie.classList.add("is-incomplet");
          } else {
            cutie.classList.add("is-gol");
            cutie.appendChild(el("span", "nod__nr", L[limba].necunoscut));
          }
          celula.appendChild(cutie);
          grila.appendChild(celula);
        });
        col.appendChild(grila);
        zona.appendChild(col);
      }
    }

    /** Există ceva scris la poziția asta? */
    function a2(asc, p) { return !!(asc && asc[p.cod]); }

    function deseneazaFrati(frati) {
      const p = document.getElementById("panou-frati");
      p.textContent = "";
      if (!frati.length) { p.appendChild(el("p", "panou__gol", L[limba].faraFrati)); return; }
      const ul = el("ul", "lista");
      for (const f of frati) {
        const li = document.createElement("li");
        li.appendChild(legatura(f.serie, f.nume));
        li.appendChild(el("span", "lista__mic", f.serie + " · Tip " + f.tip));
        ul.appendChild(li);
      }
      p.appendChild(ul);
    }

    function deseneazaDescendenti(desc) {
      const p = document.getElementById("panou-descendenti");
      p.textContent = "";
      if (!desc.length) {
        p.appendChild(el("p", "panou__gol", L[limba].faraDescendenti));
        return;
      }
      for (const d of desc) {
        const box = el("div", "cuib");
        const rol = d.rol === "tată" ? L[limba].tata : L[limba].mama;
        box.appendChild(el("h3", "cuib__cap", L[limba].cuib2(d.dmfSerie, rol, d.celalaltParinte)));
        box.appendChild(el("p", "lista__mic",
          numeRasa(d.rasa) + " · " + L[limba].fatare + " " + dataRo(d.dataFatarii)));
        const ul = el("ul", "lista");
        for (const pu of d.pui) {
          const li = document.createElement("li");
          li.appendChild(legatura(pu.serie, pu.nume));
          li.appendChild(el("span", "lista__mic", pu.serie));
          ul.appendChild(li);
        }
        box.appendChild(ul);
        p.appendChild(box);
      }
    }

    function deseneazaTitluri(titluri) {
      const p = document.getElementById("panou-titluri");
      p.textContent = "";
      if (!titluri.length) {
        p.appendChild(el("p", "panou__gol", L[limba].faraTitluri));
        return;
      }
      const t = el("table", "tabel");
      const cap = document.createElement("tr");
      L[limba].capTitluri.forEach((x) => cap.appendChild(el("th", null, x)));
      t.appendChild(cap);
      for (const x of titluri) {
        const tr = document.createElement("tr");
        tr.appendChild(el("td", "tabel__titlu", x.titlu));
        tr.appendChild(el("td", null, x.expozitie));
        tr.appendChild(el("td", null, dataRo(x.data)));
        tr.appendChild(el("td", null, x.clasa));
        tr.appendChild(el("td", null, x.arbitru));
        t.appendChild(tr);
      }
      p.appendChild(t);
    }

    // Insignele de sănătate (Faza 1): doar testele VERIFICATE, aduse de registru-sanatate
    // după microcip. Textul insignei vine dintr-un nomenclator închis pe server, dar îl
    // punem tot cu textContent — regula fișei: niciodată innerHTML din date.
    function deseneazaSanatate(microcip) {
      const box = document.getElementById("k-sanatate");
      const ins = document.getElementById("k-insigne");
      box.hidden = true;
      ins.textContent = "";
      const cip = String(microcip || "").replace(/[\s-]/g, "");
      if (!cip) return;
      fetch(F_SAN, { method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ actiune: "dosar", microcip: cip }) })
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (!d) return;
          const rec = document.getElementById("k-recomandare");
          // Recomandarea de calitate (Faza 2): câine cu teste verificate favorabile.
          const areRec = !!(d.recomandare && d.recomandare.acordata);
          rec.hidden = !areRec;
          if (areRec) {
            rec.textContent = limba === "en"
              ? "★ Recommended for breeding — CFC-Royal quality mark"
              : "★ Recomandat pentru montă — Recomandare de calitate CFC-Royal";
          }
          const insigne = d.insigne || [];
          document.getElementById("k-sanatate-t").textContent = insigne.length
            ? (limba === "en" ? "Health tests (verified)" : "Teste de sănătate (verificate)")
            : "";
          insigne.forEach((txt) => ins.appendChild(el("span", "k-insigna", txt)));
          box.hidden = !(areRec || insigne.length);
        })
        .catch(() => {});
    }

    function deseneaza(d) {
      const T = L[limba];
      const c = d.caine;

      document.getElementById("k-reg").textContent = c.numarWDF || c.serie;
      document.getElementById("k-nume").textContent = c.nume;
      const stare = document.getElementById("k-stare");
      stare.className = "fisa__stare is-" + (c.anulat ? "anulat" : c.tip.toLowerCase());
      stare.textContent = c.anulat ? T.anulat : (c.tip === "A" ? T.tipA : T.tipB);

      document.getElementById("k-crescator").textContent =
        [c.crescator.nume, c.crescator.afix].filter(Boolean).join(" · ");
      document.getElementById("k-proprietar").textContent = c.proprietarCod || "—";

      const t = document.getElementById("k-date");
      t.textContent = "";
      const rand = (a, b) => {
        if (!b) return;
        const tr = document.createElement("tr");
        tr.appendChild(el("th", null, a));
        tr.appendChild(el("td", null, b));
        t.appendChild(tr);
      };
      rand(T.rasa, numeRasa(c.rasa));
      rand(T.varietate, c.varietate);
      rand(T.sex, c.sex === "M" ? T.mascul : T.femela);
      rand(T.nastere, dataRo(c.dataNasterii));
      rand(T.culoare, c.culoare);
      rand(T.par, c.tipPar);
      rand(T.microcip, c.microcip);
      rand(T.nrWdf, c.numarWDF);
      rand(T.serie, c.serie);
      rand(T.cuib, c.numarCuib);
      rand(T.declaratie, c.dmfSerie);
      rand(T.emis, dataRo(c.emis));

      deseneazaArbore(d.ascendenta, d.pozitii);
      const lipsa = d.pozitii.filter((p) => {
        const a = d.ascendenta[p.cod];
        return !a || !a.nume || !a.nr;
      }).length;
      document.getElementById("k-tip-nota").textContent = lipsa ? T.notaB(lipsa) : T.notaA;
      deseneazaFrati(d.frati || []);
      deseneazaDescendenti(d.descendenti || []);
      deseneazaTitluri(d.titluri || []);
      deseneazaSanatate(c.microcip);
      fisa.hidden = false;
    }

    // Comutatorul din antet e generat static, deci nu știe ce câine e deschis acum.
    // Îi lipim parametrii din adresă, ca trecerea în cealaltă limbă să păstreze fișa.
    function sincronizeazaComutatorul() {
      const a = document.querySelector(".langswitch__link");
      if (!a) return;
      a.href = a.getAttribute("href").split("?")[0] + location.search;
    }

    async function cauta(ref) {
      eroare.hidden = true;
      const btn = form.querySelector("button[type=submit]");
      btn.disabled = true; btn.textContent = L[limba].seCauta;
      try {
        const r = await fetch(F, { method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ actiune: "caine", cautat: ref }) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.eroare || L[limba].esec);
        deseneaza(d);
        history.replaceState(null, "", BAZA + "?r=" + encodeURIComponent(ref));
        sincronizeazaComutatorul();
      } catch (err) { arataEroare(err.message); }
      btn.disabled = false; btn.textContent = L[limba].butonul;
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = input.value.trim().toUpperCase();
      if (v) cauta(v);
    });

    document.querySelectorAll(".tab__b").forEach((b) => {
      b.addEventListener("click", () => {
        document.querySelectorAll(".tab__b").forEach((x) => x.classList.remove("is-activ"));
        b.classList.add("is-activ");
        document.querySelectorAll(".panou").forEach((p) => { p.hidden = true; });
        document.getElementById("panou-" + b.dataset.t).hidden = false;
      });
    });

    sincronizeazaComutatorul();

    const dinAdresa = (new URLSearchParams(location.search).get("r") || "").trim().toUpperCase();
    if (dinAdresa) { input.value = dinAdresa; cauta(dinAdresa); }
  })();
</script>

<style>
  .k-sect { max-width: 68rem; margin-inline: auto; padding: 3rem 1.25rem 4rem; }
  .k-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; color: var(--color-accent-dark); margin: 0; }
