---
// Registratura.astro — pagina de prezentare a Registraturii CFC-Royal, al cincilea pilon
// al asociației. Bilingv RO/EN, aceeași croială instituțională ca pagina Managerului și
// cea a Ecosistemului.
//
// Registratura NU e un birou de hârtii. E locul unde un act depus de un om devine un act
// pe care se poate sprijini altcineva: cumpărătorul unui pui, o organizație străină, o
// instanță. De aceea pagina spune concret CE se verifică și CUM se poate dovedi cine a
// verificat — nu vorbe despre „rigoare" și „profesionalism".
interface Props { lang: "ro" | "en"; }
const { lang } = Astro.props;

const T = {
  ro: {
    kicker: "Al cincilea pilon",
    titlu: "Registratura CFC-Royal",
    tagline: "Verificăm astăzi pentru încrederea de mâine.",
    imgAlt: "Registratura CFC-Royal — dosare de montă și fătare, certificate pedigree, ștampila asociației și ecranul de verificare a înscrierilor.",
    imgCaption: "Registratura — pilonul care le ține pe toate la un loc.",

    introTitlu: "Ce înseamnă, de fapt",
    intro: [
      "Un certificat de origine nu valorează cât hârtia pe care e tipărit, ci cât verificarea din spatele lui. Cine a citit declarația de montă? Cine s-a uitat dacă pedigree-ul mamei chiar există? Cine a confirmat că proprietarul masculului a fost de acord? Dacă la întrebările astea nu există răspuns, actul e o părere frumos tipărită.",
      "Registratura e locul unde există răspuns. Doi registratori — președintele asociației și un al doilea desemnat — trec fiecare dosar act cu act, înainte ca el să producă efecte. Nu la sfârșit, ca o formalitate; înainte, cât încă se poate îndrepta ceva.",
    ],

    ceFaceTitlu: "Ce face Registratura",
    ceFace: [
      {
        icon: "📁", t: "Verifică dosarele de montă și fătare",
        d: "Act cu act: declarația depusă în termen, confirmarea proprietarului masculului, pedigree-ul ambilor părinți, dreptul de montă al femelei. Un dosar incomplet se întoarce, nu se aprobă „cu mențiune”.",
      },
      {
        icon: "🌳", t: "Transcrie ascendența pe patru generații",
        d: "Părinți, bunici, străbunici și stră-străbunici. Din ce se găsește și din ce lipsește rezultă tipul certificatului: Tip A, cu ascendența completă, sau Tip B, când o linie se întrerupe. Nu se completează din memorie și nu se presupune.",
      },
      {
        icon: "🔖", t: "Atribuie numărul de cuib WDF",
        d: "Și pregătește Certificatele Pedigree pentru emitere. Numerele merg în ordine, dintr-un contor care nu poate da același număr de două ori.",
      },
      {
        icon: "🏆", t: "Verifică înscrierile la expoziții",
        d: "Fiecare înscriere trimisă prin site trece pe la Registratură înainte de a intra în catalog: numărul de pedigree, microcipul, vârsta la data expoziției, clasa aleasă, calitatea de membru — și dovada plății taxei.",
      },
      {
        icon: "🛡️", t: "Lasă urmă la fiecare verificare",
        d: "Cine a verificat, când, și ce a constatat. La întrebarea „cine a verificat dosarul acesta?” există răspuns oricând, nu doar cât timp își aduce cineva aminte.",
      },
    ],

    fluxTitlu: "Cum lucrează, pas cu pas",
    fluxIntro: "Două fluxuri diferite, aceeași disciplină.",
    fluxA: {
      t: "La o înscriere în expoziție",
      pasi: [
        "Omul completează formularul pe site și atașează dovada plății.",
        "Înscrierea intră într-o listă de așteptare — nimeni nu o vede în afară de registratori.",
        "Registratorul deschide dosarul: acte pe de o parte, plată pe de alta. Sunt două bife deosebite, pentru că sunt două verificări deosebite.",
        "Ce nu se potrivește se marchează „de lămurit”, cu motivul scris. Un telefon dat cu o săptămână înainte rezolvă ce, în dimineața expoziției, ar fi devenit o ceartă la intrarea în ring.",
        "Abia apoi înscrierile se importă în Managerul de Expoziții, cu verificările lor cu tot.",
      ],
    },
    fluxB: {
      t: "La un dosar de montă și fătare",
      pasi: [
        "Crescătorul depune declarația în spațiul lui din registrul genealogic.",
        "Proprietarul masculului confirmă monta — separat, din contul lui.",
        "Registratura verifică actele, transcrie ascendența și stabilește tipul certificatului.",
        "Se atribuie numărul de cuib și se emit Certificatele Pedigree.",
        "Fiecare certificat emis poate fi verificat public, prin codul QR de pe el.",
      ],
    },

    reguliTitlu: "Două reguli care nu se negociază",
    reguli: [
      {
        t: "Registratura dă acces, administratorul îl ia",
        d: "Un rol care poate și să acorde, și să retragă drepturi se poate desprinde singur de sub control. De aceea codurile de membru le generează registratorul desemnat, dar ștergerea unui membru, anularea unui certificat și arhiva rămân exclusiv la administrator.",
      },
      {
        t: "Verificarea stă unde stau datele",
        d: "Registratorii sunt cei care văd extrasul de cont, cunosc membrii și au dosarele în față. N-are rost ca actele să fie verificate de altcineva, „la sfârșit”. Se verifică acolo unde există cu ce.",
      },
    ],

    membriTitlu: "Registratura este a membrilor",
    membriText: "Nu adaugă piedici — le înlătură înainte să devină probleme. O neconcordanță lămurită printr-un telefon, cu o săptămână înainte, nu mai ajunge o problemă în dimineața expoziției, la intrarea în ring. Iar un certificat verificat înainte de emitere e un certificat pe care cumpărătorul unui pui se poate sprijini peste zece ani.",

    ctaTitlu: "Legături utile",
    cta: [
      { t: "Verificarea unui certificat", d: "Oricine poate verifica dacă un certificat CFC-Royal e valabil.", href: "/verifica-pedigree/" },
      { t: "Registrul genealogic", d: "Spațiul crescătorilor: declarații de montă și fătare, pedigree-uri.", href: "/registru/" },
      { t: "Înscriere la expoziție", d: "Formularul online — de aici încep verificările Registraturii.", href: "inscriere-expozitie" },
      { t: "Ecosistemul digital", d: "Cei cinci piloni și cum lucrează împreună.", href: "ecosistem-digital" },
    ],
    wdf: "Asociația Club Federal Chinologic – Royal · Membră World Dog Federation",
  },

  en: {
    kicker: "The fifth pillar",
    titlu: "The CFC-Royal Registry Office",
    tagline: "We check today for tomorrow's trust.",
    imgAlt: "The CFC-Royal Registry Office — mating and whelping files, pedigree certificates, the association's seal and the entry-verification screen.",
    imgCaption: "The Registry Office — the pillar that holds the others together.",

    introTitlu: "What it actually means",
    intro: [
      "A certificate of origin is worth not the paper it is printed on, but the checking behind it. Who read the mating declaration? Who looked to see whether the dam's pedigree actually exists? Who confirmed that the sire's owner agreed? If those questions have no answer, the document is a nicely printed opinion.",
      "The Registry Office is where the answer exists. Two registrars — the association's president and a second appointed person — go through every file document by document, before it takes effect. Not at the end, as a formality; before, while something can still be put right.",
    ],

    ceFaceTitlu: "What the Registry Office does",
    ceFace: [
      {
        icon: "📁", t: "Checks mating and whelping files",
        d: "Document by document: the declaration filed within the deadline, the sire owner's confirmation, the pedigrees of both parents, the dam's mating entitlement. An incomplete file goes back; it is not approved \"with a note\".",
      },
      {
        icon: "🌳", t: "Transcribes four generations of ancestry",
        d: "Parents, grandparents, great-grandparents and great-great-grandparents. What is found — and what is missing — determines the type of certificate: Type A, with complete ancestry, or Type B, where a line breaks. Nothing is filled in from memory and nothing is assumed.",
      },
      {
        icon: "🔖", t: "Assigns the WDF litter number",
        d: "And prepares the Pedigree Certificates for issue. Numbers run in sequence, from a counter that cannot give the same number twice.",
      },
      {
        icon: "🏆", t: "Checks show entries",
        d: "Every entry submitted through the site passes through the Registry Office before it reaches the catalogue: pedigree number, microchip, age on show day, the class chosen, membership — and the proof of payment of the entry fee.",
      },
      {
        icon: "🛡️", t: "Leaves a trace at every check",
        d: "Who checked, when, and what they found. The question \"who checked this file?\" has an answer at any time, not only for as long as someone remembers.",
      },
    ],

    fluxTitlu: "How it works, step by step",
    fluxIntro: "Two different flows, the same discipline.",
    fluxA: {
      t: "For a show entry",
      pasi: [
        "The exhibitor fills in the form on the site and attaches proof of payment.",
        "The entry joins a waiting list — no one sees it except the registrars.",
        "The registrar opens the file: documents on one side, payment on the other. Two separate ticks, because they are two separate checks.",
        "Anything that does not add up is marked \"to clarify\", with the reason written down. A phone call a week ahead settles what, on show morning, would have become an argument at the ring entrance.",
        "Only then are the entries imported into the Exhibition Manager, checks and all.",
      ],
    },
    fluxB: {
      t: "For a mating and whelping file",
      pasi: [
        "The breeder files the declaration in their own space in the stud book.",
        "The sire's owner confirms the mating — separately, from their own account.",
        "The Registry Office checks the documents, transcribes the ancestry and determines the certificate type.",
        "The litter number is assigned and the Pedigree Certificates are issued.",
        "Every certificate issued can be verified publicly, through the QR code printed on it.",
      ],
    },

    reguliTitlu: "Two rules that are not negotiable",
    reguli: [
      {
        t: "The Registry Office grants access; the administrator withdraws it",
        d: "A role that can both grant and revoke rights can free itself from oversight. That is why member codes are generated by the appointed registrar, while deleting a member, annulling a certificate and the archive remain exclusively with the administrator.",
      },
      {
        t: "Checking belongs where the data is",
        d: "The registrars are the ones who see the bank statement, know the members and have the files in front of them. There is no sense in documents being checked by someone else, \"at the end\". They are checked where the means to check them exist.",
      },
    ],

    membriTitlu: "The Registry Office belongs to the members",
    membriText: "It does not add obstacles — it removes them before they become problems. A discrepancy settled by a phone call a week ahead never becomes a problem on show morning, at the ring entrance. And a certificate checked before issue is a certificate a puppy buyer can rely on ten years later.",

    ctaTitlu: "Useful links",
    cta: [
      { t: "Verify a certificate", d: "Anyone can check whether a CFC-Royal certificate is valid.", href: "/verifica-pedigree/" },
      { t: "The stud book", d: "The breeders' space: mating and whelping declarations, pedigrees.", href: "/registru/" },
      { t: "Show entry", d: "The online form — where the Registry Office's checks begin.", href: "inscriere-expozitie" },
      { t: "The digital ecosystem", d: "The five pillars and how they work together.", href: "ecosistem-digital" },
    ],
    wdf: "Asociația Club Federal Chinologic – Royal · World Dog Federation member",
  },
}[lang];

const IMG = "/images/registratura-cfc-royal.webp";
/** Căile care încep cu „/" sunt fără prefix de limbă (registru, verificare publică). */
const cale = (href: string) => (href.startsWith("/") ? href : `/${lang}/${href}`);
---

<article class="rg">
  <header class="rg__hero">
    <p class="rg__kicker">{T.kicker}</p>
    <h1 class="rg__titlu">{T.titlu}</h1>
    <p class="rg__tagline">{T.tagline}</p>
  </header>

  <figure class="rg__fig">
    <img src={IMG} alt={T.imgAlt} width="1024" height="1536" loading="eager" />
    <figcaption>{T.imgCaption}</figcaption>
  </figure>

  <section class="rg__sect">
    <h2 class="rg__h2">{T.introTitlu}</h2>
    {T.intro.map((x) => <p class="rg__p">{x}</p>)}
  </section>

  <section class="rg__sect">
    <h2 class="rg__h2">{T.ceFaceTitlu}</h2>
    <div class="rg__carduri">
      {T.ceFace.map((c) => (
        <div class="rg__card">
          <span class="rg__card-ic" aria-hidden="true">{c.icon}</span>
          <h3>{c.t}</h3>
          <p>{c.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="rg__sect">
    <h2 class="rg__h2">{T.fluxTitlu}</h2>
    <p class="rg__lead">{T.fluxIntro}</p>
    <div class="rg__fluxuri">
      {[T.fluxA, T.fluxB].map((f) => (
        <div class="rg__flux">
          <h3>{f.t}</h3>
          <ol>{f.pasi.map((x) => <li>{x}</li>)}</ol>
        </div>
      ))}
    </div>
  </section>

  <section class="rg__sect rg__sect--dark">
    <h2 class="rg__h2 rg__h2--light">{T.reguliTitlu}</h2>
    <div class="rg__reguli">
      {T.reguli.map((r) => (
        <div class="rg__regula">
          <h3>{r.t}</h3>
          <p>{r.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="rg__membri">
    <h2>{T.membriTitlu}</h2>
    <p>{T.membriText}</p>
  </section>

  <section class="rg__sect">
    <h2 class="rg__h2">{T.ctaTitlu}</h2>
    <div class="rg__link-uri">
      {T.cta.map((c) => (
        <a class="rg__link" href={cale(c.href)}>
          <strong>{c.t}</strong>
          <span>{c.d}</span>
        </a>
      ))}
    </div>
    <p class="rg__wdf">{T.wdf}</p>
  </section>
</article>

<style>
  .rg { max-width: 62rem; margin-inline: auto; }

  .rg__hero { text-align: center; max-width: 48rem; margin-inline: auto; }
  .rg__kicker { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; font-weight: 700; color: var(--color-accent-dark); margin: 0 0 0.5rem; }
  .rg__titlu { font-family: var(--font-serif); color: var(--color-primary); font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.08; margin: 0 0 0.6rem; text-wrap: balance; }
  .rg__tagline { color: var(--color-text-muted); font-size: 1.1rem; line-height: 1.6; }

  /* Infografia e înaltă (portret): îngrădită, ca să nu împingă textul la o pagină distanță. */
  .rg__fig { margin: 2.25rem auto 0; max-width: 34rem; }
  .rg__fig img { width: 100%; height: auto; display: block; border-radius: var(--radius); border: 1px solid var(--color-border); box-shadow: 0 8px 30px rgba(22, 58, 44, 0.14); }
  .rg__fig figcaption { text-align: center; color: var(--color-text-muted); font-size: 0.9rem; font-style: italic; margin-top: 0.7rem; }

  .rg__sect { margin-top: 3rem; }
  .rg__h2 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.6rem; margin: 0 0 0.8rem; text-align: center; }
  .rg__h2--light { color: #fbfaf7; }
  .rg__lead { color: var(--color-text-muted); font-size: 1.02rem; line-height: 1.6; text-align: center; max-width: 46rem; margin: 0 auto 1.5rem; }
  .rg__p { max-width: 52rem; margin: 0 auto 1rem; color: var(--color-text); font-size: 1.05rem; line-height: 1.7; }

  .rg__carduri { display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); margin-top: 1.5rem; }
  .rg__card { background: var(--color-surface); border: 1px solid var(--color-border); border-top: 4px solid var(--color-primary); border-radius: var(--radius); padding: 1.3rem 1.25rem; }
  .rg__card-ic { font-size: 1.8rem; line-height: 1; display: block; margin-bottom: 0.4rem; }
  .rg__card h3 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.15rem; margin: 0 0 0.45rem; }
  .rg__card p { margin: 0; color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6; }

  .rg__fluxuri { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); }
  .rg__flux { background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.4rem 1.35rem; }
  .rg__flux h3 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.15rem; margin: 0 0 0.8rem; }
  .rg__flux ol { margin: 0; padding-left: 1.15rem; display: grid; gap: 0.6rem; }
  .rg__flux li { color: var(--color-text); font-size: 0.95rem; line-height: 1.6; }

  .rg__sect--dark { background: var(--color-primary-dark); border-radius: var(--radius); padding: 2rem 1.6rem; }
  .rg__reguli { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); margin-top: 1.3rem; }
  .rg__regula { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(176, 141, 46, 0.4); border-radius: var(--radius); padding: 1.05rem 1.2rem; }
  .rg__regula h3 { font-size: 1rem; color: var(--color-accent); margin: 0 0 0.4rem; }
  .rg__regula p { margin: 0; color: #e8e5db; font-size: 0.92rem; line-height: 1.6; }

  .rg__membri { margin-top: 3rem; text-align: center; background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 2.25rem 1.6rem; }
  .rg__membri h2 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.55rem; margin: 0 0 0.6rem; }
  .rg__membri p { color: var(--color-text-muted); max-width: 46rem; margin: 0 auto; line-height: 1.7; }

  .rg__link-uri { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); margin-top: 1.3rem; }
  .rg__link { display: block; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem 1.15rem; text-decoration: none; }
  .rg__link:hover { border-color: var(--color-primary); }
  .rg__link strong { display: block; color: var(--color-primary); font-family: var(--font-serif); font-size: 1.05rem; margin-bottom: 0.2rem; }
  .rg__link span { color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.5; }

  .rg__wdf { margin: 2rem 0 0; text-align: center; font-size: 0.82rem; letter-spacing: 0.03em; color: var(--color-text-muted); }

  @media (max-width: 480px) { .rg__sect--dark, .rg__membri { padding-inline: 1.1rem; } }
</style>
