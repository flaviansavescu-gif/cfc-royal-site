---
// InscriereExpo.astro — formular public de înscriere la expoziții (bilingv RO/EN).
// Încarcă expozițiile deschise din funcția inscriere-expo și trimite înscrierea în coadă.
interface Props { lang: "ro" | "en"; }
const { lang } = Astro.props;

// Normele NU se scriu aici: se citesc din sursa unică pe care o folosește și funcția de
// înscriere când reține versiunea acceptată. Vezi netlify/functions/_comun/norme-participare.mjs.
import { NORME_RO, NORME_EN } from "../../netlify/functions/_comun/norme-participare.mjs";

// Bannerul expoziției alese. Cheia se caută în numele expoziției venit din manager, ca
// bannerul să se schimbe singur când se deschide altă expoziție — altfel ar rămâne aici
// Iașiul și după ce Iașiul a trecut. O expoziție fără banner în listă nu arată nimic;
// mai bine nimic decât un afiș vertical întins pe toată lățimea.
const AFISE = [
  { cheie: "iasi", src: "/images/bannere/iasi-2026.webp", alt: "CACIB Iași — WDF Moldova Dog Show, Arena U.S.V. Iași, 5 septembrie 2026. Eveniment organizat în parteneriat cu Universitatea pentru Științele Vieții." },
];

const T = {
