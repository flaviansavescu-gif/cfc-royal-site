---
// InscriereExpo.astro — formular public de înscriere la expoziții (bilingv RO/EN).
// Încarcă expozițiile deschise din funcția inscriere-expo și trimite înscrierea în coadă.
interface Props { lang: "ro" | "en"; }
const { lang } = Astro.props;

// Normele NU se scriu aici: se citesc din sursa unică pe care o folosește și funcția de
// înscriere când reține versiunea acceptată. Vezi netlify/functions/_comun/norme-participare.mjs.
import { NORME_RO, NORME_EN } from "../../netlify/functions/_comun/norme-participare.mjs";

// Afișul expoziției alese. Cheia se caută în numele expoziției venit din manager, ca
// afișul să se schimbe singur când se deschide altă expoziție — altfel ar rămâne aici
// afișul de la Iași și după ce Iașiul a trecut.
const AFISE = [
  { cheie: "iasi", src: "/images/afise/iasi-2026.webp", alt: "Afiș CACIB Iași — WDF Moldova Dog Show, Arena U.S.V., 5 septembrie 2026" },
  { cheie: "buzau", src: "/images/afise/buzau-2026.webp", alt: "Afiș CACIB Buzău — WDF BOUZEOS Dog Show, Parcul Tineretului, 27 iunie 2026" },
];

const T = {
  ro: {
    titlu: "Înscriere la expoziție", intro: "Completează formularul pentru a înscrie un câine la o expoziție a Clubului Federal Chinologic – Royal.",
