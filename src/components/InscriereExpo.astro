}[lang];

// Clasele WDF (aceleași ca în manager). Etichete + interval de vârstă (luni).
const CLASE = [
  { v: "baby", ro: "Baby (3–6 luni)", en: "Baby (3–6 months)" },
  { v: "puppy", ro: "Puppy (6–9 luni)", en: "Puppy (6–9 months)" },
  { v: "very_young", ro: "Very Young (9–12 luni)", en: "Very Young (9–12 months)" },
  { v: "young", ro: "Young / Junior (12–18 luni)", en: "Young / Junior (12–18 months)" },
  { v: "intermediara", ro: "Intermediară (15–24 luni)", en: "Intermediate (15–24 months)" },
  { v: "deschisa", ro: "Deschisă / Open (18+ luni)", en: "Open (18+ months)" },
  { v: "working", ro: "Working / Lucru (18+ luni)", en: "Working (18+ months)" },
  { v: "winner", ro: "Winner (4 CAC)", en: "Winner (4 CAC)" },
  { v: "champion", ro: "Champion", en: "Champion" },
  { v: "foreign_champion", ro: "Foreign Champion", en: "Foreign Champion" },
  { v: "veterani", ro: "Veterani (10+ ani)", en: "Veteran (10+ years)" },
];
---

<section class="ie">
  <h1 class="ie__titlu">{T.titlu}</h1>
  <p class="ie__intro">{T.intro}</p>

  <section class="ie__cum">
    <h2 class="ie__cum-t">{T.cumTitlu}</h2>
    <ol class="ie__cum-l">
      <li><b>{T.cum1t}</b> — {T.cum1}</li>
      <li><b>{T.cum2t}</b> — {T.cum2}</li>
      <li><b>{T.cum3t}</b> — {T.cum3}</li>
      <li><b>{T.cum4t}</b> — {T.cum4}</li>
      <li><b>{T.cum5t}</b> — {T.cum5}</li>
    </ol>
  </section>

  <p class="ie__stare" id="ie-loading">…</p>
  <p class="ie__gol" id="ie-gol" hidden>{T.faraExpo}</p>

  <div class="ie__succes" id="ie-succes" hidden>
    <p><b>✅ {T.succes}</b></p>
    <p id="ie-succes-rezumat"></p>
    <button class="btn btn--primary" id="ie-reset" type="button">{T.inca}</button>
  </div>

  <form class="ie__form" id="ie-form" hidden autocomplete="off">
    <p class="ie__err" id="ie-err" hidden></p>

    <p class="ie__repetitie" id="ie-repetitie" hidden role="status">
      <strong>REPETIȚIE TEHNICĂ.</strong> Expoziția aleasă nu este una adevărată — este o probă
      a sistemului, făcută înaintea unei expoziții reale. Înscrierile de aici se șterg la
      sfârșit. Dacă ai ajuns aici din greșeală, întoarce-te la
      <a href="/ro/inscriere-expozitie/">formularul obișnuit</a>.
    </p>

    {/* Caseta afișului e scrisă de Astro, nu de JavaScript: numai așa primește stilurile
        componentei, care sunt legate de un atribut pus doar pe ce desenează el. */}
    <figure class="ie__afis" id="ie-afis" hidden>
      <img id="ie-afis-img" src="" alt="" width="1408" height="521" decoding="async" />
    </figure>

    <label class="ie__f">
      <span>{T.expozitie} <b class="req">*</b></span>
      <select id="ie-show" name="showId" required></select>
    </label>

    {/* Termenul e chiar cel pus în manager și călătorește cu expoziția. Scris de Astro,
        nu de JavaScript, ca să primească stilurile componentei. */}
    <p class="ie__inchis" id="ie-inchis" hidden>
      <b>{T.inchisEticheta}:</b> <span id="ie-inchis-cand"></span>
      <br /><small>{T.inchisNota} {T.inchisAlegeAlta}</small>
    </p>

    <p class="ie__termen" id="ie-termen" hidden>
      <b>{T.termenEticheta}:</b> <span id="ie-termen-cand"></span>
      <br /><small>{T.termenNota}</small>
    </p>

    {/* Capcană: omul nu vede câmpul, deci nu-l completează. Roboții completează tot ce
        găsesc, iar serverul răspunde cu un succes prefăcut — dacă ar da eroare, robotul
        ar afla că a fost prins și ar încerca altfel. Merge singură prin FormData. */}
    <input class="ie-capcana" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

    {/* Câți câini + câinii înșiși. Fiecare câine e un bloc identic (clonat din șablon);
        datele proprietarului, taxa și dovada se completează o singură dată, mai jos. */}
    <div class="ie__nrcaini">
      <label class="ie__f ie__f--nr">
        <span>{lang === "en" ? "How many dogs do you want to enter?" : "Câți câini vrei să înscrii?"} <b class="req">*</b></span>
        <input id="ie-nr-caini" type="number" min="1" max="12" step="1" value="1" inputmode="numeric" />
      </label>
      <small class="ie__gdpr">{lang === "en"
        ? "Add a section for each dog. The owner details below are filled in once, for all dogs."
        : "Adaugă o secțiune pentru fiecare câine. Datele proprietarului de mai jos se completează o singură dată, pentru toți câinii."}</small>
    </div>

    <div id="ie-caini"></div>
    {/* O singură listă de rase, folosită de toate blocurile (list="ie-rase"). */}
    <datalist id="ie-rase"></datalist>

    <button type="button" class="btn btn--outline ie__addcaine" id="ie-add-caine">＋ {lang === "en" ? "Add another dog" : "Adaugă încă un câine"}</button>

    <template id="ie-caine-tpl">
      <fieldset class="ie__fs ie__caine">
        <legend><span class="ie__caine-nr"></span></legend>
        <button type="button" class="ie__caine-del" hidden title={lang === "en" ? "Remove this dog" : "Elimină acest câine"} aria-label={lang === "en" ? "Remove this dog" : "Elimină acest câine"}>✕</button>
        <label class="ie__f"><span>{T.numeCaine} <b class="req">*</b></span><input data-f="numeCaine" /></label>
        <label class="ie__f"><span>{T.rasa} <b class="req">*</b></span>
          <input data-f="rasaText" list="ie-rase" placeholder={T.rasaPh} />
          <input type="hidden" data-f="rasaId" />
        </label>
        <div class="ie__row">
          <label class="ie__f"><span>{T.sex} <b class="req">*</b></span>
            <div class="ie__radios">
              <label><input type="radio" data-f="sex" value="M" /> {T.mascul}</label>
              <label><input type="radio" data-f="sex" value="F" /> {T.femela}</label>
            </div>
          </label>
          <label class="ie__f"><span>{T.dataN} <b class="req">*</b></span><input data-f="dataNasterii" inputmode="numeric" autocomplete="off" placeholder={T.dataPh} maxlength="10" /></label>
        </div>
        <label class="ie__f"><span>{T.clasa} <b class="req">*</b></span>
          <select data-f="clasa">
            <option value="">—</option>
            {CLASE.map((c) => <option value={c.v}>{lang === "en" ? c.en : c.ro}</option>)}
          </select>
        </label>
        <div class="ie__row">
          <label class="ie__f"><span>{T.pedigree} *</span><input data-f="pedigree" /></label>
          <label class="ie__f"><span>{T.microcip} *</span><input data-f="microcip" minlength="6" /></label>
        </div>
        <label class="ie__f"><span>{T.crescator} ({T.optional})</span><input data-f="crescator" /></label>
        <div class="ie__row">
          <label class="ie__f"><span>{T.culoareRoba}</span><input data-f="culoareRoba" /></label>
          <label class="ie__f"><span>{T.tata}</span><input data-f="tata" /></label>
        </div>
        <label class="ie__f"><span>{T.mama}</span><input data-f="mama" /></label>
        <label class="ie__tip"><input type="checkbox" data-f="pedigreeTipicitate" value="1" /> <span><b>{T.tipicitate}</b><br /><small>{T.tipicitateDesc}</small></span></label>
      </fieldset>
    </template>

    <fieldset class="ie__fs">
      <legend>{T.dateProp}</legend>
      <div class="ie__row">
        <label class="ie__f"><span>{T.numeProp} <b class="req">*</b></span><input name="numeProprietar" required /></label>
        <label class="ie__f"><span>{T.email} <b class="req">*</b></span><input name="email" type="email" required /></label>
      </div>
      <div class="ie__row">
        <label class="ie__f"><span>{T.telefon} ({T.optional})</span><input name="telefon" /></label>
        <label class="ie__f"><span>{T.tara} ({T.optional})</span><input name="tara" /></label>
      </div>
      <label class="ie__f"><span>{T.adresa} ({T.optional})</span><input name="adresa" /></label>
    </fieldset>

    <!-- Plata taxei: apare doar când expoziția are taxe configurate. Dovada nu confirmă
         plata — secretariatul o verifică în extras; aici doar o aducem lângă înscriere. -->
    <fieldset class="ie__fs" id="ie-plata" hidden>
      <legend>{T.plataTitlu}</legend>

      {/* Grila nouă: taxa depinde de calitatea de membru și de al câtelea câine e,
          nu de clasa de concurs. Întrebările apar doar la expozițiile publicate cu
          grila nouă (`ie-intrebari`); cele vechi, pe clase, rămân cum erau. */}
      <div class="ie__intrebari" id="ie-intrebari" hidden>
        <p class="ie__intrebari-t">{T.intrebariTitlu}</p>

        <fieldset class="ie__grup">
          <legend>{T.membruIntrebare} <b class="req">*</b></legend>
          <label class="ie__radio"><input type="radio" name="esteMembru" value="1" /> <span>{T.membruDa}</span></label>
          <label class="ie__radio"><input type="radio" name="esteMembru" value="0" checked /> <span>{T.membruNu}</span></label>
        </fieldset>

        <fieldset class="ie__grup">
          <legend>{T.primulIntrebare} <b class="req">*</b></legend>
          <label class="ie__radio"><input type="radio" name="primulCaine" value="1" checked /> <span>{T.primulDa}</span></label>
          <label class="ie__radio"><input type="radio" name="primulCaine" value="0" /> <span>{T.primulNu}</span></label>
        </fieldset>

        <label class="ie__consim"><input type="checkbox" name="esteStudent" value="1" /> <span>{T.studentBifa}</span></label>
        <p class="ie__gdpr" id="ie-student-nota" hidden>{T.studentNota}</p>
        <p class="ie__gdpr">{T.intrebariNota}</p>
      </div>

      <p class="ie__taxa" id="ie-taxa-text">{T.taxaAlege}</p>
      <div class="ie__plata-info">
        <p>{T.plataCum}</p>
        {/* NICIUN CONT SCRIS AICI, nici măcar ca valoare de pornire.
            Contul vine de la manager, odată cu expoziția aleasă: la o expoziție a unei
            Membrii Colectivi, taxele intră în contul LOR. Un cont scris în pagină „ca
            rezervă" ar fi arătat contul clubului pentru o expoziție a altcuiva — adică
            ar fi trimis banii în alt cont decât cel care trebuie. Mai bine niciun cont
            decât unul plauzibil și greșit. */}
        <div id="ie-cont">
          <p class="ie__iban" id="ie-iban"></p>
          <p>{T.titularEticheta} <span id="ie-titular"></span><span id="ie-banca-sep"> · </span><span id="ie-banca"></span></p>
          <p><b>{T.plataDetalii}</b></p>
        </div>
        <p id="ie-cont-lipsa" hidden>{T.contLipsa}</p>
      </div>
      <label class="ie__consim"><input type="checkbox" name="amPlatit" value="1" id="ie-amplatit" /> <span><b>{T.amPlatit}</b> <b class="req">*</b></span></label>
      <label class="ie__f"><span>{T.dovada} <b class="req">*</b></span>
        <input type="file" name="dovada" id="ie-dovada" accept="image/jpeg,image/png,image/webp,application/pdf" />
      </label>
      <p class="ie__gdpr">{T.dovadaNota}</p>
      <p class="ie__gdpr"><a href={lang === "en" ? "/en/tarife/" : "/ro/tarife/"}>{T.vezeTarife} →</a></p>
    </fieldset>

    {/* Normele stau AICI, la vedere, nu după un link. Proiectul de Condiții de participare
        cere bifa (Art. 3), dar nu e încă adoptat și nu e publicat — o bifă care trimite la
        un document pe care nimeni nu-l poate citi nu obligă pe nimeni la nimic. Când
        Consiliul îl adoptă și se publică, aici rămâne rezumatul și se adaugă trimiterea. */}
    <fieldset class="ie__fs">
      <legend>{T.normeTitlu}</legend>
      <p class="ie__gdpr">{T.normeIntro}</p>
      <ul class="ie__norme">
        {T.norme.map((n) => <li>{n}</li>)}
      </ul>
      <p class="ie__gdpr">{T.normeUrmari}</p>
      {/* În filă nouă: altfel omul pierde tot ce a completat ca să citească Codul Etic. */}
      <p class="ie__gdpr">
        <a href={lang === "en" ? "/en/documente/conditii-participare-expozitii/" : "/ro/documente/conditii-participare-expozitii/"} target="_blank" rel="noopener">{T.normeCodEtic} →</a>
        <span> · </span>
        <a href={lang === "en" ? "/en/documente/cod-etic/" : "/ro/documente/cod-etic/"} target="_blank" rel="noopener">{lang === "en" ? "Code of Ethics" : "Codul Etic"} →</a>
      </p>
      <label class="ie__consim"><input type="checkbox" name="normeParticipare" value="1" required /> <span>{T.normeAccept} <b class="req">*</b></span></label>
    </fieldset>

    <fieldset class="ie__fs">
      <legend>{T.gdprTitlu}</legend>
      <p class="ie__gdpr">{T.gdprText}</p>
      <label class="ie__consim"><input type="checkbox" name="gdpr" value="1" required /> <span>{T.gdprAccept} <b class="req">*</b></span></label>
    </fieldset>

    <button class="btn btn--primary" type="submit" id="ie-submit">{T.trimite}</button>
  </form>
</section>

<script is:inline define:vars={{ AFISE, txtInchisOptiune: T.inchisOptiune, txtInchisButon: T.inchisButon, txtLimba: lang === "en" ? "en-GB" : "ro-RO", txtTermenFus: T.termenFus, txtTermenAzi: T.termenAzi, txtTermenMaine: T.termenMaine, txtTermenZile: T.termenZile, txtTermenZileDe: T.termenZileDe, txtTrimite: T.trimite, txtSe: T.seTrimite, succesDetaliu: T.succesDetaliu, txtDataInvalida: T.dataInvalida, txtTaxaAlege: T.taxaAlege, txtTaxaEste: T.taxaEste, txtLei: T.lei, txtFaraTaxa: T.faraTaxa, txtTaxaTa: T.taxaTa, txtTaxaDetaliu: T.taxaDetaliu, txtDovadaMare: T.dovadaMare, txtDovadaTipGresit: T.dovadaTipGresit, txtCaine: (lang === "en" ? "Dog" : "Câinele"), txtCampuriCaine: (lang === "en" ? "Dog {n}: fill in the required fields — name, breed (from the list), sex, date of birth, class and microchip (min. 6). Pedigree is required unless you tick typicity." : "Câinele {n}: completează câmpurile obligatorii — nume, rasă (din listă), sex, data nașterii, clasă și microcip (min. 6). Pedigree obligatoriu dacă nu bifezi tipicitatea."), txtTaxaTotal: (lang === "en" ? "Total entry fee:" : "Taxa totală de înscriere:") }}>
  (async function () {
    const form = document.getElementById("ie-form");
    const loading = document.getElementById("ie-loading");
    const gol = document.getElementById("ie-gol");
    const showSel = document.getElementById("ie-show");
    const raseList = document.getElementById("ie-rase");
    const err = document.getElementById("ie-err");
    const succes = document.getElementById("ie-succes");

    // Repetiția generală: cu „?repetitie=1" în adresă, formularul vede și expozițiile de
    // repetiție. Fără el — și așa intră publicul — nu există. Nu e o parolă; e un fel de a
    // nu pune „REPETIȚIE TEHNICĂ" lângă expozițiile adevărate.
    const eRepetitie = new URLSearchParams(location.search).get("repetitie") === "1";

    let expozitii = [];
    try {
      const r = await fetch("/.netlify/functions/inscriere-expo" + (eRepetitie ? "?repetitie=1" : ""));
      expozitii = (await r.json()).expozitii || [];
    } catch (e) {}

    loading.hidden = true;
    if (!expozitii.length) { gol.hidden = false; return; }

    showSel.innerHTML = expozitii
      .map((e) => `<option value="${e.showId}">${(e.repetitie ? "[REPETIȚIE] " : "") + e.nume} — ${new Date(e.data).toLocaleDateString()}${e.inchis ? " · " + txtInchisOptiune : ""}</option>`)
      .join("");

    // Prima expoziție deschisă, nu prima din listă: dacă cea mai apropiată e închisă,
    // omul ar deschide formularul direct pe un formular blocat.
    const primaDeschisa = expozitii.find((x) => !x.inchis);
    if (primaDeschisa) showSel.value = primaDeschisa.showId;

    // Banda de avertizare, ca nimeni să nu completeze din greșeală un formular de probă.
    const bandaRepetitie = document.getElementById("ie-repetitie");
    function aratBanda() {
      const e = expozitii.find((x) => x.showId === showSel.value);
      if (bandaRepetitie) bandaRepetitie.hidden = !e?.repetitie;
    }
    showSel.addEventListener("change", aratBanda);
    aratBanda();

    const caseta = document.getElementById("ie-afis");
    const poza = document.getElementById("ie-afis-img");
    const faraSemne = (s) => String(s || "").toLowerCase().replace(/[ăâ]/g, "a").replace(/[șş]/g, "s").replace(/[țţ]/g, "t").replace(/î/g, "i");
    function aratAfisul() {
      const e = expozitii.find((x) => x.showId === showSel.value);
      const a = e && AFISE.find((x) => faraSemne(e.nume).includes(x.cheie));
      if (a) { poza.src = a.src; poza.alt = a.alt; caseta.hidden = false; } else { caseta.hidden = true; }
    }
    showSel.addEventListener("change", aratAfisul);
    aratAfisul();

    // Termenul se arată în ORA ROMÂNIEI, spus pe față, nu în ora vizitatorului: expoziția
    // e în România, iar ora scrisă în manager e chiar ora care se aplică. Un expozant din
    // Germania care ar citi „20:00" fără să știe al cui e ceasul ar întârzia cu o oră.
    const randTermen = document.getElementById("ie-termen");
    const candTermen = document.getElementById("ie-termen-cand");
    function aratTermenul() {
      const e = expozitii.find((x) => x.showId === showSel.value);
      const d = e && e.termen ? new Date(e.termen) : null;
      if (!d || isNaN(d.getTime())) { randTermen.hidden = true; return; }
      const cand = d.toLocaleString(txtLimba, { timeZone: "Europe/Bucharest", weekday: "long", day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" });
      const zile = Math.ceil((d.getTime() - Date.now()) / 86400000);
      // Românește: „19 zile", dar „20 DE zile". Hotărăsc ultimele două cifre — 101 zile,
      // 120 de zile. Regula stă în cod, nu în text, ca traducătorul să nu aibă de ales.
      const r = zile % 100;
      const tipar = r >= 1 && r <= 19 ? txtTermenZile : txtTermenZileDe;
      const cate = zile <= 0 ? txtTermenAzi : zile === 1 ? txtTermenMaine : tipar.replace("{n}", zile);
      candTermen.textContent = cand + " (" + txtTermenFus + ") — " + cate;
      randTermen.hidden = false;
    }
    showSel.addEventListener("change", aratTermenul);
    aratTermenul();

    // Expoziție închisă prin trecerea termenului: rămâne la vedere, dar formularul se
    // încuie. Serverul refuză oricum trimiterea — asta e ca omul să nu completeze
    // douăzeci de câmpuri degeaba, nu o pază.
    const casetaInchis = document.getElementById("ie-inchis");
    const candInchis = document.getElementById("ie-inchis-cand");
    const butonul = document.getElementById("ie-submit");
    const textButon = butonul.textContent;
    function aplicaStarea() {
      const e = expozitii.find((x) => x.showId === showSel.value);
      const inchis = !!(e && e.inchis);
      for (const c of form.elements) {
        if (c === showSel || c.type === "submit") continue;
        c.disabled = inchis;
      }
      butonul.disabled = inchis;
      butonul.textContent = inchis ? txtInchisButon : textButon;
      if (inchis && e.termen) {
        const d = new Date(e.termen);
        candInchis.textContent = d.toLocaleString(txtLimba, { timeZone: "Europe/Bucharest", weekday: "long", day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" }) + " (" + txtTermenFus + ")";
      }
      casetaInchis.hidden = !inchis;
      // Ori una, ori alta: „se închid la…" n-are ce căuta lângă „s-au închis la…".
      if (inchis) randTermen.hidden = true; else aratTermenul();
    }
    showSel.addEventListener("change", aplicaStarea);
    aplicaStarea();

    function populeazaRase() {
      const e = expozitii.find((x) => x.showId === showSel.value);
      raseList.innerHTML = (e?.rase || [])
        .map((r) => `<option data-id="${r.id}" value="${r.numeRo}">${r.numeEn} · Gr. ${r.grupa}</option>`)
        .join("");
    }

    // ——— Blocurile de câine (repetabile): un bloc = un câine, clonat din șablon ———
    const containerCaini = document.getElementById("ie-caini");
    const tplCaine = document.getElementById("ie-caine-tpl");
    const nrCaini = document.getElementById("ie-nr-caini");
    const addCaine = document.getElementById("ie-add-caine");
    const MAX_CAINI = 12;
    const blocuri = () => Array.from(containerCaini.querySelectorAll(".ie__caine"));

    function rezolvaRasaBloc(b) {
      const e = expozitii.find((x) => x.showId === showSel.value);
      const rt = b.querySelector('[data-f="rasaText"]');
      const ri = b.querySelector('[data-f="rasaId"]');
      const g = (e?.rase || []).find((r) => r.numeRo === (rt.value || "").trim());
      ri.value = g ? g.id : "";
    }

    function renumeroteaza() {
      const b = blocuri();
      b.forEach((bl, i) => {
        bl.querySelector(".ie__caine-nr").textContent = txtCaine + " " + (i + 1);
        const del = bl.querySelector(".ie__caine-del");
        if (del) del.hidden = b.length <= 1;
        // Radiourile de sex trebuie să fie un grup propriu pe fiecare bloc.
        bl.querySelectorAll('[data-f="sex"]').forEach((r) => { r.name = "sex" + i; });
      });
      nrCaini.value = String(b.length);
      addCaine.disabled = b.length >= MAX_CAINI;
    }

    function wireBloc(b) {
      // Data se tastează zz.ll.aaaa; punctele se pun singure.
      const cd = b.querySelector('[data-f="dataNasterii"]');
      cd.addEventListener("input", () => {
        const cifre = cd.value.replace(/\D/g, "").slice(0, 8);
        let v = cifre;
        if (cifre.length > 4) v = cifre.slice(0, 2) + "." + cifre.slice(2, 4) + "." + cifre.slice(4);
        else if (cifre.length > 2) v = cifre.slice(0, 2) + "." + cifre.slice(2);
        cd.value = v;
      });
      // Pedigree obligatoriu, mai puțin când e bifată tipicitatea (câine de rasă fără acte).
      const tip = b.querySelector('[data-f="pedigreeTipicitate"]');
      const ped = b.querySelector('[data-f="pedigree"]');
      const sinc = () => { ped.closest(".ie__f").style.opacity = tip.checked ? "0.55" : ""; };
      tip.addEventListener("change", sinc); sinc();
      // Rasa: rezolvă id-ul din text; taxa se recalculează la schimbarea clasei.
      b.querySelector('[data-f="rasaText"]').addEventListener("input", () => rezolvaRasaBloc(b));
      b.querySelector('[data-f="clasa"]').addEventListener("change", actualizeazaPlata);
      const del = b.querySelector(".ie__caine-del");
      if (del) del.addEventListener("click", () => {
        if (blocuri().length <= 1) return;
        b.remove(); renumeroteaza(); actualizeazaPlata();
      });
    }

    function adaugaBloc() {
      if (blocuri().length >= MAX_CAINI) return null;
      const frag = tplCaine.content.cloneNode(true);
      const b = frag.querySelector(".ie__caine");
      containerCaini.appendChild(frag);
      wireBloc(b); renumeroteaza();
      return b;
    }

    // La schimbarea expoziției: repopulăm lista de rase și golim rasa aleasă pe fiecare bloc
    // (rasele diferă de la o expoziție la alta).
    showSel.addEventListener("change", () => {
      populeazaRase();
      blocuri().forEach((b) => {
        b.querySelector('[data-f="rasaText"]').value = "";
        b.querySelector('[data-f="rasaId"]').value = "";
      });
    });
    populeazaRase();
    form.hidden = false;
    adaugaBloc(); // primul câine

    addCaine.addEventListener("click", () => { adaugaBloc(); actualizeazaPlata(); aplicaStarea(); });
    nrCaini.addEventListener("change", () => {
      let n = Math.max(1, Math.min(MAX_CAINI, parseInt(nrCaini.value, 10) || 1));
      while (blocuri().length < n) adaugaBloc();
      while (blocuri().length > n) blocuri()[blocuri().length - 1].remove();
      renumeroteaza(); actualizeazaPlata(); aplicaStarea();
    });

    // Plata taxei: secțiunea apare doar când expoziția are taxe; bifa + dovada devin
    // obligatorii doar când TOTALUL pe lot e > 0 (regula e impusă și pe server).
    const plataFs = document.getElementById("ie-plata");
    const contZona = document.getElementById("ie-cont");
    const contLipsa = document.getElementById("ie-cont-lipsa");
    const contIban = document.getElementById("ie-iban");
    const contTitular = document.getElementById("ie-titular");
    const contBanca = document.getElementById("ie-banca");
    const contBancaSep = document.getElementById("ie-banca-sep");
    const taxaText = document.getElementById("ie-taxa-text");
    const bifaPlatit = document.getElementById("ie-amplatit");
    const campDovada = document.getElementById("ie-dovada");
    const zonaIntrebari = document.getElementById("ie-intrebari");
    const notaStudent = document.getElementById("ie-student-nota");
    const bifaStudent = form.querySelector('input[name="esteStudent"]');
    // Întrebarea „primul câine?" e acum automată (poziția în lot), deci o ascundem.
    const primulRadio = form.querySelector('input[name="primulCaine"]');
    const grupPrimul = primulRadio ? primulRadio.closest("fieldset") : null;
    const ales = (nume) => {
      const b = form.querySelector('input[name="' + nume + '"]:checked');
      return b ? b.value : "";
    };

    function expoCurenta() { return expozitii.find((x) => x.showId === showSel.value); }

    function grilaAreTaxe(g) {
      if (!g) return false;
      const v = [g.membru, g.nemembru].filter(Boolean);
      return v.some((c) => Number(c.primul) > 0 || Number(c.urmatorii) > 0);
    }

    // Aceeași aritmetică ca pe server (netlify/functions/_comun/taxa-expo.mjs). Suma
    // afișată e orientativă: serverul o recalculează la trimitere și el are ultimul cuvânt.
    // „primul" pentru preview = primul câine din acest lot; serverul ține cont și de câinii
    // pe care proprietarul i-a înscris deja mai devreme.
    function taxaGrilaClasa(grila, clasa, primul) {
      if (!grila) return 0;
      if ((grila.scutite || []).indexOf(clasa) !== -1) return 0;
      const col = ales("esteMembru") === "1" ? grila.membru : grila.nemembru;
      const baza = Number((col || {})[primul ? "primul" : "urmatorii"]) || 0;
      if (!baza) return 0;
      const red = bifaStudent && bifaStudent.checked ? Math.min(100, Number(grila.student) || 0) : 0;
      return Math.round((baza * (100 - red)) / 100);
    }

    function totalCurent() {
      const e = expoCurenta();
      const grila = e && e.tarif && grilaAreTaxe(e.tarif) ? e.tarif : null;
      let total = 0;
      blocuri().forEach((b, i) => {
        const clasa = b.querySelector('[data-f="clasa"]').value;
        if (!clasa) return;
        total += grila ? taxaGrilaClasa(grila, clasa, i === 0) : Number(((e && e.taxe) || {})[clasa] || 0);
      });
      return total;
    }

    function actualizeazaPlata() {
      const e = expoCurenta();
      const grilaNoua = e && e.tarif && grilaAreTaxe(e.tarif) ? e.tarif : null;
      const areTaxe = !!grilaNoua ||
        !!(e && e.taxe && Object.values(e.taxe).some((v) => Number(v) > 0));
      plataFs.hidden = !areTaxe;

      // Contul în care se plătește taxa — DOAR din expoziția aleasă (la o expoziție a unui
      // Membru Colectiv, banii intră în contul LUI). textContent, nu innerHTML.
      const cont = e && e.organizator;
      const areCont = !!(cont && cont.iban);
      if (contZona) contZona.hidden = !areCont;
      if (contLipsa) contLipsa.hidden = areCont;
      if (contIban) contIban.textContent = areCont ? cont.iban : "";
      if (contTitular) contTitular.textContent = areCont ? (cont.nume || "") : "";
      if (contBanca) contBanca.textContent = areCont ? (cont.banca || "") : "";
      if (contBancaSep) contBancaSep.hidden = !(areCont && cont.banca);

      zonaIntrebari.hidden = !grilaNoua;
      zonaIntrebari.querySelectorAll("input").forEach((i) => { i.disabled = !grilaNoua; });
      if (grupPrimul) { grupPrimul.hidden = true; grupPrimul.querySelectorAll("input").forEach((i) => { i.disabled = true; }); }
      if (notaStudent) notaStudent.hidden = !(bifaStudent && bifaStudent.checked);

      if (!areTaxe) return;
      const t = totalCurent();
      bifaPlatit.required = areTaxe && t > 0;
      campDovada.required = areTaxe && t > 0;
      const vreoClasa = blocuri().some((b) => b.querySelector('[data-f="clasa"]').value);
      if (!vreoClasa) taxaText.textContent = txtTaxaAlege;
      else if (t > 0) {
        taxaText.innerHTML = txtTaxaTotal + " <b>" + t + " " + txtLei + "</b>" +
          " <span class='ie__taxa-nota'>" + txtTaxaDetaliu + "</span>";
      } else taxaText.textContent = txtFaraTaxa;
    }
    showSel.addEventListener("change", actualizeazaPlata);
    zonaIntrebari.addEventListener("change", actualizeazaPlata);
    actualizeazaPlata();

    // Data nașterii se convertește în ISO la trimitere (formatul așteptat de server).
    function dataISO(v) {
      const m = /^(\d{2})\.(\d{2})\.(\d{4})$/.exec(String(v || "").trim());
      if (!m) return null;
      const [, z, l, a] = m;
      const d = new Date(Number(a), Number(l) - 1, Number(z));
      if (d.getFullYear() !== Number(a) || d.getMonth() !== Number(l) - 1 || d.getDate() !== Number(z)) return null;
      if (d > new Date() || Number(a) < 1990) return null;
      return a + "-" + l + "-" + z;
    }

    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      err.hidden = true;

      // Adunăm și validăm toți câinii; serverul revalidează tot și are ultimul cuvânt.
      const bls = blocuri();
      const caini = [];
      for (let i = 0; i < bls.length; i++) {
        const b = bls[i];
        rezolvaRasaBloc(b);
        const val = (f) => ((b.querySelector('[data-f="' + f + '"]') || {}).value || "").trim();
        const sexEl = b.querySelector('[data-f="sex"]:checked');
        const iso = dataISO(val("dataNasterii"));
        const numeCaine = val("numeCaine");
        const rasaId = val("rasaId");
        const tip = b.querySelector('[data-f="pedigreeTipicitate"]').checked;
        const pedigree = val("pedigree");
        const microcip = val("microcip");
        const clasa = val("clasa");
        const bun = numeCaine.length >= 2 && rasaId && sexEl && iso && clasa && microcip.length >= 6 && (tip || pedigree.length >= 2);
        if (!bun) {
          err.textContent = (iso ? "" : txtDataInvalida + " ") + txtCampuriCaine.replace("{n}", i + 1);
          err.hidden = false;
          b.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }
        caini.push({
          numeCaine, rasaId, sex: sexEl.value, dataNasterii: iso, clasa,
          pedigree, pedigreeTipicitate: tip ? "1" : "", microcip,
          crescator: val("crescator"), culoareRoba: val("culoareRoba"),
          tata: val("tata"), mama: val("mama"),
        });
      }

      // Dovada plății (una singură pentru tot lotul).
      const fisier = campDovada && campDovada.files && campDovada.files[0];
      if (fisier) {
        if (fisier.size > 4 * 1024 * 1024) {
          err.textContent = txtDovadaMare; err.hidden = false;
          err.scrollIntoView({ behavior: "smooth", block: "center" }); return;
        }
        if (!["image/jpeg", "image/png", "image/webp", "application/pdf"].includes(fisier.type)) {
          err.textContent = txtDovadaTipGresit; err.hidden = false;
          err.scrollIntoView({ behavior: "smooth", block: "center" }); return;
        }
      }

      const btn = document.getElementById("ie-submit");
      btn.disabled = true; btn.textContent = txtSe;
      // Blocul comun (proprietar + declarații) din câmpurile cu `name`; câinii merg în `caini`.
      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());
      delete payload.dovada;
      payload.caini = caini;
      if (fisier) {
        const dataUrl = await new Promise((res, rej) => {
          const fr = new FileReader();
          fr.onload = () => res(fr.result);
          fr.onerror = rej;
          fr.readAsDataURL(fisier);
        });
        payload.dovadaBase64 = String(dataUrl).split(",")[1] || "";
        payload.dovadaNume = fisier.name;
        payload.dovadaTip = fisier.type;
      }
      try {
        const res = await fetch("/.netlify/functions/inscriere-expo", {
          method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.eroare || "Eroare");
        const rez = document.getElementById("ie-succes-rezumat");
        const numeExpo = showSel && showSel.selectedIndex >= 0 ? showSel.options[showSel.selectedIndex].text : "";
        const nume = caini.map((c) => c.numeCaine).join(", ");
        rez.innerHTML = "<b>" + nume + "</b> — " + numeExpo + " — " + succesDetaliu;
        form.hidden = true; succes.hidden = false; form.reset();
        succes.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch (e2) {
        err.textContent = e2.message; err.hidden = false;
      } finally {
        btn.disabled = false; btn.textContent = txtTrimite;
      }
    });

    document.getElementById("ie-reset").addEventListener("click", () => {
      form.reset(); succes.hidden = true; form.hidden = false;
      // Păstrăm un singur bloc de câine, golit.
      blocuri().forEach((b, i) => { if (i > 0) b.remove(); });
      const b0 = blocuri()[0];
      if (b0) b0.querySelectorAll("input, select").forEach((el) => {
        if (el.type === "checkbox" || el.type === "radio") el.checked = false; else el.value = "";
      });
      populeazaRase(); renumeroteaza(); actualizeazaPlata();
    });
  })();
</script>

