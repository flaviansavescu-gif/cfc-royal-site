---
// CuiburiDisponibile.astro — anunțurile de cuiburi, bilingv (ca CarteaOrigini).
// Pagina RO stă la /cuiburi/, cea EN la /en/cuiburi/. Anunțurile vin cum au fost
// scrise de crescători (română); aici se traduce INTERFAȚA.
// Sursa: funcția registru-cuiburi (index cachedat).
import type { Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;

const RO = {
  acasa: "Acasă", acasaHref: "/ro/", pagina: "Cuiburi disponibile",
  titlu: "Cuiburi disponibile",
  cauta: "Caută după rasă sau afix…", toateRasele: "Toate rasele",
  seIncarca: "Se încarcă…",
  nuSeIncarca: "Anunțurile nu se pot încărca acum. Reîncearcă mai târziu.",
  niciun: "Niciun cuib nu corespunde filtrelor.",
  nimicAcum: "Nu sunt cuiburi disponibile momentan. Revino curând.",
  unCuib: "cuib disponibil", cuiburi: "cuiburi disponibile",
  mascul: "mascul", masculi: "masculi", femela: "femelă", femele: "femele",
  disponibili: "Disponibili:", fatati: "fătați la", tata: "Tată", mama: "Mamă",
  reco: "★ montă", recoTitlu: "Are recomandarea de calitate CFC-Royal",
  contact: "Contact:", valabil: "anunț valabil până la",
  crescator: "Ești crescător membru și ai pui disponibili?",
  crescatorLink: "Publică un anunț din spațiul tău →",
  caineHref: "/caine/",
  canisaHref: "/canisa/",
};
const EN = {
  acasa: "Home", acasaHref: "/en/", pagina: "Available litters",
  titlu: "Available litters",
  cauta: "Search by breed or affix…", toateRasele: "All breeds",
  seIncarca: "Loading…",
  nuSeIncarca: "The listings cannot be loaded right now. Please try again later.",
  niciun: "No litter matches the filters.",
  nimicAcum: "No litters available at the moment. Check back soon.",
  unCuib: "litter available", cuiburi: "litters available",
  mascul: "male", masculi: "males", femela: "female", femele: "females",
  disponibili: "Available:", fatati: "born on", tata: "Sire", mama: "Dam",
  reco: "★ breeding", recoTitlu: "Holds the CFC-Royal quality breeding recommendation",
  contact: "Contact:", valabil: "listing valid until",
  crescator: "Are you a member breeder with available puppies?",
  crescatorLink: "Post a listing from your breeder space →",
  caineHref: "/en/caine/",
  canisaHref: "/en/canisa/",
};
const T = lang === "en" ? EN : RO;
---

<section class="cu">
  <p class="cu__cale"><a href={T.acasaHref}>{T.acasa}</a> · {T.pagina}</p>
  <h1 class="cu__title">{T.titlu}</h1>
  <p class="cu__intro">
    {lang === "en" ? (
      <>Litters with available puppies at the club's kennels. Every listing is tied to a
      <strong> litter declared in the register</strong> and approved by the registry office; you can
      see both parents, with <strong>their record and health tests</strong>, and contact the breeder
      directly. Listings are written by the breeders, in Romanian.
      <br /><small>No prices are shown here — the register is not a shop. Price is discussed with the breeder.</small></>
    ) : (
      <>Cuiburi cu pui disponibili la canisele clubului. Fiecare anunț e legat de un <strong>cuib declarat în registru</strong> și aprobat de registratură; vezi ambii părinți,
      cu <strong>fișa și testele lor de sănătate</strong>, și iei legătura direct cu crescătorul.
      <br /><small>Aici nu se afișează prețuri — registrul nu e un magazin. Prețul îl discuți cu crescătorul.</small></>
    )}
  </p>

  <div class="cu__filtre" role="search">
    <input id="cu-cauta" type="search" placeholder={T.cauta} aria-label={T.cauta} />
    <select id="cu-rasa" aria-label={lang === "en" ? "Breed" : "Rasă"}><option value="">{T.toateRasele}</option></select>
  </div>

  <p class="cu__nr" id="cu-nr" aria-live="polite"></p>
  <ul class="cu__lista" id="cu-lista"><li class="cu__gol">{T.seIncarca}</li></ul>

  <p class="cu__crescator">
    {T.crescator}
    <a href="/crescatori/cuiburi/">{T.crescatorLink}</a>
  </p>
</section>

<style>
  .cu { max-width: var(--maxw); margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  .cu__cale { font-size: .85rem; color: var(--color-text-muted); margin: 0 0 .3rem; }
  .cu__cale a { color: var(--color-link); }
  .cu__title { color: var(--color-primary); }
  .cu__intro { color: var(--color-text-muted); max-width: 48rem; }
  .cu__intro small { color: var(--color-text-muted); }
  .cu__filtre { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.2rem 0 .4rem; }
  .cu__filtre input,
  .cu__filtre select {
    padding: .55rem .7rem; border: 1px solid var(--color-border); border-radius: var(--radius);
    font: inherit; background: var(--color-surface);
  }
  .cu__filtre input { flex: 1 1 16rem; }
  .cu__nr { color: var(--color-text-muted); font-size: .88rem; margin: .3rem 0 .6rem; }
  .cu__lista { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); }
  :global(.cu__card) {
    border: 1px solid var(--color-border); border-radius: var(--radius);
    background: var(--color-surface); padding: 1rem 1.1rem 1.1rem; display: flex; flex-direction: column; gap: .5rem;
  }
  :global(.cu__cap) { display: flex; justify-content: space-between; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
  :global(.cu__rasa) { font-weight: 700; color: var(--color-primary); font-size: 1.05rem; }
  :global(.cu__afix a) { color: var(--color-link); text-decoration: none; font-size: .88rem; }
  :global(.cu__afix a:hover) { text-decoration: underline; }
  :global(.cu__disp) { font-size: .9rem; }
  :global(.cu__disp strong) { color: var(--color-text); }
  :global(.cu__parinti) { display: grid; gap: .4rem; margin: .2rem 0; }
  :global(.cu__par) { border-left: 3px solid var(--color-border); padding: .1rem 0 .1rem .6rem; font-size: .9rem; }
  :global(.cu__par-rol) { font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: var(--color-text-muted); }
  :global(.cu__par-nume a) { color: var(--color-link); text-decoration: none; font-weight: 600; }
  :global(.cu__par-nume a:hover) { text-decoration: underline; }
  :global(.cu__reco) { display: inline-block; font-size: .72rem; font-weight: 600; color: var(--color-success); margin-left: .3rem; white-space: nowrap; }
  :global(.cu__insigne) { display: flex; flex-wrap: wrap; gap: .25rem; margin-top: .2rem; }
  :global(.cu__insigna) { font-size: .72rem; background: var(--color-surface-alt); border: 1px solid var(--color-border);
    border-radius: 999px; padding: .05rem .5rem; color: var(--color-text-muted); }
  :global(.cu__nota) { font-size: .88rem; color: var(--color-text); background: var(--color-surface-alt);
    border-radius: var(--radius); padding: .5rem .7rem; }
  :global(.cu__contact) { font-size: .88rem; margin-top: auto; padding-top: .3rem; border-top: 1px dashed var(--color-border); }
  :global(.cu__contact strong) { color: var(--color-primary); }
  :global(.cu__meta) { font-size: .78rem; color: var(--color-text-muted); }
  :global(.cu__gol) { color: var(--color-text-muted); padding: .8rem 0; }
  .cu__crescator { margin-top: 2rem; color: var(--color-text-muted); }
  .cu__crescator a { color: var(--color-link); }
</style>

<script is:inline define:vars={{ T }}>
  (function () {
    var toti = [];
    var cauta = document.getElementById("cu-cauta");
    var fRasa = document.getElementById("cu-rasa");
    var lista = document.getElementById("cu-lista");
    var nrEl = document.getElementById("cu-nr");

    function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
    function faraDiac(s) { return String(s || "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, ""); }

    function randParinte(rol, p) {
      if (!p) return "";
      var nume = p.serie
        ? "<a href='" + T.caineHref + "?r=" + encodeURIComponent(p.serie) + "'>" + esc(p.nume || "—") + "</a>"
        : esc(p.nume || "—");
      var reco = p.recomandat ? "<span class='cu__reco' title='" + esc(T.recoTitlu) + "'>" + esc(T.reco) + "</span>" : "";
      var insigne = (p.insigne && p.insigne.length)
        ? "<div class='cu__insigne'>" + p.insigne.map(function (i) { return "<span class='cu__insigna'>" + esc(i) + "</span>"; }).join("") + "</div>"
        : "";
      return "<div class='cu__par'><div class='cu__par-rol'>" + esc(rol) + "</div>"
        + "<div class='cu__par-nume'>" + nume + reco + "</div>" + insigne + "</div>";
    }

    function randCard(a) {
      var disp = [];
      if (a.disponibiliM) disp.push(a.disponibiliM + " " + (a.disponibiliM === 1 ? T.mascul : T.masculi));
      if (a.disponibiliF) disp.push(a.disponibiliF + " " + (a.disponibiliF === 1 ? T.femela : T.femele));
      var afix = a.afix
        ? "<span class='cu__afix'>" + (a.afixNorm ? "<a href='" + T.canisaHref + "?a=" + encodeURIComponent(a.afixNorm) + "'>" + esc(a.afix) + "</a>" : esc(a.afix)) + "</span>"
        : "";
      var contact = [
        a.contactNume ? esc(a.contactNume) : "",
        a.contactTelefon ? "<a href='tel:" + esc(a.contactTelefon.replace(/\s/g, "")) + "'>" + esc(a.contactTelefon) + "</a>" : "",
        a.contactEmail ? "<a href='mailto:" + esc(a.contactEmail) + "'>" + esc(a.contactEmail) + "</a>" : "",
      ].filter(Boolean).join(" · ");
      var nota = a.nota ? "<div class='cu__nota'>" + esc(a.nota) + "</div>" : "";
      var expira = a.expiraLa ? "<div class='cu__meta'>" + esc(T.valabil) + " " + esc(String(a.expiraLa).slice(0, 10)) + "</div>" : "";
      return "<li class='cu__card'>"
        + "<div class='cu__cap'><span class='cu__rasa'>" + esc(a.rasa || "—") + (a.varietate ? " · " + esc(a.varietate) : "") + "</span>" + afix + "</div>"
        + "<div class='cu__disp'><strong>" + esc(T.disponibili) + "</strong> " + (disp.length ? disp.join(" · ") : "—")
        + (a.dataFatarii ? " · " + esc(T.fatati) + " " + esc(a.dataFatarii) : "") + "</div>"
        + "<div class='cu__parinti'>" + randParinte(T.tata, a.tata) + randParinte(T.mama, a.mama) + "</div>"
        + nota
        + "<div class='cu__contact'><strong>" + esc(T.contact) + "</strong> " + (contact || "—") + "</div>"
        + expira + "</li>";
    }

    function aplica() {
      var q = faraDiac(cauta.value.trim());
      var rasa = fRasa.value;
      var out = toti.filter(function (a) {
        if (rasa && a.rasa !== rasa) return false;
        if (q && faraDiac(a.rasa).indexOf(q) === -1 && faraDiac(a.afix).indexOf(q) === -1) return false;
        return true;
      });
      nrEl.textContent = out.length + " " + (out.length === 1 ? T.unCuib : T.cuiburi);
      lista.innerHTML = out.length ? out.map(randCard).join("") : "<li class='cu__gol'>" + esc(T.niciun) + "</li>";
    }
    [cauta, fRasa].forEach(function (el) { el.addEventListener("input", aplica); el.addEventListener("change", aplica); });

    fetch("/.netlify/functions/registru-cuiburi", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ actiune: "lista" }),
    })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d) { lista.innerHTML = "<li class='cu__gol'>" + esc(T.nuSeIncarca) + "</li>"; nrEl.textContent = ""; return; }
        toti = d.anunturi || [];
        if (!toti.length) {
          lista.innerHTML = "<li class='cu__gol'>" + esc(T.nimicAcum) + "</li>";
          nrEl.textContent = ""; return;
        }
        var rase = Array.from(new Set(toti.map(function (a) { return a.rasa; }).filter(Boolean))).sort(function (a, b) { return a.localeCompare(b, "ro"); });
        fRasa.insertAdjacentHTML("beforeend", rase.map(function (r) { return "<option value='" + esc(r) + "'>" + esc(r) + "</option>"; }).join(""));
        aplica();
      })
      .catch(function () { lista.innerHTML = "<li class='cu__gol'>" + esc(T.nuSeIncarca) + "</li>"; nrEl.textContent = ""; });
  })();
</script>
