---
// /registru/registratura/ — spațiul de lucru al Registraturii.
// Aici ajung dosarele depuse de canise: verificarea pieselor, extragerea ascendenței
// din pedigree-urile părinților, atribuirea numărului de cuib WDF și pregătirea
// Certificatelor Pedigree Tip A și B.
import RegistruLayout from "../../../layouts/RegistruLayout.astro";
---

<RegistruLayout title="Registratura" allow={["registratura"]}>
  <p class="g-eyebrow">Registrul genealogic · Registratura</p>
  <h1 class="g-title">Dosarele de înregistrare</h1>
  <p class="g-sub" id="g-cine"></p>

  <p class="g-unelte">
    <a class="btn btn--outline" href="/registru/registratura/inscrieri/">
      📋 Verificarea înscrierilor în expoziții →
    </a>
    <span>Actele exemplarelor înscrise pe site, înainte de preluarea lor în managerul de expoziții.</span>
  </p>

  <p class="g-unelte">
    <a class="btn btn--outline" href="https://rou.pedigree-database.org/en/" target="_blank" rel="noopener">
      🌐 Baza de pedigree WDF ↗
    </a>
    <span>Pentru căutarea exemplarelor după număr de pedigree sau microcip, la verificarea dosarelor
    și la transcrierea ascendenței.</span>
  </p>

  <div class="g-flux">
    <h2 class="g-h2">Ce se verifică la fiecare dosar</h2>
    <ol class="g-lista">
      <li><strong>Declarația de Montă și Fătare</strong> — completă, în termenul de 90 de zile de la fătare, confirmată de proprietarul masculului.</li>
      <li><strong>Pedigree-ul masculului</strong> — copie digitală lizibilă.</li>
      <li><strong>Pedigree-ul femelei</strong> — copie digitală lizibilă.</li>
      <li><strong>Dovada dreptului de montă al femelei</strong> — fișa de arbitraj sau imaginea din
      carnetul de performanță, care atestă minimum un calificativ „Bun". După ce expozițiile trec
      prin registrul propriu, verificarea se va putea face automat din rezultate.</li>
      <li><strong>Dovada plății.</strong></li>
    </ol>
    <p class="g-nota">
      Din pedigree-urile părinților se extrage ascendența pe patru generații — părinți, bunici,
      străbunici și stră-străbunici — pentru înregistrarea cuibului în baza World Dog Federation.
      Tipul certificatului rezultă din date: <strong>Tip A</strong> dacă toate pozițiile au detalii
      de înregistrare, <strong>Tip B</strong> dacă lipsește oricare, pe oricare dintre linii.
    </p>
  </div>

  {/* Munca de secretariat a accesului la registru, mutată aici de la administrator:
      cererile se sprijină pe date pe care le are registratura — cine e membru și cine
      are cotizația la zi. Secțiuni pliabile, ca pagina să rămână limpede. */}
  <details class="r-sectiune" data-sectiune="cereri">
    <summary class="r-sumar">
      <span class="r-sumar__titlu">Cereri de acces</span>
      <span class="r-numar" id="r-cereri-numar" hidden></span>
    </summary>
    <p class="g-nota">Oameni care au cerut cod de acces la registru. După ce le generezi codul,
    cererea se închide singură.</p>
    <ul class="r-lista" id="r-cereri"></ul>
  </details>

  <details class="r-sectiune" data-sectiune="membri">
    <summary class="r-sumar">
      <span class="r-sumar__titlu">Membri cu drept de solicitare</span>
      <span class="r-numar" id="r-membri-numar" hidden></span>
    </summary>
    <div id="r-adauga" hidden>
      <p class="g-nota">Codul se generează o singură dată și se arată o singură dată. Trimite-l pe
      e-mail din butonul de lângă el, sau notează-l pe loc.</p>
      <div class="r-form">
        <input id="r-nume" type="text" placeholder="Numele complet al membrului" />
        <input id="r-email" type="email" placeholder="E-mail" />
        <label class="r-camp">Cotizația achitată până la
          <input id="r-cotizatie" type="date" />
        </label>
        <input id="r-afix" type="text" placeholder="Afix (opțional)" />
        <button id="r-adauga-btn" class="btn btn--outline" type="button">Generează codul</button>
      </div>
      <p class="r-cod" id="r-cod" hidden></p>
    </div>
    <p class="g-nota" id="r-fara-drept" hidden>Codurile de acces le generează registratorul desemnat.
    Tu poți vedea lista și starea cotizațiilor. Dacă ai nevoie de acest drept, cere-i administratorului.</p>
    <ul class="r-lista" id="r-membri"></ul>
  </details>

  <details class="r-sectiune" data-sectiune="jurnal">
    <summary class="r-sumar">
      <span class="r-sumar__titlu">Faptele mele în registru</span>
    </summary>
    <p class="g-nota">Ce ai făcut tu în registru — nu tot jurnalul asociației.</p>
    <ul class="r-lista" id="r-jurnal"></ul>
  </details>

  <h2 class="g-h2">Dosare</h2>
  <p class="g-filtre">
    <button class="g-filtru is-activ" type="button" data-f="lucru">În lucru <span id="g-nr-lucru"></span></button>
    <button class="g-filtru" type="button" data-f="arhiva">Arhivă <span id="g-nr-arhiva"></span></button>
    <button class="g-filtru" type="button" data-f="toate">Toate</button>
    <input id="g-cauta" type="search" placeholder="caută serie, rasă sau crescător…" />
  </p>
  <p class="g-explic">
    Un dosar iese din lista de lucru când i s-au emis certificatele sau când a fost respins.
    <strong>Nu se șterge niciodată</strong>: e dovada din spatele actelor eliberate.
  </p>
  <ul class="g-dosare" id="g-dosare"><li class="g-gol">Se încarcă…</li></ul>

  <div class="g-detaliu" id="g-detaliu" hidden></div>
</RegistruLayout>

<script is:inline>
  (function () {
    const F = "/.netlify/functions/registru-dmf";
    const cod = () => localStorage.getItem("cfcrRegistruCod") || "";
    // A doua cheie: fără ea serverul refuză, chiar dacă codul e bun.
    const dispozitiv = () => localStorage.getItem("cfcrRegistruDispozitiv") || "";
    let r = null;
    try { r = JSON.parse(localStorage.getItem("cfcrRegistru") || "null"); } catch (e) {}
    if (r && r.nume) document.getElementById("g-cine").textContent = "Autentificat: " + r.nume;

    const lista = document.getElementById("g-dosare");
    const detaliu = document.getElementById("g-detaliu");
    const dataRo = (s) => { const x = new Date(s); return isNaN(x) ? String(s || "") : x.toLocaleDateString("ro-RO"); };
    const FELURI = {
      "pedigree-mascul": "Pedigree mascul", "pedigree-femela": "Pedigree femelă",
      "drept-monta": "Drept de montă", "plata": "Dovada plății",
    };

    const post = (b) => fetch(F, { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify(Object.assign({ cod: cod(), dispozitiv: dispozitiv() }, b)) });

    // Textul dosarelor vine de la crescători: NUMAI textContent, niciodată innerHTML.
    // Altfel numele unui câine ar putea executa cod în pagina registratorului.
    const el = (tag, cls, text) => {
      const x = document.createElement(tag);
      if (cls) x.className = cls;
      if (text != null) x.textContent = text;
      return x;
    };

    // ——— Accesul la registru: cereri, membri, faptele proprii ———
    // Serverul hotărăște ce am voie: dacă n-am dreptul de a genera coduri, butonul
    // nici nu apare. Poarta e acolo, nu aici — asta e doar politețe față de ochi.
    const A = "/.netlify/functions/registru-acces";
    const postA = (b) => fetch(A, { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify(Object.assign({ cod: cod(), dispozitiv: dispozitiv() }, b)) });
    let potDaCoduri = false;

    function numarSec(id, n, singular, plural) {
      const x = document.getElementById(id);
      if (!x) return;
      x.hidden = !n;
      x.textContent = n ? n + " " + (n === 1 ? singular : plural) : "";
    }

    async function incarcaCereri() {
      const ul = document.getElementById("r-cereri");
      ul.textContent = "";
      const res = await postA({ actiune: "cereri" });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) { ul.appendChild(el("li", "g-gol", d.eroare || "Eroare")); return; }
      const lst = d.cereri || [];
      numarSec("r-cereri-numar", lst.length, "cerere", "cereri");
      if (!lst.length) { ul.appendChild(el("li", "g-gol", "Nicio cerere în așteptare.")); return; }
      lst.forEach((c) => {
        const li = el("li");
        const info = el("div");
        info.appendChild(el("strong", null, c.nume));
        info.appendChild(el("span", "g-meta", [c.email, c.telefon, c.mesaj].filter(Boolean).join(" · ")));
        li.appendChild(info);
        const b = el("button", "btn btn--outline", "Închide cererea");
        b.addEventListener("click", async () => {
          if (!confirm("Închizi cererea lui " + c.nume + "?")) return;
          await postA({ actiune: "cerere-sterge", id: c.id });
          incarcaCereri();
        });
        li.appendChild(b);
        ul.appendChild(li);
      });
    }

    async function incarcaMembri() {
      const ul = document.getElementById("r-membri");
      ul.textContent = "";
      const res = await postA({ actiune: "membri" });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) { ul.appendChild(el("li", "g-gol", d.eroare || "Eroare")); return; }
      // Dreptul vine cu lista: dacă administratorul l-a dat sau l-a luat între timp,
      // se vede acum, nu după o nouă autentificare.
      if (typeof d.poateDaAcces === "boolean" && d.poateDaAcces !== potDaCoduri) {
        potDaCoduri = d.poateDaAcces;
        document.getElementById("r-adauga").hidden = !potDaCoduri;
        document.getElementById("r-fara-drept").hidden = potDaCoduri;
      }
      const lst = d.membri || [];
      numarSec("r-membri-numar", lst.length, "membru", "membri");
      if (!lst.length) { ul.appendChild(el("li", "g-gol", "Niciun membru încă.")); return; }
      lst.forEach((m) => {
        const li = el("li");
        const info = el("div");
        info.appendChild(el("strong", null, m.nume + (m.afix ? " · " + m.afix : "")));
        info.appendChild(el("span", "g-meta", m.email || "fără e-mail"));
        const c = el("span", m.cotizatieLaZi ? "r-cotizatie is-ok" : "r-cotizatie is-rau",
          m.cotizatieLaZi ? "cotizație la zi" + (m.cotizatiePana ? " până la " + dataRo(m.cotizatiePana) : "")
                          : "cotizație expirată");
        info.appendChild(c);
        li.appendChild(info);
        if (potDaCoduri) {
          // Serverul cere data până la care e achitată, nu un „+12 luni" presupus:
          // cotizația se plătește pe perioade care nu încep neapărat azi.
          const rand = el("span", "r-reinnoire");
          const data = document.createElement("input");
          data.type = "date";
          data.value = m.cotizatiePana || "";
          const zi = el("button", "btn btn--outline", "Reînnoiește");
          zi.addEventListener("click", async () => {
            if (!data.value) { data.focus(); return; }
            zi.disabled = true;
            const res2 = await postA({ actiune: "membru-cotizatie", id: m.id, cotizatiePana: data.value });
            const d2 = await res2.json().catch(() => ({}));
            if (!res2.ok) { alert(d2.eroare || "Nu am putut reînnoi."); zi.disabled = false; return; }
            incarcaMembri();
          });
          rand.appendChild(data); rand.appendChild(zi);
          li.appendChild(rand);
        }
        ul.appendChild(li);
      });
    }

    async function incarcaJurnalulMeu() {
      const ul = document.getElementById("r-jurnal");
      ul.textContent = "";
      const res = await postA({ actiune: "jurnal", limita: 100 });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) { ul.appendChild(el("li", "g-gol", d.eroare || "Eroare")); return; }
      const lst = d.intrari || [];
      if (!lst.length) { ul.appendChild(el("li", "g-gol", "Nicio faptă consemnată luna aceasta.")); return; }
      lst.forEach((x) => {
        const li = el("li");
        const info = el("div");
        info.appendChild(el("strong", null, x.eticheta || x.fapta));
        info.appendChild(el("span", "g-meta",
          [x.obiect, x.detalii, x.la ? new Date(x.la).toLocaleString("ro-RO") : ""].filter(Boolean).join(" · ")));
        li.appendChild(info);
        ul.appendChild(li);
      });
    }

    document.getElementById("r-adauga-btn").addEventListener("click", async () => {
      const nume = document.getElementById("r-nume").value.trim();
      const email = document.getElementById("r-email").value.trim();
      const afix = document.getElementById("r-afix").value.trim();
      const cotizatiePana = document.getElementById("r-cotizatie").value;
      if (nume.length < 3) { alert("Scrie numele complet al membrului."); return; }
      if (!email) { alert("Scrie adresa de e-mail: pe ea pleacă numărul de înregistrare."); return; }
      if (!cotizatiePana) { alert("Scrie data până la care e achitată cotizația."); return; }
      const btn = document.getElementById("r-adauga-btn");
      btn.disabled = true;
      try {
        const res = await postA({ actiune: "membru-adauga", nume, email, afix, cotizatiePana });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) { alert(d.eroare || "Nu am putut genera codul."); return; }
        const zona = document.getElementById("r-cod");
        zona.hidden = false;
        zona.textContent = "";
        zona.appendChild(el("span", null, "Codul lui " + nume + ": "));
        zona.appendChild(el("code", "r-cod__val", (d.membru && d.membru.cod) || "—"));
        if (email) {
          const t = el("button", "btn btn--outline", "✉ Trimite codul pe e-mail");
          t.addEventListener("click", async () => {
            t.disabled = true;
            const r2 = await postA({ actiune: "trimite-cod", codNou: d.membru && d.membru.cod });
            const d2 = await r2.json().catch(() => ({}));
            t.textContent = r2.ok ? "✓ trimis" : (d2.eroare || "nu s-a putut trimite");
          });
          zona.appendChild(t);
        }
        document.getElementById("r-nume").value = "";
        document.getElementById("r-email").value = "";
        document.getElementById("r-afix").value = "";
        document.getElementById("r-cotizatie").value = "";
        incarcaMembri(); incarcaCereri();
      } finally { btn.disabled = false; }
    });

    // Secțiunile se încarcă abia la deschidere: pagina nu trebuie să ceară de la server
    // liste pe care nimeni nu le-a cerut.
    const INCARCATOARE = { cereri: incarcaCereri, membri: incarcaMembri, jurnal: incarcaJurnalulMeu };
    document.querySelectorAll("details.r-sectiune").forEach((det) => {
      det.addEventListener("toggle", () => {
        if (!det.open || det.dataset.incarcat === "da") return;
        det.dataset.incarcat = "da";
        const f = INCARCATOARE[det.dataset.sectiune];
        if (f) f();
      });
    });

    // Dreptul de a genera coduri vine de la server, la intrare, și e reținut în sesiune.
    // Aici îl folosim DOAR ca să nu arătăm un formular care oricum ar fi refuzat: poarta
    // adevărată e pe server, iar o sesiune modificată în browser nu deschide nimic.
    potDaCoduri = !!(r && r.poateDaAcces);
    document.getElementById("r-adauga").hidden = !potDaCoduri;
    document.getElementById("r-fara-drept").hidden = potDaCoduri;

    async function deschide(id) {
      detaliu.hidden = false;
      detaliu.textContent = "";
      detaliu.appendChild(el("p", "g-gol", "Se încarcă dosarul…"));
      const res = await post({ actiune: "dosar", id });
      const d = (await res.json().catch(() => ({}))).dosar;
      detaliu.textContent = "";
      if (!d) { detaliu.appendChild(el("p", "g-gol", "Dosarul nu a putut fi încărcat.")); return; }

      detaliu.appendChild(el("h3", "g-dh", d.serie + " — " + d.rasa));
      const catre = document.createElement("a");
      catre.className = "btn btn--primary btn--small";
      catre.href = "/registru/registratura/ascendenta/?id=" + encodeURIComponent(id);
      catre.textContent = d.numarWDF
        ? "Ascendența și certificatele (" + d.numarWDF + ") →"
        : "Ascendența, numărul de cuib și certificatele →";
      detaliu.appendChild(catre);
      const meta = el("p", "g-dmeta",
        [d.membruNume, "montă " + dataRo(d.dataMontei), "fătare " + dataRo(d.dataFatarii),
         "născuți " + (d.nascutiM + d.nascutiF), "rămași " + d.pui.length,
         d.afix ? "afix " + d.afix : null].filter(Boolean).join(" · "));
      detaliu.appendChild(meta);
      if (d.pesteTermen) detaliu.appendChild(el("p", "g-termen", "Depusă după " + d.zileDeLaFatare + " de zile — peste termenul de 90."));

      for (const [cheie, eticheta] of [["mascul", "♂ Masculul"], ["femela", "♀ Femela"]]) {
        const p = d[cheie];
        detaliu.appendChild(el("h4", "g-dh4", eticheta + ": " + p.nume));
        detaliu.appendChild(el("p", "g-dmeta",
          ["pedigree " + p.pedigree, "microcip " + p.microcip, "n. " + dataRo(p.dataNasterii),
           "prop. " + p.proprietar, p.email || null].filter(Boolean).join(" · ")));
      }

      detaliu.appendChild(el("h4", "g-dh4", "Puii (" + d.pui.length + ")"));
      const ul = el("ul", "g-pui");
      for (const pu of d.pui) {
        ul.appendChild(el("li", null,
          (pu.sex === "M" ? "♂ " : "♀ ") + pu.nume +
          [pu.culoare, pu.tipPar, pu.identificare, pu.cumparator && pu.cumparator.nume ? "→ " + pu.cumparator.nume : null]
            .filter(Boolean).map((x) => " · " + x).join("")));
      }
      detaliu.appendChild(ul);

      if (d.stare === "respins" && d.respingere) {
        detaliu.appendChild(el("p", "g-motiv",
          "Dosar respins la " + dataRo(d.respingere.la) + " de " + d.respingere.deCatre +
          ". Motivul: " + d.respingere.motiv));
      }

      // —— Semnătura declarantului ——
      // Ține locul rubricii „Semnătura" de pe formularul tipărit. Fără urma asta,
      // declarația ar fi doar un formular trimis de un cont.
      const sem = d.semnaturaUrma;
      if (sem) {
        detaliu.appendChild(el("h4", "g-dh4", "Semnătura declarantului"));
        detaliu.appendChild(el("p", "g-semn", "✍ " + sem.nume));
        detaliu.appendChild(el("p", "g-dmeta",
          ["asumată la " + dataRo(sem.la), sem.ip ? "de la " + sem.ip : null].filter(Boolean).join(" · ")));
      }

      // —— Confirmarea proprietarului masculului ——
      detaliu.appendChild(el("h4", "g-dh4", "Confirmarea montei"));
      const c = d.confirmare || { stare: "asteptare" };
      const stare = el("p", "g-conf is-" + c.stare, {
        asteptare: "⏳ Așteaptă răspunsul proprietarului masculului",
        confirmat: "✓ Confirmată de proprietarul masculului",
        refuzat: "⚠ Proprietarul masculului NU a confirmat",
        alternativ: "✓ Acceptată pe baza dovezii semnate, încărcată de registratură",
      }[c.stare] || c.stare);
      detaliu.appendChild(stare);
      const detConf = [c.email ? "adresa " + c.email : null, c.nume ? "răspuns de " + c.nume : null,
        c.la ? dataRo(c.la) : null, c.deCatre ? "de " + c.deCatre : null,
        c.trimiteri > 1 ? c.trimiteri + " trimiteri" : null,
        c.adresaCorectata ? "adresă corectată o dată" : null].filter(Boolean);
      if (detConf.length) detaliu.appendChild(el("p", "g-dmeta", detConf.join(" · ")));
      if (c.motiv) detaliu.appendChild(el("p", "g-motiv", "Motivul invocat: " + c.motiv));
      if (c.observatie) detaliu.appendChild(el("p", "g-dmeta", "Observația registraturii: " + c.observatie));

      // Dovada semnată pe hârtie: la masculii din străinătate e-mailul se pierde des,
      // iar dosarul ar rămâne blocat pentru totdeauna.
      if (c.stare !== "confirmat") {
        const zona = el("div", "g-alt");
        zona.appendChild(el("label", "g-alt__eticheta", "Încarcă dovada semnată a montei (JPEG, PNG, WEBP sau PDF):"));
        const camp = document.createElement("input");
        camp.type = "file";
        camp.accept = "image/jpeg,image/png,image/webp,application/pdf";
        const obs = document.createElement("input");
        obs.type = "text";
        obs.placeholder = "observație (opțional)";
        obs.className = "g-alt__obs";
        const stareUrcare = el("span", "g-alt__stare");
        camp.addEventListener("change", async (ev) => {
          const file = ev.target.files && ev.target.files[0];
          if (!file) return;
          if (file.size > 5 * 1024 * 1024) { stareUrcare.textContent = "Fișierul depășește 5 MB."; return; }
          stareUrcare.textContent = "se încarcă…";
          try {
            const b64 = await new Promise((rez, resp) => {
              const fr = new FileReader();
              fr.onload = () => rez(String(fr.result).split(",")[1] || "");
              fr.onerror = resp;
              fr.readAsDataURL(file);
            });
            const r = await post({ actiune: "confirmare-alternativa", id,
              nume: file.name, tip: file.type, continut: b64, observatie: obs.value.trim() });
            const dd = await r.json().catch(() => ({}));
            if (!r.ok) throw new Error(dd.eroare || "Încărcare eșuată.");
            stareUrcare.textContent = "✓ înregistrată";
            deschide(id);
          } catch (e) { stareUrcare.textContent = e.message; }
        });
        zona.append(camp, obs, stareUrcare);
        detaliu.appendChild(zona);
      }

      detaliu.appendChild(el("h4", "g-dh4", "Piesele dosarului"));
      const piese = el("p", "g-piese");
      const feluri = Object.assign({}, FELURI);
      if (c.stare === "alternativ") feluri["confirmare-alternativa"] = "Dovada semnată";
      for (const fel of Object.keys(feluri)) {
        const b = el("button", "btn btn--outline g-piesa", feluri[fel]);
        b.type = "button";
        b.addEventListener("click", async () => {
          b.disabled = true;
          try {
            const rf = await post({ actiune: "vezi-fisier", id, fel });
            if (!rf.ok) throw new Error("indisponibil");
            const url = URL.createObjectURL(await rf.blob());
            window.open(url, "_blank", "noopener");
            // Eliberăm memoria după ce fereastra a apucat să încarce.
            setTimeout(() => URL.revokeObjectURL(url), 60000);
          } catch (e) { b.textContent = feluri[fel] + " — lipsă"; }
          b.disabled = false;
        });
        piese.appendChild(b);
      }
      detaliu.appendChild(piese);

      // Respingerea motivată e singura cale de a scoate din lucru un dosar care nu se
      // poate soluționa. Certificatele emise o blochează: ele nu se pot desface.
      if (d.stare !== "emis" && d.stare !== "respins") {
        const zonaR = el("div", "g-respinge");
        zonaR.appendChild(el("label", "g-respinge__eticheta",
          "Dacă dosarul nu poate fi soluționat, respinge-l motivat — trece în arhivă:"));
        const motiv = document.createElement("input");
        motiv.type = "text";
        motiv.placeholder = "motivul respingerii";
        motiv.className = "g-respinge__motiv";
        const bR = el("button", "btn btn--small btn--danger", "Respinge dosarul");
        bR.type = "button";
        bR.addEventListener("click", async () => {
          if (!motiv.value.trim()) { motiv.focus(); return; }
          if (!confirm("Respingi definitiv dosarul " + d.serie + "?")) return;
          bR.disabled = true;
          try {
            const rr = await post({ actiune: "dosar-respinge", id, motiv: motiv.value.trim() });
            const dd = await rr.json().catch(() => ({}));
            if (!rr.ok) throw new Error(dd.eroare || "Nu am putut respinge dosarul.");
            deschide(id);
            incarcaDosare();
          } catch (e) { alert(e.message); bR.disabled = false; }
        });
        zonaR.append(motiv, bR);
        detaliu.appendChild(zonaR);
      }

      detaliu.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    const ETICHETA_STARE = {
      depus: "depusă", verificat: "verificată", emis: "certificate emise", respins: "respinsă",
    };
    let filtru = "lucru";

    function incarcaDosare() {
      const cauta = document.getElementById("g-cauta").value.trim();
      lista.textContent = "";
      lista.appendChild(el("li", "g-gol", "Se încarcă…"));
      post({ actiune: "dosare", filtru, cauta })
        .then((res) => res.json())
        .then((d) => {
          document.getElementById("g-nr-lucru").textContent = "(" + (d.inLucru || 0) + ")";
          document.getElementById("g-nr-arhiva").textContent = "(" + (d.arhivate || 0) + ")";
          lista.textContent = "";
          const arr = d.dosare || [];
          if (!arr.length) {
            lista.appendChild(el("li", "g-gol", cauta
              ? "Niciun dosar care să se potrivească."
              : filtru === "arhiva"
                ? "Arhiva e goală: niciun dosar soluționat încă."
                : "Niciun dosar în lucru. Aici apar declarațiile pe măsură ce sosesc."));
            return;
          }
          for (const x of arr) {
            const li = el("li", "g-dosar");
            const b = el("button", "g-dosar__buton" + (x.arhivat ? " is-arhivat" : ""));
            b.type = "button";
            b.appendChild(el("strong", "g-dosar__serie", x.serie));
            b.appendChild(el("span", "g-dosar__det",
              [x.rasa, x.membruNume, "fătare " + dataRo(x.dataFatarii), x.pui + " pui",
               x.numarWDF || null].filter(Boolean).join(" · ")));
            b.appendChild(el("span", "g-dosar__stare", ETICHETA_STARE[x.stare] || x.stare));
            if (x.pesteTermen) b.appendChild(el("span", "g-dosar__termen", "peste termen"));
            b.addEventListener("click", () => deschide(x.id));
            li.appendChild(b);
            lista.appendChild(li);
          }
        })
        .catch(() => {
          lista.textContent = "";
          lista.appendChild(el("li", "g-gol", "Nu am putut încărca lista dosarelor."));
        });
    }

    document.querySelectorAll(".g-filtru").forEach((b) => {
      b.addEventListener("click", () => {
        document.querySelectorAll(".g-filtru").forEach((x) => x.classList.remove("is-activ"));
        b.classList.add("is-activ");
        filtru = b.dataset.f;
        incarcaDosare();
      });
    });
    // Căutarea așteaptă o clipă după ultima tastă: altfel pleacă o cerere la fiecare literă.
    let ceas = null;
    document.getElementById("g-cauta").addEventListener("input", () => {
      clearTimeout(ceas);
      ceas = setTimeout(incarcaDosare, 300);
    });

    incarcaDosare();
  })();
</script>

