---
// /registru/registratura/ascendenta/?id=… — completarea ascendenței și emiterea certificatelor.
//
// Aici se face munca de fond a registraturii: din pedigree-urile celor doi părinți se
// transcriu cele 30 de poziții ale ascendenței, se atribuie numărul de cuib WDF și se
// emit certificatele individuale.
//
// TIPUL NU SE ALEGE. Se vede în timp real, calculat din câte poziții au nume ȘI număr
// de înregistrare: 30 din 30 înseamnă Tip A, niciuna înseamnă Tip C (tipicitate de
// rasă), iar între ele Tip B — ascendență cunoscută parțial. Dacă tipul ar fi o bifă,
// ar deveni o chestiune de indulgență; calculat, e o constatare.
import RegistruLayout from "../../../layouts/RegistruLayout.astro";
---

<RegistruLayout title="Ascendența cuibului" allow={["registratura"]}>
  <p class="p-eyebrow">Registrul genealogic · Registratura</p>
  <h1 class="p-title" id="p-titlu">Ascendența cuibului</h1>
  <p class="p-sub" id="p-sub"></p>
  <p><a class="btn btn--outline btn--small" href="/registru/registratura/">← Toate dosarele</a></p>

  <p class="p-eroare" id="p-eroare" role="alert" hidden></p>

  <div id="p-continut" hidden>
    <!-- ——— Numărul de cuib ——— -->
    <section class="p-sect">
      <h2 class="p-h2">Numărul de cuib WDF</h2>
      <p class="p-nota">
        Se dă o singură dată și nu se mai schimbă: e cheia sub care cuibul intră în baza
        World Dog Federation. Numerotarea continuă de la cuibul 76, ultimul înregistrat pe hârtie.
      </p>
      <p class="p-wdf">
        <strong id="p-wdf">—</strong>
        <button class="btn btn--primary btn--small" type="button" id="p-wdf-buton">Atribuie numărul</button>
      </p>
    </section>

    <!-- ——— Ascendența ——— -->
    <section class="p-sect">
      <h2 class="p-h2">Ascendența pe patru generații</h2>
      <p class="p-nota">
        Părinții sunt completați din declarație. Restul se transcriu din pedigree-urile lor.
        <strong>Numărul de înregistrare</strong> e cel care decide tipul certificatului: o poziție
        fără număr contează ca lipsă, chiar dacă are nume.
      </p>
      <p class="p-unelte">
        <a class="btn btn--outline btn--small" href="https://rou.pedigree-database.org/en/"
           target="_blank" rel="noopener">🌐 Baza de pedigree WDF ↗</a>
        <span>Se deschide într-o filă separată — poți căuta acolo strămoșii, fără să pierzi ce ai completat aici.</span>
      </p>

      <!-- ——— Citirea documentelor ——— -->
      <div class="p-citire" id="p-citire">
        <p class="p-actiuni">
          <button class="btn btn--outline btn--small" type="button" id="p-citeste">
            📄 Citește pedigree-urile părinților
          </button>
          <span class="p-stare" id="p-citire-stare"></span>
        </p>
        <p class="p-nota">
          Citește documentele urcate de crescător și <strong>propune</strong> valorile — nu le scrie.
          Propunerile apar lângă câmpuri; tu hotărăști care intră. Ce nu s-a citit limpede vine
          însemnat, cu motivul. <strong>Nimic nu se salvează</strong> până nu apeși „Salvează ascendența".
        </p>
        <div id="p-citire-rezultat" hidden></div>
      </div>

      <p class="p-tip" id="p-tip">—</p>
      <div id="p-generatii"></div>
      <p class="p-actiuni">
        <button class="btn btn--primary" type="button" id="p-salveaza">Salvează ascendența</button>
        <span class="p-stare" id="p-stare-salvare"></span>
      </p>
    </section>

    <!-- ——— Emiterea ——— -->
    <section class="p-sect">
      <h2 class="p-h2">Certificatele de origine</h2>
      <p class="p-nota">
        Se emite câte un certificat pentru fiecare pui. Ascendența se îngheață în certificat:
        dacă dosarul se corectează mai târziu, actul deja tipărit rămâne ce a fost înmânat omului.
      </p>
      <ul class="p-pui" id="p-pui"></ul>
      <p class="p-actiuni">
        <button class="btn btn--primary" type="button" id="p-emite">Emite certificatele bifate</button>
        <span class="p-stare" id="p-stare-emitere"></span>
      </p>
    </section>
  </div>
</RegistruLayout>

<script is:inline>
  (function () {
    const F = "/.netlify/functions/registru-pedigree";
    const id = new URLSearchParams(location.search).get("id") || "";
    const cod = () => localStorage.getItem("cfcrRegistruCod") || "";
    const dispozitiv = () => localStorage.getItem("cfcrRegistruDispozitiv") || "";
    const eroare = document.getElementById("p-eroare");
    const post = (b) => fetch(F, { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify(Object.assign({ cod: cod(), dispozitiv: dispozitiv() }, b)) });

    // STILURILE SCOPED ȘI ELEMENTELE FĂCUTE DIN JAVASCRIPT.
    //
    // Astro face stilurile din <style> „scoped": fiecare selector devine
    // `.p-poz[data-astro-cid-…]`, iar atributul îl pune el, la compilare, pe elementele
    // DIN ȘABLON. Ce desenează JavaScript-ul nu-l primește niciodată — deci rămâne
    // complet nestilizat, fără ca ceva să se plângă undeva.
    //
    // Aici asta însemna că toate cele 30 de rânduri ale ascendenței — adică fix munca
    // grea a registraturii — se desenau ca o grămadă de câmpuri, fără grilă, fără
    // marcajul verde al pozițiilor complete, fără așezarea pentru telefon.
    //
    // Leacul: luăm numele atributului de pe un element din șablon și îl punem pe tot ce
    // facem noi. Așa stilurile rămân scoped (nu se scurg în alte pagini), dar prind și
    // elementele desenate.
    const CID = (function () {
      const gazda = document.getElementById("p-generatii");
      if (!gazda) return null;
      for (const a of gazda.attributes) if (a.name.indexOf("data-astro-cid-") === 0) return a.name;
      return null;
    })();
    const creeaza = (tag) => {
      const x = document.createElement(tag);
      if (CID) x.setAttribute(CID, "");
      return x;
    };

    // Datele vin din dosarele crescătorilor: doar textContent, niciodată innerHTML.
    const el = (tag, cls, text) => {
      const x = creeaza(tag);
      if (cls) x.className = cls;
      if (text != null) x.textContent = text;
      return x;
    };
    function arataEroare(m) { eroare.hidden = false; eroare.textContent = m; }

    if (!id) { arataEroare("Lipsește dosarul. Intră dintr-un dosar din lista registraturii."); return; }

    let pozitii = [];
    let ascendenta = {};
    let dosar = null;
    let propuneri = {};   // ce a citit mașina; trăiește doar în pagină, până se pune cu mâna

    // Tipul se recalculează la fiecare tastă: registratorul vede pe loc ce iese.
    function recalculeaza() {
      let complete = 0;
      for (const p of pozitii) {
        const a = ascendenta[p.cod];
        if (a && a.nume && a.nr) complete++;
      }
      const t = document.getElementById("p-tip");
      const total = pozitii.length;
      const lipsa = total - complete;
      if (complete === total) {
        t.className = "p-tip is-a";
        t.textContent = "Tip A — toate cele " + total + " de poziții au nume și număr de înregistrare.";
      } else if (complete === 0) {
        // Nicio poziție cunoscută nu înseamnă „aproape Tip B": e certificatul de
        // tipicitate de rasă, alt act, cu alt traseu în spate.
        t.className = "p-tip is-c";
        t.textContent = "Tip C — ascendența nu este cunoscută deloc. " +
          "Acesta este certificatul de tipicitate de rasă.";
      } else {
        t.className = "p-tip is-b";
        t.textContent = "Tip B — ascendență cunoscută parțial: " + complete + " din " + total +
          " de poziții complete. " + (lipsa === 1 ? "Lipsește una." : "Lipsesc " + lipsa + ".");
      }
    }

    function campuriPozitie(p) {
      const box = el("div", "p-poz");
      box.appendChild(el("span", "p-poz__cod", p.cod));
      box.appendChild(el("span", "p-poz__eticheta", p.eticheta));
      const a = ascendenta[p.cod] || {};
      const camp = (nume, valoare, marcaj) => {
        const i = creeaza("input");
        i.type = "text";
        i.value = valoare || "";
        i.placeholder = marcaj;
        i.className = "p-poz__" + nume;
        i.addEventListener("input", () => {
          ascendenta[p.cod] = Object.assign({}, ascendenta[p.cod], { [nume]: i.value.trim() });
          box.classList.toggle("is-complet",
            !!(ascendenta[p.cod].nume && ascendenta[p.cod].nr));
          recalculeaza();
        });
        return i;
      };
      box.appendChild(camp("nume", a.nume, "numele câinelui"));
      box.appendChild(camp("nr", a.nr, "nr. înregistrare"));
      box.appendChild(camp("titluri", a.titluri, "titluri (opțional)"));
      if (a.nume && a.nr) box.classList.add("is-complet");

      const pr = propuneri[p.cod];
      if (pr) box.appendChild(randPropunere(p, pr, a));
      return box;
    }

    /**
     * Rândul de propunere de sub o poziție. Se vede ce scrie pe document, se vede de pe
     * care document, și — dacă citirea n-a fost sigură — se vede de ce.
     *
     * Butonul „pune" scrie în câmpuri, nu în registru: salvarea rămâne apăsarea de jos.
     * O propunere nu se aplică niciodată singură, nici măcar când câmpul e gol; altfel
     * n-ar mai fi propunere.
     */
    function randPropunere(p, pr, acum) {
      const rand = el("div", "p-prop");
      const laFel = (x, y) => String(x || "").toUpperCase().replace(/[^\p{L}\p{N}]/gu, "")
        === String(y || "").toUpperCase().replace(/[^\p{L}\p{N}]/gu, "");
      const identic = laFel(acum.nume, pr.nume) && laFel(acum.nr, pr.nr);

      if (identic) {
        rand.classList.add("is-identic");
        rand.appendChild(el("span", "p-prop__semn", "✓"));
        rand.appendChild(el("span", "p-prop__text", "la fel ca pe certificatul " + (pr.din || "").toLowerCase()));
        return rand;
      }

      if (!pr.sigur) rand.classList.add("is-nesigur");
      rand.appendChild(el("span", "p-prop__semn", pr.sigur ? "📄" : "⚠"));
      const text = el("span", "p-prop__text",
        "pe document: " + (pr.nume || "—") + (pr.nr ? " · " + pr.nr : " · fără număr"));
      rand.appendChild(text);

      const pune = el("button", "btn btn--outline btn--small", "pune");
      pune.type = "button";
      pune.addEventListener("click", () => {
        ascendenta[p.cod] = Object.assign({}, ascendenta[p.cod], {
          nume: pr.nume || "", nr: pr.nr || "", titluri: pr.titluri || ascendenta[p.cod]?.titluri || "",
        });
        deseneazaGeneratii();
        recalculeaza();
        stareSalvare("propuneri puse în câmpuri — încă nesalvate");
      });
      rand.appendChild(pune);

      if (!pr.sigur && pr.nelamurire) {
        rand.appendChild(el("span", "p-prop__nelamurire", pr.nelamurire));
      }
      return rand;
    }

    function stareSalvare(m) { document.getElementById("p-stare-salvare").textContent = m; }

    function deseneazaGeneratii() {
      const zona = document.getElementById("p-generatii");
      zona.textContent = "";
      const NUME = { 1: "Părinți", 2: "Bunici", 3: "Străbunici", 4: "Stră-străbunici" };
      for (let gen = 1; gen <= 4; gen++) {
        const set = pozitii.filter((p) => p.generatie === gen);
        const sect = el("div", "p-gen");
        sect.appendChild(el("h3", "p-gen__titlu", NUME[gen] + " (" + set.length + ")"));
        const grid = el("div", "p-gen__grid");
        for (const p of set) grid.appendChild(campuriPozitie(p));
        sect.appendChild(grid);
        zona.appendChild(sect);
      }
    }

    function deseneazaPui(certificate) {
      const ul = document.getElementById("p-pui");
      ul.textContent = "";
      dosar.pui.forEach((pu, i) => {
        const li = el("li", "p-pui__rand");
        const emis = certificate && certificate[i];
        if (emis) {
          li.appendChild(el("strong", null, (pu.sex === "M" ? "♂ " : "♀ ") + pu.nume));
          li.appendChild(el("span", "p-pui__serie", emis.serie + " · Tip " + emis.tip));
          const a = creeaza("a");
          a.className = "btn btn--outline btn--small";
          a.href = "/registru/pedigree/?s=" + encodeURIComponent(emis.serie);
          a.target = "_blank"; a.rel = "noopener";
          a.textContent = "Deschide certificatul ↗";
          li.appendChild(a);

          // Numărul WDF individual NU se generează: îl atribuie World Dog Federation la
          // înregistrarea cuibului în baza internațională. Se trece aici când sosește.
          const camp = creeaza("input");
          camp.type = "text";
          camp.className = "p-pui__wdf";
          camp.placeholder = "nr. WDF (ex. WDF.RO150640L26)";
          camp.value = emis.numarWDFCaine || "";
          const salv = creeaza("button");
          salv.type = "button";
          salv.className = "btn btn--outline btn--small";
          salv.textContent = "Salvează nr. WDF";
          salv.addEventListener("click", async () => {
            salv.disabled = true;
            try {
              const r = await post({ actiune: "wdf-caine", serie: emis.serie,
                numarWDFCaine: camp.value.trim() });
              const dd = await r.json().catch(() => ({}));
              if (!r.ok) throw new Error(dd.eroare || "Nu am putut salva numărul.");
              salv.textContent = "✓ salvat";
            } catch (e) { alert(e.message); salv.textContent = "Salvează nr. WDF"; }
            salv.disabled = false;
          });
          li.append(camp, salv);
        } else {
          const lab = creeaza("label");
          lab.className = "p-pui__alege";
          const bifa = creeaza("input");
          bifa.type = "checkbox"; bifa.checked = true; bifa.dataset.index = String(i);
          lab.appendChild(bifa);
          lab.appendChild(el("span", null, (pu.sex === "M" ? "♂ " : "♀ ") + pu.nume +
            (pu.identificare ? " · " + pu.identificare : " · fără microcip")));
          li.appendChild(lab);
          if (pu.cumparator && pu.cumparator.nume)
            li.appendChild(el("span", "p-pui__prop", "→ " + pu.cumparator.nume));
        }
        ul.appendChild(li);
      });
    }

    async function incarca() {
      const r = await post({ actiune: "ascendenta", id });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { arataEroare(d.eroare || "Nu am putut încărca dosarul."); return; }
      dosar = d.dosar;
      ascendenta = d.ascendenta || {};
      pozitii = d.pozitii || [];
      document.getElementById("p-titlu").textContent = dosar.serie + " — " + dosar.rasa;
      document.getElementById("p-sub").textContent =
        [dosar.membruNume, dosar.afix ? "afix " + dosar.afix : null,
         "fătare " + dosar.dataFatarii, dosar.pui.length + " pui",
         dosar.confirmare === "asteptare" ? "⏳ monta neconfirmată încă" : "monta confirmată"]
        .filter(Boolean).join(" · ");
      document.getElementById("p-wdf").textContent = dosar.numarWDF || "neatribuit";
      document.getElementById("p-wdf-buton").hidden = !!dosar.numarWDF;
      deseneazaGeneratii();
      recalculeaza();
      const rc = await post({ actiune: "certificate-cuib", id });
      const dc = await rc.json().catch(() => ({}));
      const dupaIndex = {};
      for (const c of (dc.certificate || [])) dupaIndex[c.index] = c;
      deseneazaPui(dupaIndex);
      document.getElementById("p-continut").hidden = false;
    }

    document.getElementById("p-wdf-buton").addEventListener("click", async (e) => {
      const b = e.target;
      b.disabled = true;
      try {
        const r = await post({ actiune: "numar-wdf", id });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.eroare || "Nu am putut atribui numărul.");
        document.getElementById("p-wdf").textContent = d.numarWDF;
        b.hidden = true;
      } catch (err) { b.disabled = false; alert(err.message); }
    });

    // ——— Citirea documentelor din dosar ———
    //
    // Se apasă. Nu pornește singură la încărcarea paginii și nu se cheamă de nicăieri
    // altundeva: fiecare citire e o hotărâre a registratorului, pe un dosar anume, și
    // costă bani adevărați.
    document.getElementById("p-citeste").addEventListener("click", async (e) => {
      const b = e.currentTarget;
      const stare = document.getElementById("p-citire-stare");
      const zona = document.getElementById("p-citire-rezultat");
      b.disabled = true;
      stare.textContent = "se citește… (durează un minut, sunt două documente)";
      try {
        const r = await fetch("/.netlify/functions/registratura-citeste", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ cod: cod(), dispozitiv: dispozitiv(), id }),
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.eroare || "Citirea nu a mers.");
        propuneri = d.propuneri || {};
        stare.textContent = d.mesaj || "";
        deseneazaCitire(d, zona);
        deseneazaGeneratii();       // propunerile apar lângă câmpuri
        recalculeaza();
      } catch (err) {
        stare.textContent = err.message;
      }
      b.disabled = false;
    });

    function deseneazaCitire(d, zona) {
      zona.textContent = "";
      zona.hidden = false;

      // Ce s-a citit din fiecare document, inclusiv ce NU s-a putut citi. O piesă lipsă
      // spusă pe față e altceva decât o poziție goală: una e „nu am de unde", cealaltă
      // ar putea fi luată drept „nu există strămoș".
      const ul = el("ul", "p-cit__lista");
      for (const c of d.citite || []) {
        const li = el("li", null);
        li.appendChild(el("strong", null, c.cine + ": "));
        li.appendChild(el("span", null, c.stare === "citit"
          ? c.pozitii + " poziții" + (c.nesigure ? ", " + c.nesigure + " nesigure" : "")
          : c.stare));
        if (c.stare !== "citit") li.className = "is-lipsa";
        ul.appendChild(li);
      }
      zona.appendChild(ul);

      // Nepotrivirile dintre declarația crescătorului și actul de origine. Nu se
      // corectează nimic automat; se arată, ca să se uite omul.
      if ((d.nepotriviri || []).length) {
        const box = el("div", "p-cit__nepotriviri");
        box.appendChild(el("h4", null, "Declarația crescătorului nu se potrivește cu documentul:"));
        const l = el("ul", null);
        for (const n of d.nepotriviri) {
          const li = el("li", null);
          li.appendChild(el("strong", null, n.camp + ": "));
          li.appendChild(el("span", null, "a scris «" + n.declaratie + "», pe act scrie «" + n.document + "»"));
          if (n.nota) li.appendChild(el("span", "p-cit__nota", n.nota));
          l.appendChild(li);
        }
        box.appendChild(l);
        zona.appendChild(box);
      }

      // Punerea în bloc: DOAR propunerile sigure și DOAR în câmpurile goale. Nu
      // suprascrie niciodată ce a scris omul — o valoare tastată e o hotărâre, iar
      // hotărârile nu se schimbă dintr-un buton care zice „pune tot".
      const goaleSigure = pozitii.filter((p) => {
        const pr = propuneri[p.cod], a = ascendenta[p.cod] || {};
        return pr && pr.sigur && !(a.nume || "").trim();
      });
      const act = el("p", "p-actiuni");
      if (goaleSigure.length) {
        const bt = el("button", "btn btn--primary btn--small",
          "Pune cele " + goaleSigure.length + " propuneri sigure în pozițiile goale");
        bt.type = "button";
        bt.addEventListener("click", () => {
          for (const p of goaleSigure) {
            const pr = propuneri[p.cod];
            ascendenta[p.cod] = { nume: pr.nume || "", nr: pr.nr || "", titluri: pr.titluri || "" };
          }
          deseneazaGeneratii();
          recalculeaza();
          stareSalvare(goaleSigure.length + " poziții puse în câmpuri — încă NESALVATE");
          bt.disabled = true;
        });
        act.appendChild(bt);
      }
      act.appendChild(el("span", "p-stare",
        "Cele nesigure nu intră aici: se pun una câte una, după ce citești motivul."));
      zona.appendChild(act);

      const jos = el("p", "p-cit__subsol",
        "Citit cu " + (d.cunoscute || 0) + " poziții propuse din " + (d.din || 30) +
        (d.cost ? " · " + d.cost.explicatie : "") +
        " · nimic nu s-a scris în registru.");
      zona.appendChild(jos);
    }

    document.getElementById("p-salveaza").addEventListener("click", async (e) => {
      const b = e.target;
      const stare = document.getElementById("p-stare-salvare");
      b.disabled = true; stare.textContent = "se salvează…";
      try {
        const r = await post({ actiune: "ascendenta-salveaza", id, ascendenta });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.eroare || "Salvarea a eșuat.");
        stare.textContent = "✓ salvat — " + d.completate + " poziții, tip " + d.tip;
      } catch (err) { stare.textContent = err.message; }
      b.disabled = false;
    });

    document.getElementById("p-emite").addEventListener("click", async (e) => {
      const b = e.target;
      const stare = document.getElementById("p-stare-emitere");
      const alesi = [...document.querySelectorAll("#p-pui input[type=checkbox]:checked")]
        .map((x) => ({ index: Number(x.dataset.index) }));
      if (!alesi.length) { stare.textContent = "Bifează cel puțin un pui."; return; }
      if (!confirm("Emiți " + alesi.length + " certificate? Seriile alocate nu se mai pot retrage.")) return;
      b.disabled = true; stare.textContent = "se emit…";
      try {
        const r = await post({ actiune: "emite", id, pui: alesi });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.eroare || "Emiterea a eșuat.");
        stare.textContent = "✓ " + d.emise.length + " certificate de tip " + d.tip;
        await incarca();
      } catch (err) { stare.textContent = err.message; }
      b.disabled = false;
    });

    incarca();
  })();
</script>

