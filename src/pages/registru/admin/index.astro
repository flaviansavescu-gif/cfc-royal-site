    // —— Starea sistemului ——
    // Raportul e lăsat de funcția programată; panoul doar îl arată. Dacă lipsește,
    // spunem asta limpede: „nicio verificare încă" nu înseamnă „totul e bine".
    function momentScurt(s) {
      const d = new Date(s);
      return isNaN(d) ? String(s || "—") : d.toLocaleString("ro-RO", {
        day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit",
      });
    }

    async function incarcaMonitor() {
