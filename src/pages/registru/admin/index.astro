---
// /registru/admin/ — accesul la Registrul genealogic: membrii care depun declarații
// și persoanele din Registratură care le verifică.
//
// Dreptul de a solicita Certificate Pedigree ține de calitatea de MEMBRU cu cotizația
// la zi, nu de existența unei canise. Afixul e opțional: cine îl are îl vede pe Certificat,
// cine nu, crește totuși un cuib și are dreptul la documente de origine.
//
// Afixele caniselor înregistrate se citesc din colecția de conținut, la build — ca să fie
// alese dintr-o listă, nu retastate (afixul ajunge pe Certificatul Pedigree).
import RegistruLayout from "../../../layouts/RegistruLayout.astro";
import { getCollection } from "astro:content";

const caniseSite = (await getCollection("canise", (c) => c.id.startsWith("ro/") && !c.data.draft))
  .map((c) => ({
    afix: c.data.affix,
    proprietar: c.data.owner,
    nrAfix: c.data.registrationNumber ?? "",
  }))
  .sort((a, b) => a.afix.localeCompare(b.afix, "ro"));
---

<RegistruLayout title="Acces — administrare" allow={["admin"]}>
  <p class="a-eyebrow">Administrare · Registrul genealogic</p>
  <h1 class="a-title">Accesul la registru</h1>
  <p class="a-sub">
    Codurile se generează aici și se transmit personal. Codul de membru dă dreptul de a depune
    Declarații de Montă și Fătare și de a solicita Certificate Pedigree — <strong>cât timp cotizația
    este la zi</strong>. Codul de registratură dă dreptul de a verifica dosarele și de a pregăti emiterea.
  </p>

  <p class="a-punte">
    <a class="btn btn--outline" href="/cursuri/admin/">← Panoul Școlii de Arbitraj</a>
    <span>Registrele sunt separate: aici sunt membrii și registratura, acolo candidații, lectorii și arbitrii.</span>
  </p>

  <p class="a-punte">
    <a class="btn btn--outline" href="/registru/admin/stare/">Starea ecosistemului →</a>
    <a class="btn btn--outline" href="/registru/admin/paznic/">Paznicul de intruziune →</a>
    <span>Cine a bătut la uși și cum. Nu e un ecran de urmărit zilnic — raportul de luni spune tot ce e de spus.</span>
  </p>

  {/* ——— Ce se vede întotdeauna ———
       Secțiunile se deschid la cerere, iar conținutul lor se încarcă abia atunci —
       altfel pagina ar cere tot registrul la fiecare deschidere, degeaba. */}
  <p class="a-note">
    <strong>Solicitările de acces</strong> și <strong>generarea codurilor de membru</strong> se
    lucrează în <a href="/registru/registratura/">spațiul Registraturii</a>: acolo sunt datele pe
    care se sprijină — cine e membru și cine are cotizația la zi. Aici rămâne ce ține de
    autoritatea administratorului: cine e registrator, revocarea accesului, anularea actelor,
    jurnalul și arhiva.
  </p>

  <p class="a-indrumar">Se deschid la nevoie:</p>

  {/* Extrasele oficiale — ca extrasul de cont de la bancă: întregul registru sau doar
      pozițiile dintre două numere. Formulare GET simple: pagina de extras face cererea,
      iar serverul verifică dreptul (administrator sau registratorul desemnat). */}
  <details class="a-sectiune" data-sectiune="extrase">
    <summary class="a-sumar">
      <span class="a-sumar__titlu">Extrase oficiale din registre</span>
    </summary>
    <p class="a-note">Extrasul se deschide gata de tipărit — din fereastra de tipărire alegi
    „Salvează ca PDF". Lasă câmpurile goale pentru întregul registru, sau scrie numerele
    între care vrei extrasul, ca la extrasul de cont.</p>
    <form class="x-extras" method="get" action="/registru/registratura/extras/" target="_blank">
      <input type="hidden" name="r" value="cuiburi" />
      <strong class="x-extras__titlu">Cartea de Origine</strong>
      <label class="x-camp">de la cuibul nr. <input name="de" type="number" min="1" placeholder="început" /></label>
      <label class="x-camp">până la nr. <input name="la" type="number" min="1" placeholder="sfârșit" /></label>
      <button class="btn btn--outline" type="submit">Generează extrasul →</button>
    </form>
    <form class="x-extras" method="get" action="/registru/registratura/extras/" target="_blank">
      <input type="hidden" name="r" value="afixe" />
      <strong class="x-extras__titlu">Registrul afixelor</strong>
      <label class="x-camp">de la nr. afix <input name="de" type="number" min="1" placeholder="început" /></label>
      <label class="x-camp">până la nr. <input name="la" type="number" min="1" placeholder="sfârșit" /></label>
      <button class="btn btn--outline" type="submit">Generează extrasul →</button>
    </form>
  </details>

  <details class="a-sectiune" data-sectiune="membri">
  <summary class="a-sumar">
    <span class="a-sumar__titlu">Membri cu drept de solicitare</span>
    <span class="a-numar" id="a-membri-numar" hidden></span>
  </summary>
  <p class="a-note">
    Lista membrilor cu drept de a depune declarații, cu starea cotizației. Codurile noi și
    reînnoirea cotizației se fac în <a href="/registru/registratura/">spațiul Registraturii</a>.
    Aici rămâne <strong>revocarea</strong>: accesul se dă acolo, se ia de aici.
  </p>
  <ul class="a-lista" id="a-membri"><li class="a-gol">Se încarcă…</li></ul>
  </details>

  <details class="a-sectiune" data-sectiune="registratori">
  <summary class="a-sumar">
    <span class="a-sumar__titlu">Registratura</span>
    <span class="a-numar" id="a-registratori-numar" hidden></span>
  </summary>
  <p class="a-note">
    Persoanele care verifică dosarele (DMF, pedigree-urile părinților, dovada dreptului de montă
    al femelei, dovada plății), extrag ascendența și atribuie numărul de cuib WDF.
    <strong>E-mailul e obligatoriu</strong>: acolo pleacă codul de confirmare cerut la fiecare
    intrare de pe un dispozitiv nou. Cine e trecut aici fără adresă intră doar cu codul —
    apare marcat în listă și se poate îndrepta pe loc, fără să-i schimbi codul.
  </p>
  <form class="a-form a-form--mic" id="a-reg-form">
    <input id="a-reg-nume" type="text" placeholder="Numele persoanei" required />
    <input id="a-reg-email" type="email" placeholder="E-mail (obligatoriu — acolo pleacă codul de confirmare)" required />
    <button class="btn btn--primary" type="submit">Generează cod de registratură</button>
  </form>
  <p class="a-cod-nou" id="a-reg-cod" hidden></p>
  <ul class="a-lista" id="a-registratori"><li class="a-gol">Se încarcă…</li></ul>
  </details>

  <details class="a-sectiune" data-sectiune="chinotehnisti">
  <summary class="a-sumar">
    <span class="a-sumar__titlu">Chinotehniștii asociațiilor afiliate</span>
    <span class="a-numar" id="a-cht-numar" hidden></span>
  </summary>
  <p class="a-note">
    Persoanele din asociațiile afiliate (Membri Colectivi) care depun Declarațiile de Montă
    și Fătare pentru crescătorii lor, din spațiul <strong>/registru/afiliate/</strong>.
    Codul e <strong>nominal</strong>: dacă omul pleacă, i se revocă lui codul, fără să se
    blocheze asociația. Doi chinotehniști ai aceleiași asociații își văd unul altuia
    dosarele — spațiul e al asociației. Pe e-mail pleacă numărul de înregistrare al
    fiecărei declarații depuse.
  </p>
  <form class="a-form a-form--mic" id="a-cht-form">
    <input id="a-cht-nume" type="text" placeholder="Numele chinotehnistului" required />
    <input id="a-cht-asociatie" type="text" placeholder="Asociația afiliată (numele complet)" required />
    <input id="a-cht-email" type="email" placeholder="E-mail (obligatoriu)" required />
    <button class="btn btn--primary" type="submit">Generează cod de chinotehnist</button>
  </form>
  <p class="a-cod-nou" id="a-cht-cod" hidden></p>
  <ul class="a-lista" id="a-chinotehnisti"><li class="a-gol">Se încarcă…</li></ul>
  </details>

  <details class="a-sectiune" data-sectiune="declaratii">
  <summary class="a-sumar">
    <span class="a-sumar__titlu">Declarațiile depuse</span>
    <span class="a-numar" id="a-declaratii-numar" hidden></span>
  </summary>
  <p class="a-note">
    Ștergerea scoate definitiv dosarul și cele patru piese încărcate. Numărul de înregistrare
    se eliberează <strong>numai dacă e ultimul dat în anul curent</strong> — altfel rămâne consumat,
    fiindcă un număr dat a doua oară altcuiva ar însemna două acte cu aceeași referință.
  </p>
  <ul class="a-lista" id="a-declaratii"><li class="a-gol">Se încarcă…</li></ul>
  </details>

  {/* Starea sistemului se încarcă ÎNTOTDEAUNA, chiar închisă: verdictul stă în titlu.
      O secțiune de sănătate pe care trebuie s-o deschizi ca să afli că e o problemă nu
      e o secțiune de sănătate. */}
  <details class="a-sectiune" data-sectiune="monitor">
  <summary class="a-sumar">
    <span class="a-sumar__titlu">Starea sistemului</span>
    <span class="a-numar a-numar--stare" id="a-monitor-numar" hidden></span>
  </summary>
  <p class="a-note">
    Fluxul critic se verifică singur la fiecare 15 minute: verificarea certificatelor,
    fișa publică a câinelui, poarta declarațiilor, pagina de verificare și prospețimea
    copiei de siguranță. La o cădere pleacă un e-mail — <strong>unul singur</strong>, plus
    o reamintire la fiecare 6 ore cât ține problema, și unul la revenire.
  </p>
  <div class="a-monitor" id="a-monitor">Se încarcă…</div>
  </details>

  <details class="a-sectiune" data-sectiune="anulare">
  <summary class="a-sumar">
    <span class="a-sumar__titlu">Anularea unui certificat</span>
  </summary>
  <p class="a-note">
    Declararea de date false atrage anularea documentelor eliberate. Certificatul <strong>nu se șterge și nu se rescrie</strong> — actul există, e tipărit și e în mâna
    cuiva. Se marchează anulat, cu motiv și autor, iar fișa publică și verificarea prin cod
    QR arată asta pe loc: cine scanează hârtia trebuie să afle adevărul, nu să nu găsească
    nimic. Motivul rămâne în registru, dar <strong>nu se publică</strong>.
  </p>
  <form class="a-form" id="a-anul-form">
    <input id="a-anul-serie" type="text" placeholder="Seria certificatului (ex. CFCR-P-2026-0001)"
           autocomplete="off" spellcheck="false" required />
    <button class="btn btn--outline" type="submit">Caută certificatul</button>
  </form>
  <div class="a-cert" id="a-anul-cert" hidden></div>
  </details>

  <details class="a-sectiune" data-sectiune="jurnal">
  <summary class="a-sumar">
    <span class="a-sumar__titlu">Jurnalul registrului</span>
  </summary>
  <p class="a-note">
    Cine, ce și când. Se scrie automat la fiecare faptă care schimbă starea registrului:
    depunere, respingere, confirmare, emitere de certificat, modificare de ascendență,
    generare sau revocare de acces, descărcarea arhivei. <strong>Ștergerile nu se pot face
    fără să lase urmă</strong> — dacă intrarea nu poate fi scrisă, ștergerea nu se execută.
    Codurile de acces nu apar niciodată aici.
  </p>
  <div class="a-filtre">
    <select id="a-j-luna" aria-label="Luna"></select>
    <select id="a-j-fapta" aria-label="Fapta"><option value="">Toate faptele</option></select>
    <input id="a-j-cauta" type="search" placeholder="Caută după nume, serie sau detaliu" />
    <button class="btn btn--outline btn--small" type="button" id="a-j-reincarca">Reîmprospătează</button>
  </div>
  <ul class="a-jurnal" id="a-jurnal"><li class="a-gol">Se încarcă…</li></ul>
  </details>

  <details class="a-sectiune" data-sectiune="intretinere">
  <summary class="a-sumar">
    <span class="a-sumar__titlu">Copie de siguranță și curățenie</span>
  </summary>
  <p class="a-note">
    Registrul trăiește într-un singur loc. Butonul descarcă <strong>tot</strong> —
    declarații, certificate, scanurile încărcate — într-o arhivă ZIP obișnuită, care se
    deschide cu orice program, fără parolă și fără acest site. Ține una pe un disc al tău.
    În plus, duminică noaptea pleacă automat o copie criptată pe ramura privată <code>backup-registru</code>.
  </p>
  <p class="a-copie">
    <button class="btn btn--primary" type="button" id="a-export">⬇ Descarcă registrul</button>
    <span class="a-stare" id="a-export-stare"></span>
  </p>

  <p class="a-note">
    <strong>Curățenia</strong> scoate din magazie două feluri de rămășițe: codurile de acces
    rămase în fișele scrise înainte de regula actuală (azi nu se mai păstrează niciunul) și <strong>ciornele abandonate</strong> — formulare DMF începute, cu fișiere încărcate,
    pe care nimeni nu le-a dus până la capăt de peste o săptămână. Cele mai recente NU se
    ating: cineva poate chiar acum completează formularul. Aceeași curățenie se face și
    singură, duminică noaptea, odată cu copia de siguranță.
  </p>
  <p class="a-copie">
    <button class="btn btn--outline" type="button" id="a-curatenie">🧹 Curăță magazia</button>
    <span class="a-stare" id="a-curatenie-stare"></span>
  </p>
  </details>
</RegistruLayout>

<script is:inline>
  (function () {
    // A doua cheie. Însoțește FIECARE cerere privilegiată: o apărare pusă doar la pagina
    // de intrare ar fi teatru, fiindcă cine are codul cheamă funcțiile direct.
    const dispozitivAdmin = () => localStorage.getItem("cfcrRegistruDispozitiv") || "";

    /** Numărul de lângă titlul unei secțiuni închise — cât e înăuntru, fără s-o deschizi. */
    function numarSectiune(id, n, singular, plural) {
      const e = document.getElementById(id);
      if (!e) return;
      e.hidden = !n;
      e.textContent = n ? n + " " + (n === 1 ? singular : plural) : "";
    }

    function codAdmin() {
      let c = null;
      try { c = localStorage.getItem("cfcrRegistruCod"); } catch (e) {}
      return c || prompt("Confirmă codul de administrator:");
    }
    async function cere(payload) {
      const res = await fetch("/.netlify/functions/registru-acces", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cod: codAdmin(), dispozitiv: dispozitivAdmin(), ...payload }),
      });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.eroare || "Eroare de server.");
      return d;
    }
    const dataRo = (s) => { const d = new Date(s); return isNaN(d) ? String(s || "") : d.toLocaleDateString("ro-RO"); };

    // Codul se arată o singură dată: în registru rămâne doar amprenta lui.
    function arataCod(el, eticheta, cod) {
      el.hidden = false;
      el.textContent = "";
      el.appendChild(document.createTextNode("✓ " + eticheta + " — cod: "));
      const tare = document.createElement("strong");
      tare.textContent = cod;
      el.appendChild(tare);
      const b = document.createElement("button");
      b.type = "button"; b.className = "a-copiaza"; b.textContent = "copiază";
      b.addEventListener("click", () => {
        navigator.clipboard?.writeText(cod).then(() => { b.textContent = "copiat ✓"; });
      });
      el.appendChild(b);

      // Trimiterea pe e-mail e o ALEGERE, nu ceva ce se face singur: un cod ajuns în
      // cutia poștală rămâne acolo, în clar. Butonul e pentru când e mai comod așa.
      // Serverul îl trimite doar la adresa din fișă — nu la una scrisă aici.
      const t = document.createElement("button");
      t.type = "button"; t.className = "a-copiaza"; t.textContent = "✉ trimite pe e-mail";
      t.addEventListener("click", async () => {
        if (!confirm("Trimiți codul pe e-mailul din fișa lui „" + eticheta + "”?\n\n" +
                     "Codul va rămâne în cutia lui poștală. Dacă preferi, dictează-l.")) return;
        t.disabled = true; t.textContent = "se trimite…";
        try {
          const d = await cere({ actiune: "trimite-cod", codNou: cod });
          t.textContent = "trimis ✓ la " + (d.catre || "adresa din fișă");
        } catch (err) {
          t.disabled = false; t.textContent = "✉ trimite pe e-mail";
          alert("Nu am putut trimite: " + err.message);
        }
      });
      el.appendChild(t);

      el.appendChild(document.createTextNode(" — notează-l acum, nu mai poate fi recuperat."));
    }

    async function incarcaMembri() {
      const ul = document.getElementById("a-membri");
      ul.innerHTML = "";
      try {
        const d = await cere({ actiune: "membri" });
        numarSectiune("a-membri-numar", d.membri.length, "membru", "membri");
        if (!d.membri.length) { ul.innerHTML = "<li class='a-gol'>Niciun membru cu drept de solicitare încă.</li>"; return; }
        d.membri.forEach((m) => {
          const li = document.createElement("li");
          const info = document.createElement("div");
          const tare = document.createElement("strong");
          tare.textContent = m.nume + (m.afix ? " · " + m.afix : "");
          info.appendChild(tare);

          const meta = document.createElement("span");
          meta.className = "a-meta";
          meta.textContent = [m.email, m.nrAfix,
            m.ultima_logare ? "ultima intrare " + dataRo(m.ultima_logare) : "nu a intrat încă"]
            .filter(Boolean).join(" · ");
          info.appendChild(meta);

          const cot = document.createElement("span");
          cot.className = "a-cotizatie " + (m.cotizatieLaZi ? "is-ok" : "is-expirat");
          cot.textContent = m.cotizatieLaZi
            ? "cotizație la zi — până la " + dataRo(m.cotizatiePana)
            : "⚠ cotizație expirată la " + dataRo(m.cotizatiePana) + " — nu poate depune";
          info.appendChild(cot);
          li.appendChild(info);

          // Reînnoirea cotizației se face în spațiul Registraturii, unde se ține
          // evidența plăților. Aici rămâne revocarea: accesul se dă acolo, se ia de aici.
          const actiuni = document.createElement("div");
          actiuni.className = "a-actiuni";
          const del = document.createElement("button");
          del.className = "btn btn--small btn--danger";
          del.textContent = "Revocă";
          del.addEventListener("click", async () => {
            if (!confirm("Revoci accesul lui „" + m.nume + "”? Codul nu va mai funcționa.")) return;
            del.disabled = true;
            try { await cere({ actiune: "membru-sterge", id: m.id }); incarcaMembri(); }
            catch (e) { alert("Nu am putut revoca: " + e.message); del.disabled = false; }
          });
          actiuni.appendChild(del);
          li.appendChild(actiuni);
          ul.appendChild(li);
        });
      } catch (e) { ul.innerHTML = "<li class='a-gol'>Nu am putut încărca lista.</li>"; }
    }

    // —— Descărcarea registrului ——
    // Arhiva vine ca fișier binar, nu ca JSON, deci n-o putem trece prin `cere()`.
    document.getElementById("a-export").addEventListener("click", async (e) => {
      const b = e.target;
      const stare = document.getElementById("a-export-stare");
      b.disabled = true; b.textContent = "Se pregătește…";
      stare.className = "a-stare";
      stare.textContent = "Poate dura câteva zeci de secunde, dacă sunt multe scanuri.";
      try {
        const res = await fetch("/.netlify/functions/registru-export", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ cod: codAdmin(), dispozitiv: dispozitivAdmin() }),
        });
        if (!res.ok) {
          const d = await res.json().catch(() => ({}));
          throw new Error(d.eroare || "Exportul a eșuat.");
        }
        const inreg = res.headers.get("X-Registru-Inregistrari") || "?";
        const fis = res.headers.get("X-Registru-Fisiere") || "?";
        const omise = Number(res.headers.get("X-Registru-Omise") || 0);

        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "registru-cfcr-" + new Date().toISOString().slice(0, 10) + ".zip";
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 30000);

        stare.className = "a-stare " + (omise ? "is-atentie" : "is-bun");
        stare.textContent = "✓ " + inreg + " înregistrări, " + fis + " fișiere, " +
          (blob.size / 1048576).toFixed(1) + " MB" +
          (omise ? " — ATENȚIE: " + omise + " fișiere n-au încăput; vezi CUPRINS.md din arhivă." : ".");
      } catch (err) {
        stare.className = "a-stare is-rau";
        stare.textContent = err.message;
      }
      b.disabled = false; b.textContent = "⬇ Descarcă registrul";
    });

    // —— Curățenia magaziei ——
    document.getElementById("a-curatenie").addEventListener("click", async (e) => {
      const b = e.target;
      const stare = document.getElementById("a-curatenie-stare");
      if (!confirm("Șterg codurile rămase în fișe și ciornele abandonate de peste o săptămână?\n" +
                   "Declarațiile depuse și certificatele NU sunt atinse.")) return;
      b.disabled = true; b.textContent = "Se curăță…";
      stare.className = "a-stare";
      stare.textContent = "";
      try {
        const d = await cere({ actiune: "curatenie" });
        const parti = [];
        if (d.coduriSterse) parti.push(d.coduriSterse + " coduri scoase din fișe");
        if (d.ciorneSterse) parti.push(d.ciorneSterse + " ciorne abandonate");
        if (d.fisiereSterse) parti.push(d.fisiereSterse + " fișiere agățate de ele");

        // Ce s-a găsit dar e prea recent se spune apăsat: „n-am găsit nimic" și
        // „am găsit, dar nu am voie încă" sunt lucruri diferite.
        const recente = d.ciornePreaRecente || [];
        let text = parti.length ? "✓ Șters: " + parti.join(", ") + "." : "✓ Nu era nimic de șters.";
        if (recente.length) {
          const cea = recente.slice().sort((a, b) => a.de.localeCompare(b.de))[0];
          const dataRo2 = new Date(cea.de).toLocaleDateString("ro-RO",
            { day: "numeric", month: "long" });
          text += " " + (recente.length === 1
            ? "O ciornă e prea recentă (" + (cea.zile === 0 ? "de azi" : cea.zile + " zile") +
              ") — se poate șterge de pe " + dataRo2 + "."
            : recente.length + " ciorne sunt prea recente — prima se poate șterge de pe " + dataRo2 + ".");
        }
        stare.className = "a-stare " + (d.erori && d.erori.length ? "is-atentie"
          : (recente.length ? "is-atentie" : "is-bun"));
        stare.textContent = text;
      } catch (err) {
        stare.className = "a-stare is-rau";
        stare.textContent = err.message;
      }
      b.disabled = false; b.textContent = "🧹 Curăță magazia";
    });

    async function incarcaRegistratori() {
      const ul = document.getElementById("a-registratori");
      ul.innerHTML = "";
      try {
        const d = await cere({ actiune: "registratori" });
        numarSectiune("a-registratori-numar", d.registratori.length, "persoană", "persoane");
        if (!d.registratori.length) { ul.innerHTML = "<li class='a-gol'>Niciun cont de registratură încă.</li>"; return; }
        d.registratori.forEach((r) => {
          const li = document.createElement("li");
          const info = document.createElement("div");
          const tare = document.createElement("strong");
          tare.textContent = r.nume;
          info.appendChild(tare);
          const meta = document.createElement("span");
          meta.className = "a-meta";
          meta.textContent = [r.email, r.ultima_logare ? "ultima intrare " + dataRo(r.ultima_logare) : "nu a intrat încă"]
            .filter(Boolean).join(" · ");
          info.appendChild(meta);

          // Dreptul de a genera coduri de membru: al unui SINGUR registrator, nu al
          // funcției. Se pune și se ia doar de aici — registratura dă acces, dar
          // nu-și dă singură dreptul de a-l da.
          const dr = document.createElement("label");
          dr.className = "a-drept";
          const bifa = document.createElement("input");
          bifa.type = "checkbox";
          bifa.checked = r.poateDaAcces === true;
          // Eticheta spune CE FACE bifa, nu doar starea: prima formulare („nu generează
          // coduri") se citea ca și cum bifa ar lua dreptul, când de fapt îl dă.
          const et = document.createElement("span");
          et.textContent = bifa.checked
            ? "✓ ARE dreptul: generează coduri de acces și poate cere extrase din registre"
            : "NU are dreptul de a genera coduri și de a cere extrase — pune bifa ca să i-l dai";
          bifa.addEventListener("change", async () => {
            bifa.disabled = true;
            try {
              await cere({ actiune: "registrator-acces", id: r.id, poateDaAcces: bifa.checked });
              incarcaRegistratori();
            } catch (e) {
              bifa.checked = !bifa.checked;
              alert("Nu am putut schimba dreptul: " + e.message);
            } finally { bifa.disabled = false; }
          });
          dr.appendChild(bifa); dr.appendChild(et);
          info.appendChild(dr);

          // Fără adresă, persoana intră DOAR cu codul: al doilea factor n-are unde
          // să ajungă. Se vede, ca să poată fi îndreptat, nu se ascunde.
          if (!r.email) {
            const av = document.createElement("span");
            av.className = "a-cotizatie is-expirat";
            av.textContent = "⚠ fără e-mail — intră doar cu codul, fără a doua cheie";
            info.appendChild(av);

            const rand = document.createElement("span");
            rand.className = "a-adauga-email";
            const camp = document.createElement("input");
            camp.type = "email";
            camp.placeholder = "adresa lui de e-mail";
            const ok = document.createElement("button");
            ok.type = "button";
            ok.className = "btn btn--small btn--outline";
            ok.textContent = "Pornește a doua cheie";
            ok.addEventListener("click", async () => {
              const e = camp.value.trim();
              if (!e) { camp.focus(); return; }
              ok.disabled = true;
              try { await cere({ actiune: "registrator-email", id: r.id, email: e }); incarcaRegistratori(); }
              catch (er) { alert("Nu am putut salva adresa: " + er.message); ok.disabled = false; }
            });
            rand.append(camp, ok);
            info.appendChild(rand);
          }

          li.appendChild(info);
          const del = document.createElement("button");
          del.className = "btn btn--small btn--danger";
          del.textContent = "Revocă";
          del.addEventListener("click", async () => {
            if (!confirm("Revoci accesul lui „" + r.nume + "”?")) return;
            del.disabled = true;
            try { await cere({ actiune: "registrator-sterge", id: r.id }); incarcaRegistratori(); }
            catch (e) { alert("Nu am putut revoca: " + e.message); del.disabled = false; }
          });
          li.appendChild(del);
          ul.appendChild(li);
        });
      } catch (e) { ul.innerHTML = "<li class='a-gol'>Nu am putut încărca lista.</li>"; }
    }

