---
// /drumul-spre-campion/ — pagina publică a sistemului de titluri WDF.
//
// Două etaje:
//   1. HARTA DRUMULUI — cum se ajunge de la prima înscriere la titlurile de campion,
//      cu condițiile fiecărui titlu citate din regulamentul oficial (Hotărârea 167).
//   2. PROGRESUL UNUI CÂINE — căutare ca în Cartea de origini (serie / nr. WDF /
//      microcip); progresul vine GATA CALCULAT de motorul de omologare al Managerului
//      (Art. 39) și e publicat pe fișă odată cu palmaresul. Aici doar se afișează —
//      nicio regulă nu se socotește a doua oară.
//
// Condițiile de mai jos sunt citate din regulamentul public „Titlurile oficiale de
// campion WDF" (Hotărârea Consiliului Director nr. 167/01-08-2026) — nu se modifică
// aici fără modificarea regulamentului.
import BaseLayout from "../../layouts/BaseLayout.astro";

const TREPTE = [
  { emoji: "📝", titlu: "Înscrierea", text: "Câinele cu pedigree se înscrie la o expoziție, în clasa potrivită vârstei lui." },
  { emoji: "🎖️", titlu: "Calificativul", text: "Arbitrul descrie și notează exemplarul; treapta cea mai înaltă este Excelent." },
  { emoji: "📜", titlu: "Certificatul", text: "Câștigătorul clasei cu Excelent poate primi certificatul: CAJC la tineret, CAC la adulți, CACIB la expozițiile internaționale." },
  { emoji: "🏆", titlu: "Titlul de campion", text: "Certificatele adunate, de la arbitri diferiți, se omologhează în titluri de campion — la cererea proprietarului." },
];

const TITLURI = [
  { cod: "junior_champion", nume: "Campion Junior", cerinte: "4 certificate CAJC, de la cel puțin 3 arbitri diferiți. CAJC se acordă în clasele de tineret (9–18 luni)." },
  { cod: "campion_national", nume: "Campion Național", cerinte: "6 certificate CAC, de la minimum 4 arbitri diferiți, dintre care cel puțin unul obținut la o expoziție internațională. Se poate obține o dată pentru fiecare an de viață, până la vârsta de 10 ani." },
  { cod: "campion_international", nume: "Campion Internațional", cerinte: "6 CACIB de la 4 arbitri diferiți, la expoziții internaționale din propria țară — sau 3 CACIB (2 din țara de origine + 1 dintr-o altă țară membră WDF; calea externă se omologhează cu actele la registratură)." },
  { cod: "grand_champion", nume: "Mare Campion (Grand Champion)", cerinte: "3 titluri de Campion Național omologate, în ani de viață diferiți. O singură dată în viață." },
  { cod: "multi_champion", nume: "Multi Campion", cerinte: "Titlurile Grand Champion și Campion Internațional, ambele omologate. O singură dată în viață. Titlul suprem al ierarhiei WDF." },
  { cod: "reproducer", nume: "Campion Reproducător", cerinte: "Se acordă pe baza descendenților, din cel puțin 2 cuiburi diferite: 6 descendenți cu Excelent sau 3 descendenți Campioni Naționali. Omologare cu dovezile la registratură." },
  { cod: "world_champion", nume: "Campion Mondial", cerinte: "Certificatul Internațional de Frumusețe (CACIB) obținut la World Cup WDF. Se acordă o singură dată în viață." },
];
---

<BaseLayout
  lang="ro"
  title="Drumul spre Campion"
  description="Cum se ajunge de la prima expoziție la titlurile de campion WDF — și unde se află câinele tău pe drum: certificate, arbitri, condiții de omologare, direct din registrul oficial CFC-Royal."
>
  <section class="dc">
    <p class="dc__cale"><a href="/ro/">Acasă</a> · Drumul spre Campion</p>
    <h1 class="dc__title">Drumul spre Campion</h1>
    <p class="dc__intro">
      De la prima înscriere într-o expoziție până la titlul de Multi Campion e un drum cu
      reguli precise, aceleași pentru toți. Pagina de față îl arată pas cu pas — iar dacă
      ai un câine în registrul CFC-Royal, îți arată <strong>exact unde se află el pe drum</strong>,
      din datele oficiale ale clubului.
    </p>

    <h2 class="dc__h2">Cum se urcă</h2>
    <ol class="dc__trepte">
      {TREPTE.map((t, i) => (
        <li class="dc__treapta">
          <span class="dc__nr">{i + 1}</span>
          <span class="dc__emoji" aria-hidden="true">{t.emoji}</span>
          <div><strong>{t.titlu}.</strong> {t.text}</div>
        </li>
      ))}
    </ol>

    <h2 class="dc__h2">Titlurile de campion WDF</h2>
    <p class="dc__nota">Condițiile de mai jos sunt cele din regulamentul
      public <a href="/ro/regulamente/titlurile-oficiale-de-campion-wdf/">„Titlurile oficiale de campion WDF"</a>
      (Hotărârea Consiliului Director nr. 167/01-08-2026). Titlurile se
      omologhează <strong>la cererea proprietarului</strong>, după verificarea certificatelor de către club.
      Omologarea este gratuită.</p>
    <ul class="dc__titluri" id="dc-titluri">
      {TITLURI.map((t) => (
        <li class="dc__titlu" data-titlu={t.cod}>
          <div class="dc__titlu-cap">
            <strong>🏆 {t.nume}</strong>
            <span class="dc__stare" data-stare={t.cod} hidden></span>
          </div>
          <p class="dc__cerinte">{t.cerinte}</p>
          <p class="dc__progres" data-progres={t.cod} hidden></p>
        </li>
      ))}
    </ul>

    <h2 class="dc__h2" id="cauta">Unde se află câinele tău?</h2>
    <p class="dc__nota">Caută după <strong>seria certificatului</strong>, <strong>numărul WDF</strong>
      sau <strong>microcip</strong> — ca în <a href="/caine/">Cartea de origini</a>.</p>
    <form class="dc__cauta" id="dc-form">
      <input id="dc-input" type="text" placeholder="CFCR-P-2026-0001 · WDF.RO… · 941000024600001"
             autocomplete="off" spellcheck="false" required
             aria-label="Serie, număr WDF sau microcip" />
      <button class="btn btn--primary" type="submit">Arată drumul</button>
    </form>
    <p class="dc__eroare" id="dc-eroare" role="alert" hidden></p>
    <div class="dc__caine" id="dc-caine" hidden>
      <h3 class="dc__caine-nume" id="dc-nume"></h3>
      <p class="dc__caine-nota" id="dc-nota"></p>
    </div>

    <p class="dc__final">Titlurile și certificatele fiecărui exemplar se văd și
      pe <a href="/caine/">fișa lui publică</a>, alături de ascendență. Pentru omologarea unui
      titlu cu condițiile îndeplinite: <strong>contact@cfc-royal.ro</strong>.</p>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const F = "/.netlify/functions/registru-pedigree";
    const form = document.getElementById("dc-form");
    const input = document.getElementById("dc-input");
    const eroare = document.getElementById("dc-eroare");
    const cutie = document.getElementById("dc-caine");

    function curata() {
      document.querySelectorAll("[data-stare]").forEach((e) => { e.hidden = true; e.className = "dc__stare"; });
      document.querySelectorAll("[data-progres]").forEach((e) => { e.hidden = true; });
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const cautat = input.value.trim();
      if (!cautat) return;
      eroare.hidden = true;
      cutie.hidden = true;
      curata();
      const btn = form.querySelector("button");
      btn.disabled = true;
      try {
        const r = await fetch(F, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ actiune: "caine", cautat }),
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.eroare || "Nu am găsit exemplarul.");

        cutie.hidden = false;
        document.getElementById("dc-nume").textContent = "🐾 " + (d.caine && d.caine.nume ? d.caine.nume : cautat);
        const nota = document.getElementById("dc-nota");

        const campionate = Array.isArray(d.campionate) ? d.campionate : [];
        if (!campionate.length) {
          nota.textContent = (Array.isArray(d.titluri) && d.titluri.length)
            ? "Exemplarul are titluri pe fișă, dar progresul detaliat spre campionate apare după următoarea publicare a palmaresului de către club."
            : "Exemplarul nu are încă certificate consemnate în registrul de campionate. Drumul începe la prima expoziție — vezi calendarul competițional.";
          return;
        }
        nota.textContent = "Progresul de mai sus, la fiecare titlu, vine din registrul oficial de campionate al clubului.";
        campionate.forEach((c) => {
          const st = document.querySelector('[data-stare="' + CSS.escape(c.cod) + '"]');
          const pr = document.querySelector('[data-progres="' + CSS.escape(c.cod) + '"]');
          if (!st || !pr) return;
          st.hidden = false;
          if (c.omologari && c.omologari.length) {
            st.textContent = "✅ OMOLOGAT " + c.omologari.join(", ");
            st.className = "dc__stare is-omologat";
          } else if (c.indeplinit) {
            st.textContent = "🎉 Condiții îndeplinite — cere omologarea";
            st.className = "dc__stare is-gata";
          } else {
            st.textContent = "în lucru";
            st.className = "dc__stare is-drum";
          }
          pr.hidden = false;
          pr.textContent = c.detaliu || "";
        });
        document.getElementById("dc-titluri").scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (err) {
        eroare.hidden = false;
        eroare.textContent = err.message + " Verifică seria sau microcipul și încearcă din nou.";
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>

<style>
  .dc { max-width: 56rem; margin: 0 auto; padding: 2rem 1.25rem 3rem; }
  .dc__cale { font-size: 0.85rem; color: var(--color-text-muted); }
  .dc__cale a { color: var(--color-link); }
  .dc__title { font-family: var(--font-serif); color: var(--color-primary); margin: 0.3rem 0 0.5rem; }
  .dc__intro { max-width: 46rem; color: var(--color-text); }
  .dc__h2 { font-family: var(--font-serif); color: var(--color-primary); margin: 2.25rem 0 0.75rem;
    font-size: 1.35rem; border-bottom: 2px solid var(--color-accent); padding-bottom: 0.35rem; }
  .dc__nota { color: var(--color-text-muted); max-width: 46rem; font-size: 0.95rem; }
  .dc__nota a { color: var(--color-link); }

  .dc__trepte { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.7rem; }
  .dc__treapta { display: flex; align-items: baseline; gap: 0.8rem; background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: var(--radius); padding: 0.85rem 1.1rem; }
  .dc__nr { flex: none; width: 1.7rem; height: 1.7rem; border-radius: 50%; background: var(--color-primary);
    color: var(--color-text-inverse); font-weight: 700; font-size: 0.9rem; display: grid; place-items: center;
    align-self: center; }
  .dc__emoji { font-size: 1.2rem; align-self: center; }

  .dc__titluri { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.8rem; }
  .dc__titlu { background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius); padding: 0.95rem 1.2rem; }
  .dc__titlu-cap { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; }
  .dc__titlu-cap strong { color: var(--color-primary); }
  .dc__cerinte { margin: 0.45rem 0 0; font-size: 0.92rem; color: var(--color-text-muted); max-width: 46rem; }
  :global(.dc__stare) { font-size: 0.8rem; font-weight: 700; padding: 0.2rem 0.7rem; border-radius: 999px;
    border: 1px solid var(--color-border); color: var(--color-text-muted); white-space: nowrap; }
  :global(.dc__stare.is-omologat) { background: #eef5f0; border-color: var(--color-primary); color: var(--color-primary); }
  :global(.dc__stare.is-gata) { background: #f7f1df; border-color: var(--color-accent); color: var(--color-accent-dark); }
  :global(.dc__progres) { margin: 0.5rem 0 0; font-size: 0.9rem; color: var(--color-text);
    border-top: 1px dashed var(--color-border); padding-top: 0.5rem; }

  .dc__cauta { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 1rem 0; }
  .dc__cauta input { flex: 1 1 22rem; padding: 0.7rem 0.9rem; border: 1px solid var(--color-border);
    border-radius: var(--radius); font: inherit; }
  :global(.dc__eroare) { color: #8c1d2f; background: #f9efef; border: 1px solid #8c1d2f;
    border-radius: var(--radius); padding: 0.7rem 1rem; max-width: 46rem; }
  .dc__caine { margin-top: 1rem; padding: 1rem 1.25rem; background: var(--color-surface-alt);
    border: 1px solid var(--color-accent); border-left-width: 4px; border-radius: var(--radius); max-width: 46rem; }
  .dc__caine-nume { margin: 0 0 0.3rem; font-family: var(--font-serif); color: var(--color-primary); }
  .dc__caine-nota { margin: 0; font-size: 0.9rem; color: var(--color-text-muted); }
  .dc__final { margin-top: 2rem; color: var(--color-text-muted); max-width: 46rem; font-size: 0.95rem;
    border-top: 1px solid var(--color-border); padding-top: 1rem; }
  .dc__final a { color: var(--color-link); }
</style>
