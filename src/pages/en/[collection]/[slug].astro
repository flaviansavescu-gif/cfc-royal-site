---
// Individual page of any collection (EN) — generated from the registry.
import RecordLayout from "../../../layouts/RecordLayout.astro";
import ContorInscrieri from "../../../components/ContorInscrieri.astro";
import { getCollection, render } from "astro:content";
import { collectionDefs, type CollectionDef } from "../../../data/collections";
import { localizePath, useTranslations } from "../../../i18n/utils";
import { isLang, entrySlug } from "../../../i18n/content";

const lang = "en" as const;

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const def of collectionDefs) {
    const entries = await getCollection(def.name as any, (e: any) => e.id.startsWith("en/") && !e.data.draft);
    for (const entry of entries) {
      paths.push({ params: { collection: def.slug, slug: entrySlug(entry.id) }, props: { entry, def } });
    }
  }
  return paths;
}

const { entry, def } = Astro.props as { entry: any; def: CollectionDef };
const t = useTranslations(lang);
const { Content } = await render(entry);
const d = entry.data;

let meta = def.metaRows ? def.metaRows(d, lang) : [];
// Shows (15 Sep 2026, strategy 2026–2027): announced judges appear on the page (references
// to the Panel), and while entries are open, the public entry counter.
if (def.slug === "expozitii" && Array.isArray(d.judges) && d.judges.length) {
  const colegiu = await getCollection("arbitri" as any, (e: any) => e.id.startsWith(`${lang}/`));
  const nume = d.judges
    .map((ref: any) => colegiu.find((a: any) => a.id === ref.id || a.id.endsWith("/" + ref.id))?.data.title ?? "")
    .filter(Boolean);
  if (nume.length) meta = [...meta, { label: lang === "en" ? "Judges" : "Arbitri", value: nume.join(" · "), wide: true }];
}
const contorShowId = def.slug === "expozitii" && d.managerShowId && d.status !== "încheiată" ? String(d.managerShowId) : null;
const jsonLd = def.jsonLd ? def.jsonLd(d, lang) : undefined;
const breadcrumbs = [
  { label: t("nav.home"), href: localizePath("", lang) },
  { label: def.label[lang], href: localizePath(def.slug, lang) },
  { label: d.title, href: "#" },
];
---
<RecordLayout
  lang={lang}
  title={d.title}
  description={d.summary}
  eyebrow={def.eyebrow[lang]}
  cover={d.cover}
  portrait={def.portrait ? def.portrait(d) : undefined}
  meta={meta}
  breadcrumbs={breadcrumbs}
  gallery={d.gallery}
  jsonLd={jsonLd}
>
  {contorShowId && <ContorInscrieri showId={contorShowId} lang={lang} />}
  <Content />
</RecordLayout>
