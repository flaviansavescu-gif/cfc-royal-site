---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InscriereExpo from "../../components/InscriereExpo.astro";
const lang = "ro" as const;
---
<BaseLayout title="Înscriere la expoziție" lang={lang} description="Înscrie online un câine la o expoziție a Clubului Federal Chinologic – Royal (WDF).">
  <div class="container" style="padding-block: 3rem;">
    <p class="fara-net">
      Nu ai calculator sau e-mail? <a href="/ro/inscriere-fara-internet/">Înscrie câinele prin telefon sau pe hârtie</a> — registratura completează pentru tine.
    </p>
    <InscriereExpo lang={lang} />
  </div>
</BaseLayout>

<style>
  .fara-net {
    background: #f5f1e6;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    max-width: 52rem;
  }
</style>
