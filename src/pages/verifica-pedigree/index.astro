---
// /verifica-pedigree/?s=CFCR-P-2026-0001 — verificarea publică a unui certificat.
//
// Ținta codului QR de pe act. Fără cod de acces: oricine ține certificatul în mână —
// un cumpărător, un arbitru la intrarea în ring, o altă asociație — trebuie să poată
// afla în două secunde dacă e real.
//
// Se arată DOAR identitatea câinelui și tipul certificatului. Numele și adresa
// proprietarului nu au ce căuta la o adresă publică pe care o poate deschide oricine
// fotografiază un act. Afixul crescătorului se arată: e numele unei canise, public prin
// natura lui.
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout lang="ro" title="Verificarea certificatului de origine" description="Verifică autenticitatea unui Certificat de Origine emis de Asociația Club Federal Chinologic Royal.">
  <section class="v-sect">
    {/* Fără comutator propriu: pagina ascultă de cel din antet, comun întregului site. */}
    <p class="v-eyebrow" data-ro="Registrul genealogic" data-en="Stud book">Registrul genealogic</p>
    <h1 class="v-title" data-ro="Verificarea certificatului" data-en="Verify a certificate">Verificarea certificatului</h1>
    <p class="v-sub"
       data-ro="Scrie seria de pe certificat sau scanează codul QR de pe act. Verificarea arată datele de identificare ale câinelui, așa cum sunt înregistrate la asociație."
       data-en="Enter the serial number printed on the certificate, or scan the QR code on it. The check shows the dog's identification data exactly as recorded by the association.">
      Scrie seria de pe certificat sau scanează codul QR de pe act. Verificarea arată datele
      de identificare ale câinelui, așa cum sunt înregistrate la asociație.
    </p>

    <form class="v-form" id="v-form">
      <label for="v-serie" data-ro="Seria certificatului" data-en="Certificate serial number">Seria certificatului</label>
      <input id="v-serie" name="serie" type="text" placeholder="ex. CFCR-P-2026-0001"
             autocomplete="off" spellcheck="false" required />
      <button class="btn btn--primary" type="submit" data-ro="Verifică" data-en="Verify">Verifică</button>
    </form>

    <p class="v-eroare" id="v-eroare" role="alert" hidden></p>

    <div class="v-rezultat" id="v-rezultat" hidden>
      <p class="v-valid" id="v-valid"></p>
      <table class="v-tabel" id="v-tabel"></table>
      <p class="v-fisa" id="v-fisa" hidden>
        <a class="btn btn--outline" href="/caine/"
           data-ro="Vezi fișa completă: ascendență, frați de cuib, descendenți →"
           data-en="Open the full record: pedigree, littermates, progeny →">Vezi fișa completă: ascendență, frați de cuib, descendenți →</a>
      </p>
      <p class="v-nota"
         data-ro="Verificarea confirmă că seria există în registrul asociației și că datele afișate sunt cele înregistrate. Datele proprietarului nu se afișează public. Pentru orice neconcordanță între actul tipărit și această pagină, scrie la contact@cfc-royal.ro."
         data-en="The check confirms that the serial number exists in the association's register and that the data shown is what was recorded. Owner details are not published. For any discrepancy between the printed certificate and this page, write to contact@cfc-royal.ro.">
        Verificarea confirmă că seria există în registrul asociației și că datele afișate sunt cele
        înregistrate. Datele proprietarului nu se afișează public. Pentru orice neconcordanță între
        actul tipărit și această pagină, scrie la contact@cfc-royal.ro.
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const F = "/.netlify/functions/registru-pedigree";
    const form = document.getElementById("v-form");
    const input = document.getElementById("v-serie");
    const eroare = document.getElementById("v-eroare");
    const rezultat = document.getElementById("v-rezultat");

    const el = (tag, cls, text) => {
      const x = document.createElement(tag);
      if (cls) x.className = cls;
      if (text != null) x.textContent = text;
      return x;
    };

    // —— Limba ——
    // Pagina asta e ținta codului QR de pe certificat, deci o poate deschide o asociație
    // străină sau un cumpărător din altă țară. Textele fixe stau în atributele data-ro /
    // data-en; cele care se construiesc din date stau în tabelul de mai jos.
    const L = {
      ro: {
        valabil: (s) => "✓ Certificatul " + s + " este înregistrat și valabil.",
        anulat: (s) => "⚠ Certificatul " + s + " a fost ANULAT.",
        tip: "Tipul certificatului", tipA: " — ascendență completă pe patru generații",
        tipB: " — ascendență incompletă",
        nume: "Numele câinelui", rasa: "Rasa", sex: "Sexul", mascul: "mascul", femela: "femelă",
        nastere: "Data nașterii", culoare: "Culoarea", microcip: "Microcip / tatuaj",
        cuib: "Nr. cuib WDF", afix: "Afixul crescătorului", emitere: "Data emiterii",
        seCauta: "Se verifică…", butonul: "Verifică", esec: "Verificarea a eșuat.",
      },
      en: {
        valabil: (s) => "✓ Certificate " + s + " is registered and valid.",
        anulat: (s) => "⚠ Certificate " + s + " has been CANCELLED.",
        tip: "Certificate type", tipA: " — complete four-generation pedigree",
        tipB: " — incomplete pedigree",
        nume: "Dog's name", rasa: "Breed", sex: "Sex", mascul: "male", femela: "female",
        nastere: "Date of birth", culoare: "Colour", microcip: "Microchip / tattoo",
        cuib: "WDF litter no.", afix: "Breeder's affix", emitere: "Date of issue",
        seCauta: "Checking…", butonul: "Verify", esec: "The check failed.",
      },
    };
    // Limba vine din adresă (`?lang=`, pusă de comutatorul din antet); dacă lipsește,
    // decide limba browserului — cine vine cu telefonul din altă țară, scanând codul QR
    // de pe certificat, nu trebuie să caute un buton ca să înțeleagă pagina.
    const limbaCeruta = (new URLSearchParams(location.search).get("lang") || "").toLowerCase();
    let limba = limbaCeruta === "ro" || limbaCeruta === "en"
      ? limbaCeruta
      : ((navigator.language || "ro").toLowerCase().startsWith("ro") ? "ro" : "en");
    const dataRo = (s) => {
      const x = new Date(s);
      return isNaN(x) ? String(s || "") : x.toLocaleDateString(limba === "ro" ? "ro-RO" : "en-GB");
    };
    let ultima = null;   // ultimul certificat afișat, ca să-l putem reface în cealaltă limbă

    /** Comutatorul din antet e construit la generare; îl refacem după limba aleasă aici. */
    function sincronizeazaAntetul() {
      const nav = document.querySelector(".langswitch");
      if (!nav) return;
      nav.textContent = "";
      for (const cod of ["ro", "en"]) {
        if (cod === limba) {
          const s = document.createElement("span");
          s.className = "langswitch__item";
          s.setAttribute("aria-current", "true");
          s.textContent = cod.toUpperCase();
          nav.appendChild(s);
        } else {
          const p = new URLSearchParams(location.search);
          p.set("lang", cod);
          const a = document.createElement("a");
          a.className = "langswitch__item langswitch__link";
          a.href = location.pathname + "?" + p.toString();
          a.hreflang = cod; a.lang = cod;
          a.textContent = cod.toUpperCase();
          a.addEventListener("click", (e) => {
            e.preventDefault();
            limba = cod;
            history.replaceState(null, "", a.href);
            aplicaLimba();
          });
          nav.appendChild(a);
        }
      }
    }

    function aplicaLimba() {
      document.documentElement.lang = limba;
      document.querySelectorAll("[data-ro]").forEach((x) => {
        x.textContent = x.getAttribute("data-" + limba) || x.textContent;
      });
      sincronizeazaAntetul();
      if (ultima) deseneaza(ultima);
    }

    function deseneaza(c) {
      const T = L[limba];
      const valid = document.getElementById("v-valid");
      valid.className = "v-valid " + (c.anulat ? "is-anulat" : "is-bun");
      valid.textContent = c.anulat ? T.anulat(c.serie) : T.valabil(c.serie);

      const t = document.getElementById("v-tabel");
      t.textContent = "";
      const rand = (a, b) => {
        const tr = document.createElement("tr");
        tr.appendChild(el("th", null, a));
        tr.appendChild(el("td", null, b || "—"));
        t.appendChild(tr);
      };
      rand(T.tip, "Tip " + c.tip + (c.tip === "A" ? T.tipA : T.tipB));
      rand(T.nume, c.caine.nume);
      rand(T.rasa, c.caine.rasa + (c.caine.varietate ? " · " + c.caine.varietate : ""));
      rand(T.sex, c.caine.sex === "M" ? T.mascul : T.femela);
      rand(T.nastere, dataRo(c.caine.dataNasterii));
      rand(T.culoare, c.caine.culoare);
      rand(T.microcip, c.caine.microcip);
      rand(T.cuib, c.numarWDF);
      rand(T.afix, c.afixCrescator);
      rand(T.emitere, dataRo(c.emis));

      const catreFisa = document.getElementById("v-fisa");
      catreFisa.hidden = false;
      catreFisa.querySelector("a").href = "/caine/?r=" + encodeURIComponent(c.serie);
      rezultat.hidden = false;
    }

    async function verifica(serie) {
      eroare.hidden = true;
      rezultat.hidden = true;
      const btn = form.querySelector("button[type=submit]");
      btn.disabled = true; btn.textContent = L[limba].seCauta;
      try {
        const r = await fetch(F, { method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ actiune: "verifica", serie }) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.eroare || L[limba].esec);
        ultima = d.certificat;
        deseneaza(ultima);
      } catch (err) {
        eroare.hidden = false;
        eroare.textContent = err.message;
      }
      btn.disabled = false; btn.textContent = L[limba].butonul;
    }

    aplicaLimba();

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const s = input.value.trim().toUpperCase();
      if (s) verifica(s);
    });

    // Venit prin QR: seria e deja în adresă, deci verificăm pe loc.
    const dinAdresa = (new URLSearchParams(location.search).get("s") || "").trim().toUpperCase();
    if (dinAdresa) { input.value = dinAdresa; verifica(dinAdresa); }
  })();
</script>

<style>
  .v-sect { max-width: 46rem; margin-inline: auto; padding: 3rem 1.25rem 4rem; }
  .v-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; color: var(--color-accent-dark); margin: 0; }
  .v-title { font-family: var(--font-serif); color: var(--color-primary); margin: 0.35rem 0 0.5rem; }
  .v-sub { color: var(--color-text-muted); }
  .v-form { display: grid; gap: 0.6rem; max-width: 24rem; margin: 2rem 0; }
  .v-form label { font-weight: 600; color: var(--color-primary); }
  .v-form input { padding: 0.7rem 0.9rem; border: 1px solid var(--color-border);
    border-radius: var(--radius); font-size: 1.02rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .v-form .btn { justify-self: start; }
  .v-eroare { padding: 0.7rem 1rem; border-radius: var(--radius);
    background: #f9efef; border: 1px solid #8c1d2f; color: #8c1d2f; }
  .v-eroare[hidden], .v-rezultat[hidden] { display: none; }
  .v-valid { padding: 0.8rem 1rem; border-radius: var(--radius); font-weight: 700; }
  .v-valid.is-bun { background: #eef5f0; border: 1px solid var(--color-primary); color: var(--color-primary); }
  .v-valid.is-anulat { background: #f9efef; border: 1px solid #8c1d2f; color: #8c1d2f; }
  .v-tabel { border-collapse: collapse; width: 100%; margin-top: 1rem; }
  .v-tabel th, .v-tabel td { text-align: left; padding: 0.45rem 0.6rem; font-size: 0.92rem;
    border-bottom: 1px solid var(--color-border); }
  .v-tabel th { color: var(--color-primary); width: 42%; font-weight: 600; }
  .v-fisa[hidden] { display: none; }
  .v-fisa { margin-top: 1.2rem; }
  .v-nota { font-size: 0.85rem; color: var(--color-text-muted); margin-top: 1.2rem; }
  .v-nota a { color: var(--color-accent-dark); }
</style>
