---
// /verifica-pedigree/?s=CFCR-P-2026-0001 — verificarea publică a unui certificat, în română.
// Varianta engleză stă la /en/verifica-pedigree/. Adresa asta rămâne la rădăcină fiindcă
// e cea tipărită în codul QR de pe certificate.
import BaseLayout from "../../layouts/BaseLayout.astro";
import VerificaPedigree from "../../components/VerificaPedigree.astro";
---

<BaseLayout
  lang="ro"
  title="Verificarea certificatului de origine"
  description="Verifică autenticitatea unui Certificat de Origine emis de Asociația Club Federal Chinologic Royal."
>
  <script is:inline>
    // Compatibilitate cu legăturile vechi de forma /verifica-pedigree/?lang=en.
    (function () {
      const p = new URLSearchParams(location.search);
      if ((p.get("lang") || "").toLowerCase() === "en") {
        p.delete("lang");
        const q = p.toString();
        location.replace("/en/verifica-pedigree/" + (q ? "?" + q : ""));
      }
    })();
  </script>
  <VerificaPedigree lang="ro" />
</BaseLayout>
