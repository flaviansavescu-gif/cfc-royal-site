---
// /caine/?r=… — fișa publică a unui exemplar, în română.
// Varianta engleză stă la /en/caine/. Adresa asta rămâne la rădăcină fiindcă e cea
// tipărită în codul QR de pe certificate și nu se mai poate schimba.
import BaseLayout from "../../layouts/BaseLayout.astro";
import CarteaOrigini from "../../components/CarteaOrigini.astro";
---

<BaseLayout
  lang="ro"
  title="Cartea de origini"
  description="Caută un câine înregistrat în Registrul genealogic al Asociației Club Federal Chinologic Royal: ascendență pe patru generații, frați de cuib, descendenți și titluri."
>
  <script is:inline>
    // Compatibilitate cu legăturile vechi: până acum limba se cerea prin `?lang=en`.
    // Adresele acelea sunt deja pe Facebook și în e-mailuri, așa că le trimitem mai
    // departe la pagina engleză, cu tot cu `?r=`. Rulează înaintea fișei, ca să nu
    // pornească o căutare pe care oricum o aruncăm.
    (function () {
      const p = new URLSearchParams(location.search);
      if ((p.get("lang") || "").toLowerCase() === "en") {
        p.delete("lang");
        const q = p.toString();
        location.replace("/en/caine/" + (q ? "?" + q : ""));
      }
    })();
  </script>
  <CarteaOrigini lang="ro" />
</BaseLayout>
