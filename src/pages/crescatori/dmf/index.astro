---
// /crescatori/dmf/ — Declarația de Montă și Fătare.
//
// Reproduce actul de pe hârtie, cu trei deosebiri (motivate în registru-dmf.mjs):
// un singur formular în locul celor patru variante tipărite, microcip obligatoriu la
// părinți, număr de înregistrare dat pe loc.
//
// Rândurile de pui NU se adaugă manual: rezultă din statistica cuibului. Pe hârtie,
// omul completa statistica și apoi rândurile, iar cele două ieșeau adesea diferite.
// Aici statistica e sursa unică — câte suflete ai trecut ca rămase pentru creștere,
// atâtea rânduri primești.
import RegistruLayout from "../../../layouts/RegistruLayout.astro";
import { RASE_WDF } from "../../../data/nomenclator-wdf";

const rase = [...RASE_WDF].map((r) => r.ro).sort((a, b) => a.localeCompare(b, "ro"));
---

<RegistruLayout title="Declarație de Montă și Fătare" allow={["membru"]}>
  <p class="d-eyebrow">Registrul genealogic</p>
  <h1 class="d-title">Declarație de Montă și Fătare</h1>
  <p class="d-sub">
    Termen de depunere: <strong>maximum 90 de zile de la data nașterii puilor</strong>.
    Se depune de <strong>proprietarul femelei montate</strong>. La final primești pe e-mail
    numărul de înregistrare — dovada că ai depus în termen.
  </p>

  <p class="d-cotizatie" id="d-cotizatie" hidden></p>

  <form id="d-form" class="d-form">
    <!-- ——— Cuibul ——— -->
    <section class="d-sect">
      <h2 class="d-h2">Cuibul</h2>
      <div class="d-grid2">
        <label>Rasa
          <input name="rasa" list="d-rase" required autocomplete="off" />
        </label>
        <label>Varietate <span class="d-opt">(opțional)</span>
          <input name="varietate" autocomplete="off" />
        </label>
        <label>Data montei
          <input name="dataMontei" type="date" required />
        </label>
        <label>Data fătării
          <input name="dataFatarii" type="date" required />
        </label>
      </div>
      <p class="d-termen" id="d-termen" hidden></p>

      <h3 class="d-h3">Statistica cuibului</h3>
      <table class="d-stat">
        <thead>
          <tr><th></th><th>Număr născuți</th><th>Rămași pentru creștere</th></tr>
        </thead>
        <tbody>
          <tr>
            <th>Masculi</th>
            <td><input name="nascutiM" type="number" min="0" max="30" value="0" required /></td>
            <td><input name="ramasiM" type="number" min="0" max="30" value="0" required /></td>
          </tr>
          <tr>
            <th>Femele</th>
            <td><input name="nascutiF" type="number" min="0" max="30" value="0" required /></td>
            <td><input name="ramasiF" type="number" min="0" max="30" value="0" required /></td>
          </tr>
          <tr class="d-total">
            <th>Total</th>
            <td id="d-totalNascuti">0</td>
            <td id="d-totalRamasi">0</td>
          </tr>
        </tbody>
      </table>
      <p class="d-nota">Rândurile de pui de mai jos se generează din „rămași pentru creștere".</p>
    </section>

    <!-- ——— Părinții ——— -->
    <section class="d-sect">
      <h2 class="d-h2">Părinții</h2>
      <p class="d-nota">
        <strong>Microcipul e obligatoriu la ambii părinți</strong> — 15 cifre (ISO) sau 10 cifre la
        cipurile vechi. Identifică reproducătorii fără echivoc, chiar dacă numele se repetă între canise.
      </p>
      <div class="d-parinti">
        <fieldset class="d-parinte">
          <legend>♂ Masculul care a montat</legend>
          <label>Numele câinelui <input name="mascul.nume" required /></label>
          <label>Nr./Serie Cert. Pedigree <input name="mascul.pedigree" required /></label>
          <label>Microcip <input name="mascul.microcip" inputmode="numeric" required placeholder="15 cifre" /></label>
          <label>Data nașterii <input name="mascul.dataNasterii" type="date" required /></label>
          <label>Palmares și teste <span class="d-opt">(opțional)</span><textarea name="mascul.palmares" rows="2"></textarea></label>
          <label>Proprietar <input name="mascul.proprietar" required /></label>
          <label>Membru al asociației / clubului <span class="d-opt">(opțional)</span><input name="mascul.membruAsociatiei" /></label>
          <label>Adresa proprietarului <span class="d-opt">(opțional)</span><input name="mascul.adresa" /></label>
          <label>E-mail <input name="mascul.email" type="email" required /></label>
          <label>Telefon <span class="d-opt">(opțional)</span><input name="mascul.telefon" /></label>
          <p class="d-nota d-nota--mic">Pe această adresă pleacă cererea de confirmare a montei. Funcționează și
          pentru masculi din alte asociații sau din străinătate — proprietarul nu are nevoie de cod.</p>
        </fieldset>

        <fieldset class="d-parinte">
          <legend>♀ Femela care a fost montată</legend>
          <label>Numele câinelui <input name="femela.nume" required /></label>
          <label>Nr./Serie Cert. Pedigree <input name="femela.pedigree" required /></label>
          <label>Microcip <input name="femela.microcip" inputmode="numeric" required placeholder="15 cifre" /></label>
          <label>Data nașterii <input name="femela.dataNasterii" type="date" required /></label>
          <label>Palmares și teste <span class="d-opt">(opțional)</span><textarea name="femela.palmares" rows="2"></textarea></label>
          <label>Proprietar <input name="femela.proprietar" required /></label>
          <label>Membru al asociației / clubului <span class="d-opt">(opțional)</span><input name="femela.membruAsociatiei" /></label>
          <label>Adresa proprietarului <span class="d-opt">(opțional)</span><input name="femela.adresa" /></label>
          <label>E-mail <span class="d-opt">(opțional)</span><input name="femela.email" type="email" /></label>
          <label>Telefon <span class="d-opt">(opțional)</span><input name="femela.telefon" /></label>
        </fieldset>
      </div>
    </section>

    <!-- ——— Puii ——— -->
    <section class="d-sect">
      <h2 class="d-h2">Puii declarați</h2>
      <p class="d-nota" id="d-afix"></p>
      <div id="d-pui"><p class="d-gol">Completează statistica cuibului ca să apară rândurile.</p></div>
    </section>

    <!-- ——— Dosarul ——— -->
    <section class="d-sect">
      <h2 class="d-h2">Piesele dosarului</h2>
      <p class="d-nota">
        JPEG, PNG, WEBP sau PDF, maximum 5 MB fiecare. Fotografiile se micșorează automat
        înainte de trimitere, deci pozele făcute cu telefonul merg fără pregătire.
      </p>
      <div class="d-fisiere">
        <label class="d-fis" data-fel="pedigree-mascul">
          <span class="d-fis__nume">Pedigree-ul masculului</span>
          <input type="file" accept="image/jpeg,image/png,image/webp,application/pdf" />
          <span class="d-fis__stare">nicio piesă</span>
        </label>
        <label class="d-fis" data-fel="pedigree-femela">
          <span class="d-fis__nume">Pedigree-ul femelei</span>
          <input type="file" accept="image/jpeg,image/png,image/webp,application/pdf" />
          <span class="d-fis__stare">nicio piesă</span>
        </label>
        <label class="d-fis" data-fel="drept-monta">
          <span class="d-fis__nume">Dovada dreptului de montă al femelei</span>
          <input type="file" accept="image/jpeg,image/png,image/webp,application/pdf" />
          <span class="d-fis__stare">nicio piesă</span>
        </label>
        <label class="d-fis" data-fel="plata">
          <span class="d-fis__nume">Dovada plății</span>
          <input type="file" accept="image/jpeg,image/png,image/webp,application/pdf" />
          <span class="d-fis__stare">nicio piesă</span>
        </label>
      </div>
      <p class="d-nota d-nota--mic">
        Dreptul de montă al femelei se dovedește cu fișa de arbitraj sau cu imaginea din carnetul
        de performanță, din care rezultă minimum un calificativ <strong>„Bun"</strong>.
      </p>
    </section>

    <!-- ——— Declarațiile pe propria răspundere ——— -->
    <section class="d-sect">
      <h2 class="d-h2">Declar pe propria răspundere</h2>
      <label class="d-bifa">
        <input type="checkbox" name="c.adn" required />
        <span>Sunt de acord cu prelevarea de mostre ADN la solicitarea asociației și mă oblig să asigur
        prelevarea în caz de deces sau înstrăinare a vreunuia dintre câinii montați, în termen de
        <strong>16 luni</strong> de la depunerea prezentei declarații.</span>
      </label>
      <label class="d-bifa">
        <input type="checkbox" name="c.predare60" required />
        <span>Toți puii vor fi predați noilor proprietari numai după împlinirea vârstei minime legale de
        <strong>60 de zile</strong> și vor beneficia de deparazitările și vaccinările obligatorii,
        conform protocolului sanitar-veterinar în vigoare.</span>
      </label>
      <label class="d-bifa">
        <input type="checkbox" name="c.gdpr" required />
        <span>Datele cumpărătorilor pe care le completez au fost furnizate cu acordul acestora, pentru
        eliberarea documentelor de origine, și declar că informațiile sunt complete, reale și actualizate.</span>
      </label>
    </section>

    <p class="d-eroare" id="d-eroare" role="alert" hidden></p>
    <p class="d-actiuni">
      <button class="btn btn--primary" type="submit">Depune declarația</button>
      <a class="btn btn--outline" href="/crescatori/">Renunță</a>
    </p>
  </form>

  <div class="d-gata" id="d-gata" hidden>
    <h2 class="d-h2">Declarație înregistrată</h2>
    <p class="d-serie" id="d-serie"></p>
    <p id="d-gata-text"></p>
    <p><a class="btn btn--primary" href="/crescatori/">Înapoi în spațiul meu</a></p>
  </div>

  <datalist id="d-rase">{rase.map((r) => <option value={r} />)}</datalist>
</RegistruLayout>

<script is:inline>
  (function () {
    const F = "/.netlify/functions/registru-dmf";
    const form = document.getElementById("d-form");
    const eroare = document.getElementById("d-eroare");
    const cod = () => localStorage.getItem("cfcrRegistruCod") || "";
    let membru = null;
    try { membru = JSON.parse(localStorage.getItem("cfcrRegistru") || "null"); } catch (e) {}

    // —— Cotizația: se vede de la început de ce nu merge, nu abia la trimitere ——
    if (membru && membru.cotizatiePana && !membru.cotizatieLaZi) {
      const c = document.getElementById("d-cotizatie");
      c.hidden = false;
      c.textContent = "⚠ Cotizația a expirat. Până la reînnoire nu poți depune declarații. Scrie secretariatului la contact@cfc-royal.ro.";
      form.querySelectorAll("input, textarea, button, select").forEach((el) => { el.disabled = true; });
    }
    if (membru && membru.afix) {
      document.getElementById("d-afix").textContent =
        "Afix crescător: " + membru.afix + (membru.nrAfix ? " · " + membru.nrAfix : "") +
        " — se trece automat pe declarație.";
    } else {
      document.getElementById("d-afix").textContent =
        "Nu ai afix înregistrat. Declarația se poate depune și fără; puii primesc documente de origine fără prefix de canisă.";
    }

    const g = (n) => form.querySelector('[name="' + n + '"]');

    // —— Termenul de 90 de zile, calculat în timp ce omul scrie ——
    // „de" se pune după numerele al căror rest la 100 e 0 sau între 20 și 99:
    // 5 zile, 20 de zile, 101 zile, 120 de zile.
    function zileText(n) {
      if (n === 1) return "o zi";
      const r = n % 100;
      return n + (n >= 20 && (r === 0 || r >= 20) ? " de zile" : " zile");
    }
    function termen() {
      const el = document.getElementById("d-termen");
      const f = g("dataFatarii").value;
      if (!f) { el.hidden = true; return; }
      const zile = Math.round((Date.now() - Date.parse(f)) / 86400000);
      el.hidden = false;
      if (zile < 0) {
        el.className = "d-termen is-rau";
        el.textContent = "Data fătării este în viitor.";
      } else if (zile > 90) {
        el.className = "d-termen is-rau";
        // Fără ghilimele românești în șiruri JS: „…" închide șirul și rupe scriptul.
        el.textContent = (zile === 1 ? "A trecut " : "Au trecut ") + zileText(zile) + " de la fătare — termenul de 90 de zile e depășit. " +
          "Poți depune în continuare; dosarul se marchează peste termen și decide registratura.";
      } else {
        const ramase = 90 - zile;
        el.className = "d-termen is-bun";
        el.textContent = (zile === 1 ? "A trecut " : "Au trecut ") + zileText(zile) + " de la fătare. " +
          (ramase === 0 ? "Azi e ultima zi din termen." : "Mai ai " + zileText(ramase) + " din termen.");
      }
    }
    g("dataFatarii").addEventListener("change", termen);

    // —— Rândurile de pui, generate din statistică ——
    // Se păstrează ce era deja scris: schimbarea unui număr nu trebuie să șteargă
    // datele completate pentru ceilalți pui.
    const zona = document.getElementById("d-pui");
    function randPui(sex, i, vechi) {
      const v = vechi || {};
      const d = document.createElement("fieldset");
      d.className = "d-pui";
      d.dataset.sex = sex;
      const camp = (eticheta, nume, val, extra) =>
        '<label>' + eticheta + '<input name="' + nume + '" value="' + (val || "").replace(/"/g, "&quot;") + '" ' + (extra || "") + ' /></label>';
      d.innerHTML =
        '<legend>' + (sex === "M" ? "♂ Mascul" : "♀ Femelă") + " " + i + "</legend>" +
        '<div class="d-grid2">' +
        camp("Numele câinelui", "nume", v.nume, "required") +
        camp("Culoare", "culoare", v.culoare) +
        camp("Varietate", "varietate", v.varietate) +
        camp("Tip de păr", "tipPar", v.tipPar) +
        camp("Tatuaj sau microcip (dacă există)", "identificare", v.identificare) +
        "</div>" +
        '<p class="d-nota d-nota--mic">Datele noului proprietar, dacă sunt cunoscute acum. Se pot completa și ulterior, la registratură.</p>' +
        '<div class="d-grid2">' +
        camp("Numele viitorului proprietar", "c.nume", v.cnume) +
        camp("Adresa", "c.adresa", v.cadresa) +
        camp("Localitate", "c.localitate", v.clocalitate) +
        camp("Județ", "c.judet", v.cjudet) +
        camp("Cod poștal", "c.codPostal", v.ccodPostal) +
        camp("Țara", "c.tara", v.ctara) +
        camp("Telefon", "c.telefon", v.ctelefon) +
        camp("E-mail", "c.email", v.cemail, 'type="email"') +
        "</div>";
      return d;
    }
    function citesteRanduri() {
      return [...zona.querySelectorAll(".d-pui")].map((f) => {
        const q = (n) => (f.querySelector('[name="' + n + '"]') || {}).value || "";
        return {
          sex: f.dataset.sex, nume: q("nume"), culoare: q("culoare"), varietate: q("varietate"),
          tipPar: q("tipPar"), identificare: q("identificare"),
          cnume: q("c.nume"), cadresa: q("c.adresa"), clocalitate: q("c.localitate"),
          cjudet: q("c.judet"), ccodPostal: q("c.codPostal"), ctara: q("c.tara"),
          ctelefon: q("c.telefon"), cemail: q("c.email"),
        };
      });
    }
    function refaPui() {
      const nM = Math.max(0, Math.min(30, Number(g("ramasiM").value) || 0));
      const nF = Math.max(0, Math.min(30, Number(g("ramasiF").value) || 0));
      const vechi = citesteRanduri();
      const vM = vechi.filter((x) => x.sex === "M");
      const vF = vechi.filter((x) => x.sex === "F");
      zona.textContent = "";
      if (nM + nF === 0) {
        const p = document.createElement("p");
        p.className = "d-gol";
        p.textContent = "Completează statistica cuibului ca să apară rândurile.";
        zona.appendChild(p);
      }
      // Actul cere ordinea: întâi masculii, apoi femelele.
      for (let i = 0; i < nM; i++) zona.appendChild(randPui("M", i + 1, vM[i]));
      for (let i = 0; i < nF; i++) zona.appendChild(randPui("F", i + 1, vF[i]));
      document.getElementById("d-totalRamasi").textContent = String(nM + nF);
    }
    function totaluri() {
      document.getElementById("d-totalNascuti").textContent =
        String((Number(g("nascutiM").value) || 0) + (Number(g("nascutiF").value) || 0));
      refaPui();
    }
    ["nascutiM", "nascutiF", "ramasiM", "ramasiF"].forEach((n) => g(n).addEventListener("input", totaluri));

    // —— Fișierele: micșorare în browser, apoi încărcare separată ——
    // Patru poze de telefon trimise împreună depășesc limita unei cereri; fiecare piesă
    // pleacă singură, imediat ce e aleasă, ca la depunere să nu mai fie nimic de urcat.
    let ciornaId = null;
    const incarcate = {};
    async function ciorna() {
      if (ciornaId) return ciornaId;
      const r = await fetch(F, { method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cod: cod(), actiune: "ciorna-noua" }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.eroare || "Nu am putut deschide dosarul.");
      ciornaId = d.ciornaId;
      return ciornaId;
    }
    function micsoreaza(file) {
      // PDF-urile trec neatinse; doar imaginile se redimensionează.
      if (file.type === "application/pdf") return Promise.resolve(file);
      return new Promise((rez) => {
        const img = new Image();
        img.onload = function () {
          const MAX = 1800;
          const sc = Math.min(1, MAX / Math.max(img.width, img.height));
          if (sc === 1 && file.size < 1200000) { URL.revokeObjectURL(img.src); rez(file); return; }
          const cv = document.createElement("canvas");
          cv.width = Math.round(img.width * sc); cv.height = Math.round(img.height * sc);
          cv.getContext("2d").drawImage(img, 0, 0, cv.width, cv.height);
          URL.revokeObjectURL(img.src);
          cv.toBlob((b) => rez(b && b.size < file.size ? b : file), "image/jpeg", 0.72);
        };
        img.onerror = function () { URL.revokeObjectURL(img.src); rez(file); };
        img.src = URL.createObjectURL(file);
      });
    }
    const catreBase64 = (blob) => new Promise((rez, resp) => {
      const fr = new FileReader();
      fr.onload = () => rez(String(fr.result).split(",")[1] || "");
      fr.onerror = resp;
      fr.readAsDataURL(blob);
    });
    document.querySelectorAll(".d-fis").forEach((lbl) => {
      const fel = lbl.dataset.fel;
      const stare = lbl.querySelector(".d-fis__stare");
      lbl.querySelector("input[type=file]").addEventListener("change", async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        stare.className = "d-fis__stare";
        stare.textContent = "se pregătește…";
        try {
          await ciorna();
          const mic = await micsoreaza(file);
          if (mic.size > 5 * 1024 * 1024) throw new Error("Fișierul depășește 5 MB chiar și micșorat.");
          stare.textContent = "se încarcă…";
          const r = await fetch(F, { method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ cod: cod(), actiune: "fisier", ciornaId, fel,
              nume: file.name, tip: mic.type || file.type, continut: await catreBase64(mic) }) });
          const d = await r.json().catch(() => ({}));
          if (!r.ok) throw new Error(d.eroare || "Încărcare eșuată.");
          incarcate[fel] = true;
          stare.className = "d-fis__stare is-ok";
          stare.textContent = "✓ " + Math.round(d.marime / 1024) + " KB";
        } catch (err) {
          incarcate[fel] = false;
          stare.className = "d-fis__stare is-rau";
          stare.textContent = err.message;
        }
      });
    });

    // —— Depunerea ——
    function strange() {
      const val = (n) => (g(n) ? g(n).value.trim() : "");
      const parinte = (p) => ({
        nume: val(p + ".nume"), pedigree: val(p + ".pedigree"), microcip: val(p + ".microcip"),
        dataNasterii: val(p + ".dataNasterii"), palmares: val(p + ".palmares"),
        proprietar: val(p + ".proprietar"), membruAsociatiei: val(p + ".membruAsociatiei"),
        adresa: val(p + ".adresa"), email: val(p + ".email"), telefon: val(p + ".telefon"),
      });
      const pui = citesteRanduri().map((x) => ({
        nume: x.nume, sex: x.sex, culoare: x.culoare, varietate: x.varietate,
        tipPar: x.tipPar, identificare: x.identificare,
        cumparator: { nume: x.cnume, adresa: x.cadresa, localitate: x.clocalitate,
          judet: x.cjudet, codPostal: x.ccodPostal, tara: x.ctara, telefon: x.ctelefon, email: x.cemail },
      }));
      return {
        cod: cod(), actiune: "depune", ciornaId,
        rasa: val("rasa"), varietate: val("varietate"),
        dataMontei: val("dataMontei"), dataFatarii: val("dataFatarii"),
        nascutiM: Number(val("nascutiM")) || 0, nascutiF: Number(val("nascutiF")) || 0,
        ramasiM: Number(val("ramasiM")) || 0, ramasiF: Number(val("ramasiF")) || 0,
        mascul: parinte("mascul"), femela: parinte("femela"), pui,
        consimtaminte: { adn: g("c.adn").checked, predare60: g("c.predare60").checked, gdpr: g("c.gdpr").checked },
      };
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      eroare.hidden = true;
      const lipsa = Object.keys({ "pedigree-mascul": 1, "pedigree-femela": 1, "drept-monta": 1, "plata": 1 })
        .filter((f) => !incarcate[f]);
      if (lipsa.length || !ciornaId) {
        eroare.hidden = false;
        eroare.textContent = "Încarcă toate cele patru piese ale dosarului înainte de depunere.";
        eroare.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }
      const btn = form.querySelector("button[type=submit]");
      btn.disabled = true; btn.textContent = "Se depune…";
      try {
        const r = await fetch(F, { method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify(strange()) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.eroare || "Depunerea a eșuat.");
        form.hidden = true;
        const gata = document.getElementById("d-gata");
        gata.hidden = false;
        document.getElementById("d-serie").textContent = d.serie;
        document.getElementById("d-gata-text").textContent =
          (d.pesteTermen ? "Dosarul e marcat peste termen — registratura decide dacă poate fi soluționat. " : "") +
          (d.emailTrimis ? "Confirmarea a plecat pe e-mail. " : "Notează numărul: confirmarea pe e-mail nu a putut fi trimisă acum. ") +
          "Numărul de cuib WDF se completează de registratură, după verificarea dosarului.";
        gata.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (err) {
        btn.disabled = false; btn.textContent = "Depune declarația";
        eroare.hidden = false;
        eroare.textContent = err.message;
        eroare.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });
  })();
</script>

