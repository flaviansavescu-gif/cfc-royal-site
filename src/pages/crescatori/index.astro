---
// /crescatori/ — spațiul membrului: de aici se depun declarațiile și se urmărește stadiul lor.
//
// Dreptul de a depune vine din calitatea de membru cu cotizația la zi, nu din afix.
// Condițiile de fond ale depunerii (le impune formularul, faza următoare le va aplica):
//   • DMF-ul se depune DOAR de proprietarul femelei montate;
//   • femela trebuie să aibă dreptul de montă câștigat — minimum un calificativ „Bun";
//   • până când expozițiile trec prin managerul propriu, dovada acestui drept se încarcă
//     (fișa de arbitraj sau imaginea din carnetul de performanță); după aceea, verificarea
//     se va putea face automat din rezultatele înregistrate.
import RegistruLayout from "../../layouts/RegistruLayout.astro";
---

<RegistruLayout title="Spațiul membrului" allow={["membru"]}>
  <p class="c-eyebrow">Registrul genealogic · spațiul membrului</p>
  <h1 class="c-title" id="c-nume">Membru</h1>
  <p class="c-sub" id="c-detalii"></p>

  <p class="c-cotizatie" id="c-cotizatie" hidden></p>

  <div class="c-card">
    <div>
      <strong>📋 Declarație de Montă și Fătare</strong>
      <p>Se depune în cel mult <strong>90 de zile de la data nașterii puilor</strong>, de către
      <strong>proprietarul femelei montate</strong>. Dosarul cuprinde declarația, copiile digitale ale
      pedigree-urilor ambilor părinți, <strong>dovada dreptului de montă al femelei</strong> și dovada plății.
      La depunere primești pe e-mail numărul de înregistrare al cuibului.</p>
    </div>
    <a class="btn btn--primary" href="/crescatori/dmf/" id="c-depune">Depune o declarație →</a>
    <a class="btn" href="/crescatori/sanatate/" id="c-sanatate" style="margin-left:.5rem">🩺 Sănătatea câinilor →</a>
    <a class="btn" href="/crescatori/cuiburi/" id="c-cuiburi" style="margin-left:.5rem">🐾 Anunțuri de cuiburi →</a>
  </div>

  <h2 class="c-h2">Canisa mea</h2>
  {/* Toate stările stau în șablon, scrise de Astro (stilurile sunt legate de atributul
      pus doar pe ce desenează el); JavaScript-ul doar arată și ascunde. */}
  <div id="k-incarc" class="c-gol">Se încarcă…</div>

  <div id="k-canisa" class="c-canisa" hidden>
    <p>Afixul canisei tale: <strong id="k-afix"></strong><span id="k-nr"></span></p>
    <p class="c-mic">Afixul se completează singur pe declarațiile de montă și fătare și se
    trece pe certificatele exemplarelor canisei.</p>
  </div>

  <div id="k-cerere" class="c-cerere" hidden>
    <p class="c-mic">Cererea ta din <span id="k-cand"></span>, cu variantele
    <strong id="k-variante"></strong>, este <strong>în verificare la registratură</strong>.
    Hotărârea vine pe e-mail.</p>
  </div>

  <div id="k-respinsa" class="c-respinsa" hidden>
    <p class="c-mic">Ultima cerere a fost <strong>respinsă</strong>: <span id="k-motiv"></span>.
    Poți depune una nouă, cu alte variante.</p>
  </div>

  <form id="k-form" class="c-kform" hidden>
    <p class="c-mic">Nu ai încă o canisă înregistrată. Propune <strong>până la trei variante de
    afix, în ordinea preferinței</strong> — registratura verifică unicitatea și îți răspunde pe
    e-mail. Doar prima variantă e obligatorie.</p>
    <div class="c-kgrid">
      <label>Varianta 1 <b class="c-req">*</b><input name="afix1" required maxlength="40" /></label>
      <label>Varianta 2 <span class="c-opt">(opțional)</span><input name="afix2" maxlength="40" /></label>
      <label>Varianta 3 <span class="c-opt">(opțional)</span><input name="afix3" maxlength="40" /></label>
    </div>
    <button class="btn btn--primary" type="submit" id="k-trimite">Cere înregistrarea canisei</button>
    <p class="c-kmesaj" id="k-mesaj" hidden></p>
  </form>

  <h2 class="c-h2">Declarațiile mele</h2>
  <ul class="c-declaratii" id="c-declaratii"><li class="c-gol">Se încarcă…</li></ul>

  <div class="c-ajutor">
    <p><strong>Dreptul de montă al femelei.</strong> Femela trebuie să fi obținut minimum un
    calificativ <strong>„Bun"</strong> într-o expoziție. Până când expozițiile trec prin registrul
    propriu, dovada se încarcă odată cu declarația: fișa de arbitraj sau imaginea din carnetul de
    performanță.</p>
    <p><strong>Proprietarul masculului</strong> nu are nevoie de cod: după depunere primește pe
    e-mail un link unic prin care confirmă monta — inclusiv dacă e dintr-o altă asociație sau din
    străinătate.</p>
    <p>Codul tău este personal și nu se împarte: pe el se înregistrează declarațiile depuse.</p>
  </div>
</RegistruLayout>

<script is:inline>
  (function () {
    let r = null;
    try { r = JSON.parse(localStorage.getItem("cfcrRegistru") || "null"); } catch (e) {}
    if (!r) return;
    if (r.nume) document.getElementById("c-nume").textContent = r.nume;
    const d = [r.afix, r.nrAfix].filter(Boolean).join(" · ");
    document.getElementById("c-detalii").textContent = d || "Membru fără canisă înregistrată";

    // Cotizația restantă nu blochează intrarea, dar oprește depunerea — omul trebuie să
    // afle de ce, nu să descopere la trimitere.
    const cot = document.getElementById("c-cotizatie");
    const dataRo = (s) => { const x = new Date(s); return isNaN(x) ? String(s || "") : x.toLocaleDateString("ro-RO"); };
    if (r.cotizatiePana) {
      cot.hidden = false;
      if (r.cotizatieLaZi) {
        cot.className = "c-cotizatie is-ok";
        cot.textContent = "Cotizație achitată până la " + dataRo(r.cotizatiePana) + ".";
      } else {
        cot.className = "c-cotizatie is-expirat";
        cot.textContent = "⚠ Cotizația a expirat la " + dataRo(r.cotizatiePana) +
          ". Până la reînnoire nu poți depune declarații noi. Scrie secretariatului la contact@cfc-royal.ro.";
        // Butonul rămâne vizibil, dar nu mai duce nicăieri: mai bine află aici de ce,
        // decât să completeze tot formularul și să fie oprit la trimitere.
        const b = document.getElementById("c-depune");
        b.setAttribute("aria-disabled", "true");
        b.classList.add("is-oprit");
        b.addEventListener("click", (e) => e.preventDefault());
      }
    }

    // —— Canisa mea: starea vine de la server, nu din ce ține minte browserul ——
    // `r.afix` din localStorage poate fi vechi de la intrarea trecută; între timp
    // registratura poate să fi aprobat cererea. Sursa de adevăr e serverul.
    (function () {
      const arata = (id) => { for (const x of ["k-incarc", "k-canisa", "k-cerere", "k-respinsa", "k-form"]) document.getElementById(x).hidden = x !== id; };
      const postK = (b) => fetch("/.netlify/functions/registru-canise", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.assign({ cod: localStorage.getItem("cfcrRegistruCod") || "" }, b)),
      });
      const dataRo = (s) => { const x = new Date(s); return isNaN(x) ? String(s || "") : x.toLocaleDateString("ro-RO"); };

      function afiseaza(d) {
        if (d.canisa) {
          document.getElementById("k-afix").textContent = d.canisa.afix;
          document.getElementById("k-nr").textContent = d.canisa.nrAfix ? " · nr. " + d.canisa.nrAfix : "";
          arata("k-canisa");
          return;
        }
        if (d.cerere && d.cerere.stare === "in-asteptare") {
          document.getElementById("k-cand").textContent = dataRo(d.cerere.creat);
          document.getElementById("k-variante").textContent = (d.cerere.variante || []).join(" · ");
          arata("k-cerere");
          return;
        }
        if (d.cerere && d.cerere.stare === "respinsa") {
          document.getElementById("k-motiv").textContent = d.cerere.motiv || "fără motiv consemnat";
          arata("k-respinsa");
          document.getElementById("k-form").hidden = false;   // respinsă = poate încerca din nou
          return;
        }
        arata("k-form");
      }

      postK({ actiune: "starea-mea" })
        .then((res) => res.json())
        .then(afiseaza)
        .catch(() => { document.getElementById("k-incarc").textContent = "Nu am putut încărca starea canisei."; });

      document.getElementById("k-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const f = e.target;
        const b = document.getElementById("k-trimite");
        const msg = document.getElementById("k-mesaj");
        b.disabled = true; b.textContent = "Se trimite…"; msg.hidden = true;
        try {
          const res = await postK({
            actiune: "cerere",
            afix1: f.afix1.value, afix2: f.afix2.value, afix3: f.afix3.value,
          });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(d.eroare || "Cererea nu a putut fi trimisă.");
          document.getElementById("k-cand").textContent = "astăzi";
          document.getElementById("k-variante").textContent = [f.afix1.value, f.afix2.value, f.afix3.value].filter((x) => x.trim()).join(" · ");
          arata("k-cerere");
        } catch (err) {
          b.disabled = false; b.textContent = "Cere înregistrarea canisei";
          msg.hidden = false; msg.textContent = err.message;
        }
      });
    })();

    // —— Declarațiile depuse ——
    const lista = document.getElementById("c-declaratii");
    const ETICHETE = { depus: "Depusă", "in-verificare": "În verificare", aprobat: "Aprobată", respins: "Respinsă" };
    const cod = () => localStorage.getItem("cfcrRegistruCod") || "";
    const post = (b) => fetch("/.netlify/functions/registru-dmf", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify(Object.assign({ cod: cod() }, b)),
    });

    // Confirmarea proprietarului masculului ține locul semnăturii de pe formularul
    // tipărit. Cât timp nimeni n-a răspuns, crescătorul poate retrimite cererea și —
    // O SINGURĂ DATĂ — poate corecta adresa: adresa greșită e cel mai probabil motiv
    // pentru care un dosar rămâne blocat la nesfârșit.
    function randConfirmare(x) {
      const box = document.createElement("div");
      box.className = "c-conf";
      const eticheta = document.createElement("span");
      eticheta.className = "c-conf__stare is-" + (x.confirmare || "asteptare");
      eticheta.textContent = {
        asteptare: "⏳ Așteaptă confirmarea proprietarului masculului",
        confirmat: "✓ Monta a fost confirmată de proprietarul masculului",
        refuzat: "⚠ Proprietarul masculului nu a confirmat — registratura analizează",
        alternativ: "✓ Confirmare acceptată de registratură pe baza dovezii semnate",
      }[x.confirmare] || x.confirmare;
      box.appendChild(eticheta);

      if (x.confirmare !== "asteptare") return box;

      const adresa = document.createElement("span");
      adresa.className = "c-conf__adresa";
      adresa.textContent = "trimisă la " + (x.confirmareEmail || "—");
      box.appendChild(adresa);

      const actiuni = document.createElement("div");
      actiuni.className = "c-conf__actiuni";
      const camp = document.createElement("input");
      camp.type = "email";
      camp.placeholder = x.adresaCorectata ? "adresa a fost deja corectată" : "altă adresă (o singură dată)";
      camp.disabled = !!x.adresaCorectata;
      const buton = document.createElement("button");
      buton.className = "btn btn--small btn--outline";
      buton.textContent = "Retrimite cererea";
      buton.addEventListener("click", async () => {
        buton.disabled = true; buton.textContent = "Se trimite…";
        try {
          const r = await post({ actiune: "confirmare-retrimite", id: x.id, emailNou: camp.value.trim() });
          const d = await r.json().catch(() => ({}));
          if (!r.ok) throw new Error(d.eroare || "Nu am putut retrimite.");
          buton.textContent = d.trimis ? "✓ Trimisă la " + d.email : "Înregistrată, dar e-mailul nu a plecat";
        } catch (e) {
          buton.disabled = false; buton.textContent = "Retrimite cererea";
          alert(e.message);
        }
      });
      actiuni.append(camp, buton);
      box.appendChild(actiuni);
      return box;
    }
    post({ actiune: "mele" })
      .then((res) => res.json())
      .then((d) => {
        lista.textContent = "";
        const arr = d.declaratii || [];
        if (!arr.length) {
          const li = document.createElement("li");
          li.className = "c-gol";
          li.textContent = "Nicio declarație depusă încă.";
          lista.appendChild(li);
          return;
        }
        for (const x of arr) {
          const li = document.createElement("li");
          li.className = "c-decl";
          const cap = document.createElement("div");
          cap.className = "c-decl__cap";
          const serie = document.createElement("strong");
          serie.className = "c-decl__serie";
          serie.textContent = x.serie;
          const det = document.createElement("span");
          det.className = "c-decl__det";
          det.textContent = [x.rasa, "fătare " + dataRo(x.dataFatarii), x.pui + " pui"].join(" · ");
          const st = document.createElement("span");
          st.className = "c-decl__stare";
          st.textContent = ETICHETE[x.stare] || x.stare;
          cap.append(serie, det, st);
          if (x.pesteTermen) {
            const t = document.createElement("span");
            t.className = "c-decl__termen";
            t.textContent = "peste termen";
            cap.appendChild(t);
          }
          li.appendChild(cap);
          li.appendChild(randConfirmare(x));
          lista.appendChild(li);
        }
      })
      .catch(() => {
        lista.textContent = "";
        const li = document.createElement("li");
        li.className = "c-gol";
        li.textContent = "Nu am putut încărca lista declarațiilor.";
        lista.appendChild(li);
      });
  })();
</script>

<style>
  .c-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; color: var(--color-accent-dark); margin: 0; }
  .c-title { font-family: var(--font-serif); color: var(--color-primary); margin: 0.35rem 0 0.2rem; }
  .c-sub { color: var(--color-text-muted); margin-top: 0; }
  :global(.c-cotizatie) { max-width: 46rem; padding: 0.7rem 1rem; border-radius: var(--radius); font-size: 0.9rem; font-weight: 600; }
  :global(.c-cotizatie[hidden]) { display: none; }
  :global(.c-cotizatie.is-ok) { background: #eef5f0; border: 1px solid var(--color-primary); color: var(--color-primary); }
  :global(.c-cotizatie.is-expirat) { background: #f9efef; border: 1px solid #8c1d2f; color: #8c1d2f; }
  .c-h2 { font-family: var(--font-serif); color: var(--color-primary); margin: 2.25rem 0 0.5rem;
    font-size: 1.3rem; border-bottom: 2px solid var(--color-accent); padding-bottom: 0.3rem; }
  .c-card { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; flex-wrap: wrap;
    margin-top: 1.5rem; padding: 1.1rem 1.4rem;
    background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--radius); }
  .c-card p { margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--color-text-muted); max-width: 36rem; }
  .c-curand { flex: 0 0 auto; font-size: 0.8rem; color: var(--color-accent-dark);
    border: 1px solid var(--color-accent); border-radius: 999px; padding: 0.3rem 0.8rem; }
  :global(.c-gol) { color: var(--color-text-muted); font-style: italic; }
  .c-declaratii { list-style: none; padding: 0; display: grid; gap: 0.5rem; max-width: 52rem; }
  :global(.c-decl) { display: grid; gap: 0.6rem;
    padding: 0.7rem 0.9rem; border: 1px solid var(--color-border); border-radius: var(--radius); }
  :global(.c-decl__cap) { display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap; }
  :global(.c-conf) { display: grid; gap: 0.4rem; border-top: 1px dashed var(--color-border); padding-top: 0.5rem; }
  :global(.c-conf__stare) { font-size: 0.85rem; font-weight: 600; }
  :global(.c-conf__stare.is-asteptare) { color: var(--color-accent-dark); }
  :global(.c-conf__stare.is-confirmat),
  :global(.c-conf__stare.is-alternativ) { color: var(--color-primary); }
  :global(.c-conf__stare.is-refuzat) { color: #8c1d2f; }
  :global(.c-conf__adresa) { font-size: 0.82rem; color: var(--color-text-muted); }
  :global(.c-conf__actiuni) { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
  :global(.c-conf__actiuni input) { padding: 0.35rem 0.6rem; border: 1px solid var(--color-border);
    border-radius: var(--radius); font: inherit; font-size: 0.85rem; min-width: 16rem; }
  :global(.c-decl__serie) { font-family: var(--font-mono, monospace); color: var(--color-primary); }
  :global(.c-decl__det) { color: var(--color-text-muted); font-size: 0.88rem; }
  :global(.c-decl__stare) { margin-left: auto; font-size: 0.8rem; border: 1px solid var(--color-accent);
    color: var(--color-accent-dark); border-radius: 999px; padding: 0.2rem 0.7rem; }
  :global(.c-decl__termen) { font-size: 0.8rem; border: 1px solid #8c1d2f; color: #8c1d2f;
    border-radius: 999px; padding: 0.2rem 0.7rem; }
  :global(.btn.is-oprit) { opacity: 0.5; cursor: not-allowed; }
  .c-mic { font-size: 0.88rem; color: var(--color-text-muted); margin: 0.3rem 0; }
  .c-canisa,
  .c-cerere,
  .c-respinsa,
  .c-kform { max-width: 46rem; padding: 0.9rem 1.1rem;
    border: 1px solid var(--color-border); border-radius: var(--radius); }
  .c-canisa { background: #eef5f0; border-color: var(--color-primary); }
  .c-canisa p:first-child { margin: 0; color: var(--color-primary); }
  .c-respinsa { border-color: #8c1d2f; background: #f9efef; }
  .c-kform[hidden],
  .c-canisa[hidden],
  .c-cerere[hidden],
  .c-respinsa[hidden] { display: none; }
  .c-kgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.7rem; margin: 0.7rem 0 0.9rem; }
  .c-kgrid label { display: grid; gap: 0.25rem; font-size: 0.85rem; font-weight: 600; color: var(--color-primary); }
  .c-kgrid input { padding: 0.45rem 0.6rem; border: 1px solid var(--color-border); border-radius: var(--radius); font: inherit; }
  .c-req { color: #8c1d2f; }
  .c-opt { font-weight: 400; color: var(--color-text-muted); }
  .c-kmesaj { margin-top: 0.6rem; font-size: 0.88rem; font-weight: 600; color: #8c1d2f; }
  .c-ajutor { margin-top: 2rem; border-top: 1px solid var(--color-border); padding-top: 1rem; max-width: 44rem; }
  .c-ajutor p { font-size: 0.88rem; color: var(--color-text-muted); }
</style>
