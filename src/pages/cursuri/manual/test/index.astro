---
// /cursuri/manual/test/ — testul manualului de studiu individual.
// Aceeași mecanică cu testele de modul: întrebările stau aici (fără răspunsuri),
// corectarea se face pe server, în `test-modul` (cheia „manual-studiu”).
import CursuriLayout from "../../../../layouts/CursuriLayout.astro";
import { MANUAL, PRAG_PROMOVARE } from "../../../../data/cursuri";
---

<CursuriLayout title="Testul manualului" allow={["lector", "acces"]} candidat>
  <p class="m-inapoi"><a href="/cursuri/manual/">← Înapoi la manual</a></p>
  <p class="m-eyebrow">Studiu individual</p>
  <h1 class="m-title">Testul manualului</h1>
  <p class="m-obiectiv">{MANUAL.titlu} — verificarea celor 8 module ale manualului.</p>

  <section class="test" id="test">
    <p class="test__info">
      {MANUAL.intrebari.length} întrebări grilă · un singur răspuns corect per întrebare · prag de
      promovare {PRAG_PROMOVARE}%. Rezultatul se afișează imediat și este transmis secretariatului.
    </p>

    <form id="test-form">
      <div class="test__field" id="test-nume-camp">
        <label for="nume">Numele și prenumele tău</label>
        <input id="nume" name="nume" type="text" placeholder="ex. Ion Popescu" />
      </div>
      <p class="test__ident" id="test-ident" hidden></p>

      {MANUAL.intrebari.map((q, qi) => (
        <fieldset class="test__q">
          <legend><span class="test__qnr">{qi + 1}.</span> {q.text}</legend>
          {q.optiuni.map((opt, oi) => (
            <label class="test__opt">
              <input type="radio" name={`q${qi}`} value={oi} required />
              <span>{opt}</span>
            </label>
          ))}
        </fieldset>
      ))}

      <button class="btn btn--primary test__submit" type="submit">Trimite testul</button>
    </form>

    <div class="test__rezultat" id="test-rezultat" hidden></div>
  </section>
</CursuriLayout>

<script is:inline define:vars={{ slug: MANUAL.slug, nrIntrebari: MANUAL.intrebari.length }}>
  const form = document.getElementById("test-form");
  const rez = document.getElementById("test-rezultat");
  const numeInput = document.getElementById("nume");

  // Candidat cu cod individual: îl cunoaștem după nume, nu-i mai cerem să-l scrie.
  let candidat = null;
  try { candidat = JSON.parse(localStorage.getItem("cfcrCandidat") || "null"); } catch (e) {}
  if (candidat && candidat.id) {
    const camp = document.getElementById("test-nume-camp");
    if (camp) camp.hidden = true;
    const ident = document.getElementById("test-ident");
    if (ident) { ident.textContent = "Susții testul ca: " + candidat.nume; ident.hidden = false; }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const numeScris = numeInput ? numeInput.value.trim() : "";
    if (!(candidat && candidat.id) && numeScris.length < 3) { numeInput.focus(); return; }
    const btn = form.querySelector("button[type=submit]");
    btn.disabled = true;
    btn.textContent = "Se corectează…";
    const raspunsuri = [];
    for (let i = 0; i < nrIntrebari; i++) {
      const ales = form.querySelector(`input[name=q${i}]:checked`);
      raspunsuri.push(ales ? Number(ales.value) : -1);
    }
    try {
      var codPlatforma = "";
      try { codPlatforma = localStorage.getItem("cfcrAccesCod") || ""; } catch (e) {}
      const res = await fetch("/.netlify/functions/test-modul", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          modul: slug,
          id: candidat && candidat.id ? candidat.id : undefined,
          cod: codPlatforma || undefined,
          nume: numeScris,
          raspunsuri,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.eroare || "Eroare la corectare.");
      // Fără cod individual, progresul rămâne pe acest dispozitiv; cu cod individual
      // îl salvează funcția, pe server.
      if (!(candidat && candidat.id)) {
        try {
          const p = JSON.parse(localStorage.getItem("cfcrProgres") || "{}");
          const vechi = p[slug];
          if (!vechi || data.procent > vechi.procent || (data.promovat && !vechi.promovat)) {
            p[slug] = { procent: data.procent, promovat: data.promovat, data: new Date().toISOString().slice(0, 10) };
            localStorage.setItem("cfcrProgres", JSON.stringify(p));
          }
        } catch (e2) {}
      }
      rez.hidden = false;
      rez.className = "test__rezultat " + (data.promovat ? "is-pass" : "is-fail");
      rez.innerHTML =
        "<strong>" + (data.promovat ? "Felicitări — test promovat! 🎉" : "Test nepromovat.") + "</strong>" +
        "<p>Scor: <b>" + data.corecte + " / " + data.total + "</b> (" + data.procent + "%).</p>" +
        (data.gresite && data.gresite.length
          ? "<p class='test__gresite'>Întrebări greșite: " + data.gresite.join(", ") +
            ". Reia paginile corespunzătoare din manual și încearcă din nou.</p>"
          : "");
      rez.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch (err) {
      rez.hidden = false;
      rez.className = "test__rezultat is-fail";
      rez.innerHTML = "<strong>Nu am putut trimite testul.</strong><p>" + err.message + "</p>";
    } finally {
      btn.disabled = false;
      btn.textContent = "Trimite testul";
    }
  });
</script>

<style>
  .m-inapoi { margin: 0 0 0.75rem; font-size: 0.9rem; }
  .m-inapoi a { color: var(--color-accent-dark); }
  .m-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; color: var(--color-accent-dark); margin: 0; }
  .m-title { font-family: var(--font-serif); color: var(--color-primary); margin: 0.35rem 0 0.25rem; }
  .m-obiectiv { color: var(--color-text-muted); max-width: 46rem; margin-top: 0; }

  .test { margin-top: 1.5rem; }
  .test__info { color: var(--color-text-muted); max-width: 46rem; }
  .test__field { margin: 1.25rem 0; max-width: 26rem; }
  .test__field label { display: block; font-weight: 600; margin-bottom: 0.35rem; }
  .test__field input { width: 100%; padding: 0.65rem 0.9rem; border: 1px solid var(--color-border); border-radius: var(--radius); font-size: 1rem; }
  .test__ident { margin: 1.25rem 0; font-weight: 600; color: var(--color-primary); }
  .test__q { border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); padding: 1rem 1.25rem; margin: 0 0 1rem; }
  .test__q legend { font-weight: 600; padding: 0 0.4rem; }
  .test__qnr { color: var(--color-accent-dark); }
  .test__opt { display: flex; gap: 0.6rem; align-items: baseline; padding: 0.35rem 0.25rem; cursor: pointer; }
  .test__opt:hover { background: var(--color-surface-alt); border-radius: 6px; }
  .test__submit { margin-top: 0.5rem; }
  .test__rezultat { margin-top: 1.5rem; padding: 1.25rem 1.5rem; border-radius: var(--radius); border: 1px solid var(--color-border); }
  .test__rezultat.is-pass { background: #eef5f0; border-color: var(--color-primary); }
  .test__rezultat.is-fail { background: #f9efef; border-color: #8c1d2f; }
  .test__rezultat p { margin: 0.4rem 0 0; }
  .test__gresite { color: var(--color-text-muted); font-size: 0.9rem; }
</style>
