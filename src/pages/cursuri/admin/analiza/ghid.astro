---
// /cursuri/admin/analiza/ghid/ — ghid + exemplu complet pentru lectori: cum se creează
// un exercițiu în Judge Comparison Room. Pagină statică (model), accesibilă tuturor lectorilor.
import CursuriLayout from "../../../../layouts/CursuriLayout.astro";
const allow = ["lector"];
---

<CursuriLayout title="Ghid: cum creezi un exercițiu" allow={allow}>
  <p class="g-actiuni">
    <a class="btn btn--outline btn--small" href="/cursuri/admin/analiza/">← Sesiunile de analiză</a>
    <a class="btn btn--primary btn--small" href="/cursuri/admin/analiza/">+ Creează un exercițiu</a>
  </p>
  <p class="g-eyebrow">Judge Comparison Room · Ghid pentru lectori</p>
  <h1 class="g-title">Cum creezi un exercițiu de evaluare</h1>
  <p class="g-sub">Cursanții analizează aceeași resursă, își trimit evaluarea individual, apoi o compară cu baremul tău. Mai jos: pașii și un exemplu complet, de la configurare până la comparație.</p>

  <h2 class="g-h2">Pașii, pe scurt</h2>
  <ol class="g-pasi">
    <li><strong>Creează sesiunea</strong> — „+ Sesiune nouă", dă-i un titlu.</li>
    <li><strong>Metadate</strong> — rasă, nivel, obiective, eventual versiunea standardului WDF.</li>
    <li><strong>Rubrică</strong> — criteriile de observație (ex. Cap, Corp, Blană, Mișcare).</li>
    <li><strong>Exemplare</strong> — adaugă 2+ dacă vrei și clasament; lasă gol pentru un singur câine.</li>
    <li><strong>Imagini</strong> — urcă fotografia (JPEG/PNG/WebP, privată).</li>
    <li><strong>Barem</strong> — evaluarea ta de referință: calificativ, defecte cu gravitate, observații pe criterii. Rămâne <em>ascuns</em> cursanților.</li>
    <li><strong>Participanți</strong> — bifează candidații care primesc exercițiul.</li>
    <li><strong>Publică</strong> — apare instant în „Sala de analiză" a candidaților.</li>
    <li><strong>Închide</strong> sesiunea (sau „Deblochează baremul") când vrei ca ei să vadă comparația.</li>
    <li><strong>Rezultate</strong> — vezi comparația de grup, exporți CSV și dai feedback.</li>
  </ol>

  <h2 class="g-h2">Exemplu complet</h2>
  <p class="g-hint">Un exercițiu configurat, un răspuns de cursant și comparația rezultată — ca model.</p>

  <div class="g-card">
    <p class="g-lbl">1 · Exercițiul (ce pregătește lectorul)</p>
    <p class="g-strong">Evaluare de tipicitate — Ciobănesc Românesc Carpatin</p>
    <p class="g-meta">Grupa 1 · nivel începător · standard WDF</p>
    <div class="g-photo">🖼️ fotografia câinelui de evaluat</div>
    <p class="g-lbl2">Rubrică</p>
    <p><span class="g-chip">Cap</span><span class="g-chip">Corp</span><span class="g-chip">Blană</span><span class="g-chip">Mișcare</span></p>
  </div>

  <div class="g-card g-card--ref">
    <p class="g-lbl">2 · Baremul de referință <span class="g-lock">🔒 ascuns candidatului</span></p>
    <table class="g-tab">
      <tr><td>Calificativ</td><td><strong>Very Good</strong></td></tr>
      <tr><td>Stop slab marcat</td><td>defect <em>minor</em></td></tr>
      <tr><td>Unghiulație posterioară insuficientă</td><td>defect <em>grav</em></td></tr>
      <tr><td>Criterii comentate</td><td>Cap, Corp</td></tr>
    </table>
  </div>

  <div class="g-card">
    <p class="g-lbl">3 · Răspunsul unui cursant</p>
    <table class="g-tab">
      <tr><td>Calificativ propus</td><td>Good</td></tr>
      <tr><td>Defecte semnalate</td><td>Stop slab (minor) · Linia superioară moale (minor)</td></tr>
      <tr><td>Criterii comentate</td><td>Cap</td></tr>
    </table>
  </div>

  <div class="g-card g-card--out">
    <p class="g-lbl">4 · Comparația generată automat</p>
    <div class="g-row"><span>Calificativ: Good vs Very Good</span><span class="g-b g-warn">o treaptă diferență</span></div>
    <div class="g-row"><span>Stop slab marcat</span><span class="g-b g-ok">acord (minor)</span></div>
    <div class="g-row"><span>Unghiulație posterioară insuficientă</span><span class="g-b g-bad">omis din barem</span></div>
    <div class="g-row"><span>Linia superioară moale</span><span class="g-b g-neu">suplimentar</span></div>
    <div class="g-row"><span>Criteriul „Corp"</span><span class="g-b g-bad">neabordat</span></div>
    <p class="g-hint" style="margin-top:.75rem">La 2+ câini se adaugă acordul la clasament (Spearman / Kendall). Comparația de grup îți arată distribuția calificativelor și defectele frecvent omise de întreaga grupă.</p>
  </div>

  <p class="g-actiuni">
    <a class="btn btn--primary" href="/cursuri/admin/analiza/">Creează primul tău exercițiu →</a>
  </p>
</CursuriLayout>

<style>
  .g-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; color: var(--color-accent-dark); margin: 0; }
  .g-title { font-family: var(--font-serif); color: var(--color-primary); margin: 0.35rem 0 0.5rem; }
  .g-sub { color: var(--color-text-muted); max-width: 48rem; }
  .g-actiuni { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 1.25rem 0; }
  .g-h2 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.3rem; border-bottom: 2px solid var(--color-accent); padding-bottom: 0.35rem; margin: 2rem 0 0.75rem; }
  .g-hint { color: var(--color-text-muted); font-size: 0.9rem; }
  .g-pasi { max-width: 48rem; display: grid; gap: 0.4rem; padding-left: 1.2rem; }
  .g-pasi strong { color: var(--color-primary); }
  .g-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem 1.25rem; margin-bottom: 0.85rem; }
  .g-card--ref { border-left: 4px solid var(--color-accent); }
  .g-card--out { border-left: 4px solid var(--color-primary); }
  .g-lbl { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-accent-dark); margin: 0 0 0.6rem; }
  .g-lbl2 { font-size: 0.8rem; color: var(--color-text-muted); margin: 0.9rem 0 0.3rem; }
  .g-lock { text-transform: none; letter-spacing: 0; color: var(--color-text-muted); font-weight: 400; margin-left: 0.5rem; }
  .g-strong { font-weight: 600; color: var(--color-primary); margin: 0 0 0.15rem; }
  .g-meta { font-size: 0.85rem; color: var(--color-text-muted); margin: 0 0 0.75rem; }
  .g-photo { background: var(--color-surface-alt); border: 1px dashed var(--color-border); border-radius: var(--radius); height: 6rem; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); font-size: 0.9rem; }
  .g-chip { display: inline-block; font-size: 0.78rem; padding: 0.2rem 0.6rem; border-radius: 999px; margin: 0 0.4rem 0.4rem 0; background: var(--color-surface-alt); border: 1px solid var(--color-border); }
  .g-tab { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .g-tab td { padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .g-tab td:first-child { color: var(--color-text-muted); width: 45%; }
  .g-tab tr:last-child td { border-bottom: 0; }
  .g-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--color-border); }
  .g-row:last-of-type { border-bottom: 0; }
  .g-b { font-size: 0.75rem; padding: 0.15rem 0.6rem; border-radius: 999px; white-space: nowrap; border: 1px solid; }
  .g-ok { background: #eaf5ec; border-color: #b6dcbf; color: #1f5130; }
  .g-warn { background: #fdf4e3; border-color: #e6cf9a; color: #8a6d1f; }
  .g-bad { background: #fbeaec; border-color: #e2b6bd; color: #8c1d2f; }
  .g-neu { background: var(--color-surface-alt); border-color: var(--color-border); color: var(--color-text-muted); }
  .btn--small { font-size: 0.85rem; padding: 0.45rem 0.9rem; }
</style>
