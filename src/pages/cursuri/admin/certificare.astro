---
// /cursuri/admin/certificare/ — administrarea certificării:
//  A) autorizarea candidaților pe grupe WDF (1–10);
//  B) starea examenului final + resetarea dreptului de examinare.
import CursuriLayout from "../../../layouts/CursuriLayout.astro";
import { GRUPE_WDF } from "../../../data/grupe-wdf";
---

<CursuriLayout title="Certificare — administrare" allow={["admin"]}>
  <p class="c-crumb"><a href="/cursuri/admin/">← Panoul platformei</a></p>
  <p class="c-eyebrow">Administrare · certificare</p>
  <h1 class="c-title">Certificarea arbitrilor</h1>
  <p class="c-sub">
    Autorizează candidații pe grupele WDF pentru care s-au format și gestionează examenul final.
    Denumirile grupelor sunt cele oficiale World Dog Federation.
  </p>

  <p class="c-linkpublic"><a href="/arbitri/" target="_blank" rel="noopener">🌐 Vezi registrul public al arbitrilor ↗</a> — arbitrii bifați „Public” apar automat acolo, alături de colegiul editorial.</p>

  <h2 class="c-h2">A. Autorizarea pe grupe WDF</h2>
  <p class="c-legenda">
    {GRUPE_WDF.map((g) => (<span class="c-lg"><strong>{g.nr}</strong> = {g.ro}</span>))}
  </p>
  <div class="c-matrice-wrap">
    <table class="c-matrice" id="c-matrice">
      <thead>
        <tr>
          <th class="c-mx-cand">Candidat</th>
          {GRUPE_WDF.map((g) => (<th title={g.ro}>Gr. {g.nr}</th>))}
          <th title="Apare în registrul public de arbitri">Public</th>
          <th>Localitate</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="c-matrice-body">
        <tr><td colspan={GRUPE_WDF.length + 4} class="c-mx-empty">Se încarcă…</td></tr>
      </tbody>
    </table>
  </div>

  <h2 class="c-h2">B. Examenul final</h2>
  <p class="c-note">
    Banca de întrebări stă pe server (o extind lectorii). Aici vezi cine a promovat și poți reseta dreptul de
    examinare al unui candidat (de ex. dacă vrei să-l lași să reia mai devreme de pauza de 7 zile).
  </p>
  <ul class="c-examen-list" id="c-examen-list">
    <li class="c-ex-empty">Se încarcă…</li>
  </ul>
</CursuriLayout>

<script is:inline define:vars={{ GRUPE: GRUPE_WDF }}>
  (function () {
    function codAdmin() {
      let c = null;
      try { c = localStorage.getItem("cfcrAccesCod"); } catch (e) {}
      return c || prompt("Confirmă codul de administrator:");
    }
    async function cere(fn, payload) {
      const res = await fetch("/.netlify/functions/" + fn, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cod: codAdmin(), ...payload }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.eroare || "Eroare");
      return data;
    }

    let candidati = [];
    let autorizari = {};
    let examene = {};

    async function incarca() {
      try {
        candidati = await (await fetch("/.netlify/functions/candidati-cursuri", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ cod: codAdmin(), actiune: "lista" }),
        })).json();
        if (!Array.isArray(candidati)) candidati = [];
      } catch (e) { candidati = []; }

      try { autorizari = (await cere("autorizare-cursuri", { actiune: "admin" })).autorizari || {}; } catch (e) { autorizari = {}; }
      try { examene = (await cere("examen-final", { actiune: "admin" })).candidati || {}; } catch (e) { examene = {}; }

      randMatrice();
      randExamene();
    }

    // ——— A. Matricea de autorizare ———
    function randMatrice() {
      const body = document.getElementById("c-matrice-body");
      body.textContent = "";
      if (!candidati.length) {
        const tr = document.createElement("tr");
        tr.innerHTML = '<td colspan="' + (GRUPE.length + 4) + '" class="c-mx-empty">Niciun candidat înscris. Adaugă din <a href="/cursuri/admin/">panoul platformei</a>.</td>';
        body.appendChild(tr);
        return;
      }
      candidati.forEach((c) => {
        const tr = document.createElement("tr");
        const nume = document.createElement("td");
        nume.className = "c-mx-cand";
        nume.innerHTML = "<strong>" + c.nume + "</strong>";
        tr.appendChild(nume);

        const a = autorizari[c.id] || {};
        const curent = a.grupe || [];
        GRUPE.forEach((g) => {
          const td = document.createElement("td");
          const cb = document.createElement("input");
          cb.type = "checkbox"; cb.dataset.grupa = g.nr;
          cb.checked = curent.includes(g.nr);
          td.appendChild(cb);
          tr.appendChild(td);
        });

        // Public în registru
        const tdPub = document.createElement("td");
        const pub = document.createElement("input");
        pub.type = "checkbox"; pub.className = "c-mx-public"; pub.checked = !!a.public;
        tdPub.appendChild(pub);
        tr.appendChild(tdPub);

        // Localitate
        const tdLoc = document.createElement("td");
        const loc = document.createElement("input");
        loc.type = "text"; loc.className = "c-mx-loc"; loc.placeholder = "ex. Reșița"; loc.value = a.localitate || "";
        tdLoc.appendChild(loc);
        tr.appendChild(tdLoc);

        const tdBtn = document.createElement("td");
        const btn = document.createElement("button");
        btn.className = "btn btn--small btn--outline";
        btn.textContent = "Salvează";
        btn.addEventListener("click", async () => {
          const grupe = [...tr.querySelectorAll("input[type=checkbox][data-grupa]:checked")].map((cb) => Number(cb.dataset.grupa));
          const payload = { actiune: "salveaza", candidatId: c.id, grupe, public: pub.checked, localitate: loc.value.trim() };
          btn.disabled = true; btn.textContent = "…";
          try {
            await cere("autorizare-cursuri", payload);
            autorizari[c.id] = { grupe, public: pub.checked, localitate: loc.value.trim() };
            btn.textContent = "Salvat ✓";
            setTimeout(() => (btn.textContent = "Salvează"), 2000);
          } catch (err) { alert("Nu am putut salva: " + err.message); btn.textContent = "Salvează"; }
          finally { btn.disabled = false; }
        });
        tdBtn.appendChild(btn);
        tr.appendChild(tdBtn);
        body.appendChild(tr);
      });
    }

    // ——— B. Examenul final ———
    function dataRo(s) {
      if (!s) return "";
      const d = new Date(s);
      return isNaN(d) ? s : d.toLocaleDateString("ro-RO", { day: "numeric", month: "long", year: "numeric" });
    }

    function randExamene() {
      const list = document.getElementById("c-examen-list");
      list.textContent = "";
      const cuExamen = candidati.filter((c) => examene[c.id]);
      if (!cuExamen.length) {
        const li = document.createElement("li");
        li.className = "c-ex-empty";
        li.textContent = "Niciun candidat nu a susținut încă examenul final.";
        list.appendChild(li);
        return;
      }
      cuExamen.forEach((c) => {
        const e = examene[c.id];
        const li = document.createElement("li");
        const info = document.createElement("div");
        const stare = e.promovat
          ? "<span class='c-badge c-badge--pass'>Promovat ✓</span>"
          : "<span class='c-badge c-badge--fail'>Nepromovat</span> — reîncercare de la " + dataRo(new Date(new Date(e.ultimaData).getTime() + 7 * 864e5).toISOString());
        info.innerHTML = "<strong>" + c.nume + "</strong> · " + stare + " <span class='c-ex-meta'>(" + e.incercari + " încercări)</span>";
        li.appendChild(info);

        const btn = document.createElement("button");
        btn.className = "btn btn--small btn--danger";
        btn.textContent = "Resetează dreptul";
        btn.addEventListener("click", async () => {
          if (!confirm("Resetezi examenul lui „" + c.nume + "”? Se șterge starea (promovat/pauză) și poate susține din nou imediat.")) return;
          btn.disabled = true;
          try {
            await cere("examen-final", { actiune: "reset", candidatId: c.id });
            delete examene[c.id];
            randExamene();
          } catch (err) { alert("Nu am putut reseta: " + err.message); btn.disabled = false; }
        });
        li.appendChild(btn);
        list.appendChild(li);
      });
    }

    incarca();
  })();
</script>

<style>
  .c-crumb { margin: 0 0 1.25rem; }
  .c-crumb a { text-decoration: none; color: var(--color-text-muted); }
  .c-crumb a:hover { color: var(--color-primary); }
  .c-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; color: var(--color-accent-dark); margin: 0; }
  .c-title { font-family: var(--font-serif); color: var(--color-primary); margin: 0.35rem 0 0.5rem; }
  .c-sub { color: var(--color-text-muted); max-width: 48rem; }
  .c-h2 { font-family: var(--font-serif); color: var(--color-primary); margin: 2.25rem 0 0.6rem; font-size: 1.35rem; border-bottom: 2px solid var(--color-accent); padding-bottom: 0.35rem; }
  .c-note { color: var(--color-text-muted); max-width: 48rem; }

  .c-legenda { display: grid; gap: 0.25rem 1rem; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); margin: 0 0 1rem; font-size: 0.82rem; color: var(--color-text-muted); }
  .c-lg strong { color: var(--color-accent-dark); }

  .c-matrice-wrap { overflow-x: auto; }
  .c-linkpublic { margin: 0 0 1rem; }
  .c-linkpublic a { color: var(--color-accent-dark); font-weight: 600; }
  .c-matrice { border-collapse: collapse; width: 100%; min-width: 62rem; }
  .c-matrice th, .c-matrice td { border: 1px solid var(--color-border); padding: 0.45rem 0.55rem; text-align: center; }
  .c-matrice th { background: var(--color-surface-alt); font-size: 0.78rem; white-space: nowrap; }
  .c-mx-cand { text-align: left !important; white-space: nowrap; }
  .c-matrice input[type=checkbox] { width: 1.15rem; height: 1.15rem; cursor: pointer; }
  .c-mx-loc { width: 8rem; padding: 0.3rem 0.45rem; border: 1px solid var(--color-border); border-radius: 6px; font: inherit; font-size: 0.82rem; }
  .c-mx-empty { text-align: center; color: var(--color-text-muted); font-style: italic; }

  .c-examen-list { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.6rem; max-width: 48rem; }
  .c-examen-list li { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 0.7rem 1rem; }
  .c-examen-list li > div { flex: 1; }
  .c-ex-empty { color: var(--color-text-muted); font-style: italic; border: 0 !important; background: transparent !important; padding: 0 !important; }
  .c-ex-meta { color: var(--color-text-muted); font-size: 0.85rem; }
  .c-badge { font-size: 0.72rem; padding: 0.15rem 0.55rem; border-radius: 999px; }
  .c-badge--pass { background: var(--color-primary); color: #fbfaf7; }
  .c-badge--fail { background: #f9efef; color: #8c1d2f; border: 1px solid #8c1d2f; }
</style>
