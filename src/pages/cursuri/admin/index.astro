---
// /cursuri/admin/ — panoul administratorului (acces total la platformă).
// Accesibil DOAR cu codul de administrator. De aici se comută modulele
// online/ascuns pentru candidați (bifa are efect instant).
import CursuriLayout from "../../../layouts/CursuriLayout.astro";
import { LECTORI, MODULE, ADMIN_HASH } from "../../../data/cursuri";
---

<CursuriLayout title="Administrare" allow={[ADMIN_HASH]}>
  <p class="a-eyebrow">Administrare</p>
  <h1 class="a-title">Panoul platformei</h1>
  <p class="a-sub">Ai acces la toate zonele. Bifează un modul ca să devină vizibil candidaților — efectul e imediat; debifat, modulul apare „încuiat”.</p>

  <h2 class="a-h2">Modulele candidaților — online / ascuns</h2>
  <p class="a-stare" id="a-stare">Se încarcă starea modulelor…</p>
  <ul class="a-module">
    {MODULE.map((m) => (
      <li class="a-modul">
        <label class="a-switch">
          <input type="checkbox" data-slug={m.slug} disabled />
          <span class="a-switch__track" aria-hidden="true"></span>
        </label>
        <a class="a-modul__link" href={`/cursuri/${m.slug}/`}>
          <strong>Modul {m.nr}</strong> — {m.titlu}
        </a>
        <span class="a-modul__badge" data-badge={m.slug}>…</span>
      </li>
    ))}
  </ul>

  <h2 class="a-h2">Spațiile lectorilor</h2>
  <ul class="a-list">
    {LECTORI.map((l) => (
      <li>
        <a href={`/cursuri/lector/${l.slug}/`}>{l.nume} →</a>
        <span class="a-meta">{l.materiale.length ? `${l.materiale.length} materiale` : "fără materiale încă"}</span>
      </li>
    ))}
  </ul>

  <h2 class="a-h2">Cum publici un curs nou</h2>
  <ol class="a-pasi">
    <li>Primești materialul de la lector (PDF, prezentare, document).</li>
    <li>Îl pui în folderul de lucru și îi spui lui Claude în ce spațiu de lector (și, opțional, în ce modul) să-l publice.</li>
    <li>Când modulul se predă, îl bifezi aici — candidații îl văd instant.</li>
  </ol>
</CursuriLayout>

<script is:inline>
  (async function () {
    const stareEl = document.getElementById("a-stare");
    const inputs = [...document.querySelectorAll("input[data-slug]")];
    const badge = (slug) => document.querySelector('[data-badge="' + slug + '"]');

    function aplica(stare) {
      inputs.forEach((inp) => {
        const on = !!stare[inp.dataset.slug];
        inp.checked = on;
        inp.disabled = false;
        const b = badge(inp.dataset.slug);
        b.textContent = on ? "Online" : "Ascuns";
        b.className = "a-modul__badge " + (on ? "is-on" : "is-off");
      });
    }

    try {
      const res = await fetch("/.netlify/functions/stare-cursuri");
      aplica(await res.json());
      stareEl.hidden = true;
    } catch (e) {
      stareEl.textContent = "Nu am putut încărca starea. Reîncarcă pagina.";
      return;
    }

    inputs.forEach((inp) => {
      inp.addEventListener("change", async () => {
        const slug = inp.dataset.slug;
        const online = inp.checked;
        inp.disabled = true;
        let cod = null;
        try { cod = localStorage.getItem("cfcrAccesCod"); } catch (e) {}
        if (!cod) cod = prompt("Confirmă codul de administrator:");
        try {
          const res = await fetch("/.netlify/functions/stare-cursuri", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: slug, online, cod }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.eroare || "Eroare");
          aplica(data.stare);
        } catch (err) {
          alert("Nu am putut salva: " + err.message);
          inp.checked = !online; // revenim
          inp.disabled = false;
        }
      });
    });
  })();
</script>

<style>
  .a-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; color: var(--color-accent-dark); margin: 0; }
  .a-title { font-family: var(--font-serif); color: var(--color-primary); margin: 0.35rem 0 0.5rem; }
  .a-sub { color: var(--color-text-muted); max-width: 46rem; }
  .a-h2 { font-family: var(--font-serif); color: var(--color-primary); margin: 2.25rem 0 0.75rem; font-size: 1.35rem; border-bottom: 2px solid var(--color-accent); padding-bottom: 0.35rem; }
  .a-stare { color: var(--color-text-muted); font-style: italic; }

  .a-module { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .a-modul {
    display: flex; align-items: center; gap: 0.9rem;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius); padding: 0.7rem 1rem;
  }
  .a-modul__link { text-decoration: none; color: var(--color-text); }
  .a-modul__link strong { color: var(--color-primary); }
  .a-modul__badge { margin-left: auto; font-size: 0.75rem; letter-spacing: 0.04em; padding: 0.25rem 0.65rem; border-radius: 999px; border: 1px solid var(--color-border); color: var(--color-text-muted); white-space: nowrap; }
  .a-modul__badge.is-on { background: var(--color-primary); border-color: var(--color-primary); color: #fbfaf7; }
  .a-modul__badge.is-off { background: var(--color-surface-alt); }

  /* Comutator */
  .a-switch { position: relative; display: inline-block; flex: 0 0 auto; }
  .a-switch input { position: absolute; opacity: 0; width: 100%; height: 100%; cursor: pointer; margin: 0; }
  .a-switch__track {
    display: block; width: 2.9rem; height: 1.55rem; border-radius: 999px;
    background: var(--color-border); transition: background 0.15s ease; position: relative;
  }
  .a-switch__track::after {
    content: ""; position: absolute; top: 0.17rem; left: 0.2rem; width: 1.2rem; height: 1.2rem;
    border-radius: 50%; background: #fff; transition: transform 0.15s ease; box-shadow: 0 1px 2px rgba(0,0,0,0.25);
  }
  .a-switch input:checked + .a-switch__track { background: var(--color-primary); }
  .a-switch input:checked + .a-switch__track::after { transform: translateX(1.3rem); }
  .a-switch input:disabled + .a-switch__track { opacity: 0.55; }

  .a-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .a-list a { color: var(--color-accent-dark); font-weight: 600; text-decoration: none; }
  .a-list a:hover { text-decoration: underline; }
  .a-meta { margin-left: 0.6rem; font-size: 0.82rem; color: var(--color-text-muted); }
  .a-pasi { max-width: 44rem; display: grid; gap: 0.4rem; padding-left: 1.2rem; }
</style>
