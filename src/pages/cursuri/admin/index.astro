---
// /cursuri/admin/ — panoul administratorului (acces total la platformă).
// Accesibil DOAR cu codul de administrator. De aici se comută modulele
// online/ascuns pentru candidați (bifa are efect instant).
import CursuriLayout from "../../../layouts/CursuriLayout.astro";
import { LECTORI, MODULE } from "../../../data/cursuri";
---

<CursuriLayout title="Administrare" allow={["admin"]}>
  <p class="a-eyebrow">Administrare</p>
  <h1 class="a-title">Panoul platformei</h1>
  <p class="a-sub">Ai acces la toate zonele. Bifează un modul ca să devină vizibil candidaților — efectul e imediat; debifat, modulul apare „încuiat”.</p>

  <p class="a-actiuni">
    <a class="btn btn--primary" href="/cursuri/lector/flavian-savescu/">Spațiul meu de lector →</a>
    <a class="btn btn--outline" href="/cursuri/module/">Zona candidaților →</a>
    <a class="btn btn--outline" href="/cursuri/admin/rezultate/">📋 Registrul rezultatelor →</a>
    <a class="btn btn--outline" href="/cursuri/admin/progres/">📊 Progresul candidaților →</a>
    <a class="btn btn--outline" href="/cursuri/admin/analiza/">🧭 Sala de analiză (Judge Comparison Room) →</a>
    <a class="btn btn--outline" href="/cursuri/admin/anatomie/">📐 Exerciții de anatomie →</a>
    <a class="btn btn--outline" href="#interese">🐾 Interese pe rase (orientare lectori) →</a>
    <a class="btn btn--outline" href="/cursuri/materiale/">📚 Biblioteca comună (toate cursurile) →</a>
    <a class="btn btn--outline" href="/breed-explorer/" target="_blank" rel="noopener">📖 CFCR Breed Standards Explorer ↗</a>
    <a class="btn btn--outline" href="/photo-annotator/" target="_blank" rel="noopener">📐 Photo Anatomy Annotator ↗</a>
    <a class="btn btn--outline" href="https://arbitraj.cfc-royal.ro" target="_blank" rel="noopener">🎯 Exerciții de arbitraj ↗</a>
    <a class="btn btn--outline" href="/cursuri/admin/asistente/">🎗️ Asistențe de ring →</a>
    <a class="btn btn--outline" href="/cursuri/admin/certificare/">🎓 Certificare (grupe + examen) →</a>
    <a class="btn btn--outline" href="/cursuri/teleprompter/" target="_blank" rel="noopener">🎬 Teleprompter ↗</a>
    {/* `?din=cursuri` pornește intrarea automată cu codul păstrat de browser. Fără el,
        pagina de intrare nu reautentifică nimic — altfel butonul „Ieșire" din registru
        ar fi anulat pe loc de o nouă autentificare. */}
    <a class="btn btn--outline" href="/registru/?din=cursuri">🧬 Registrul genealogic (coduri de membru) →</a>
  </p>

  <h2 class="a-h2">Modulele candidaților — online / ascuns</h2>
  <p class="a-stare" id="a-stare">Se încarcă starea modulelor…</p>
  <ul class="a-module">
    {MODULE.map((m) => (
      <li class="a-modul">
        <label class="a-switch">
          <input type="checkbox" data-slug={m.slug} disabled />
          <span class="a-switch__track" aria-hidden="true"></span>
        </label>
        <a class="a-modul__link" href={`/cursuri/${m.slug}/`}>
          <strong>Modul {m.nr}</strong> — {m.titlu}
        </a>
        <span class="a-modul__badge" data-badge={m.slug}>…</span>
      </li>
    ))}
  </ul>

  <h2 class="a-h2">Anunțuri pentru candidați</h2>
  <p class="a-anunt-info">Anunțurile apar imediat pe tabloul candidaților („📢 Noutăți"). Cel mai nou apare primul.</p>
  <div class="a-anunt-form">
    <textarea id="a-anunt-text" rows="3" placeholder="Ex. Modulul 3 se predă joi, 18 iulie, ora 19:00, pe Zoom. Link: ..."></textarea>
    <button id="a-anunt-add" class="btn btn--primary" type="button">Publică anunțul</button>
  </div>
  <ul class="a-anunt-list" id="a-anunt-list"></ul>

  <h2 class="a-h2">Buletinul Școlii — newsletter intern</h2>
  <p class="a-anunt-info">Buletinul apare în <a href="/cursuri/buletin/">arhiva din platformă</a> (o văd toți membrii:
  candidați, arbitri, lectori) și pleacă <strong>pe e-mail</strong> către cei abonați din pagina buletinului.
  <span id="a-bul-abonati">Se numără abonații…</span></p>
  <details class="a-bul-abonati-det" id="a-bul-abonati-det" hidden>
    <summary>Vezi lista abonaților</summary>
    <ul class="a-cand-list" id="a-bul-abonati-list"></ul>
  </details>
  <div class="a-anunt-form">
    <input id="a-bul-titlu" type="text" placeholder="Titlul buletinului — ex. Noutățile lunii august" />
    <textarea id="a-bul-text" rows="6" placeholder="Conținutul buletinului. Paragrafele se păstrează așa cum le scrii."></textarea>
    <button id="a-bul-add" class="btn btn--primary" type="button">Publică buletinul</button>
  </div>
  <p class="a-cand-feedback" id="a-bul-feedback" role="status" hidden></p>
  <ul class="a-anunt-list" id="a-bul-list"></ul>

  <h2 class="a-h2">Candidați — coduri individuale de acces</h2>
  <p class="a-anunt-info">Fiecare candidat primește codul lui personal. Progresul (testele promovate) se salvează pe cont, vizibil de pe orice dispozitiv. Adaugi un candidat, îi trimiți codul generat, iar el intră cu el pe platformă.</p>
  <div class="a-cand-form">
    <input id="a-cand-nume" type="text" placeholder="Numele complet al candidatului" />
    <button id="a-cand-add" class="btn btn--primary" type="button">Adaugă candidat</button>
  </div>
  <p class="a-cand-feedback" id="a-cand-feedback" role="status" hidden></p>
  <p class="a-cand-count" id="a-cand-count" hidden></p>
  <ul class="a-cand-list" id="a-cand-list"></ul>
  <p class="a-anunt-info">
    Ștergerea unui candidat îi înlătură acum <strong>toate</strong> urmele: răspunsurile din Sala de analiză
    și de la exercițiile de anatomie, sesiunile și imaginile lui, apartenența la exerciții și profilul de interese.
    Butonul de mai jos face aceeași curățare <strong>retroactiv</strong>, pentru candidații șterși înainte de această schimbare.
  </p>
  <p>
    <button id="a-orfani" class="btn btn--outline" type="button">🧹 Curăță datele rămase de la candidați șterși</button>
    <span id="a-orfani-msg" class="a-int-msg"></span>
  </p>

  <h2 class="a-h2">Arbitri — acces de studiu (fără teste)</h2>
  <p class="a-anunt-info">Membrii <strong>Colegiului de Arbitri care nu sunt lectori</strong> primesc un cod personal
  (prefix <code>COL-</code>) cu care intră în <a href="/cursuri/arbitru/">spațiul arbitrului</a>: manualul de studiu,
  conținutul modulelor <strong>fără teste</strong>, biblioteca lectorilor și aplicațiile. Nu apar la progres sau examen.</p>
  <div class="a-cand-form">
    <input id="a-arb-nume" type="text" placeholder="Numele complet al arbitrului" />
    <button id="a-arb-add" class="btn btn--primary" type="button">Adaugă arbitru</button>
  </div>
  <p class="a-cand-feedback" id="a-arb-feedback" role="status" hidden></p>
  <p class="a-cand-count" id="a-arb-count" hidden></p>
  <ul class="a-cand-list" id="a-arb-list"></ul>

  <h2 class="a-h2">Codul Etic — asumări</h2>
  <p class="a-anunt-info">La prima intrare în platformă, fiecare candidat, arbitru și lector confirmă că a citit
  și își asumă <a href="/ro/documente/cod-etic/" target="_blank" rel="noopener">Codul Etic</a>. Confirmarea se
  înregistrează cu numele și data — actul pe care se sprijină procedura disciplinară.
  <span id="a-ce-sumar"></span></p>
  <details class="a-bul-abonati-det" id="a-ce-det" hidden>
    <summary>Vezi cine a asumat și cine nu</summary>
    <ul class="a-cand-list" id="a-ce-list"></ul>
  </details>

  <h2 class="a-h2">Formarea continuă — situația anului</h2>
  <p class="a-anunt-info">Toți arbitrii Colegiului (lectori + arbitri cu cod de studiu) trebuie să parcurgă anual
  <a href="/cursuri/arbitru/formare/">modulul de actualizare</a> și mini-testul. Aici vezi cine l-a promovat.</p>
  <p class="a-cand-count" id="a-form-count" hidden></p>
  <ul class="a-cand-list" id="a-form-list"></ul>

  <h2 class="a-h2">Coduri de instalare — Breed Standards Explorer</h2>
  <p class="a-anunt-info">Aplicația se poate <strong>instala</strong> pe dispozitiv doar cu un cod de instalare — diferit de codul de acces în platformă. Generezi un cod și îl dai persoanei care instalează. Consultarea online rămâne liberă pentru candidați.</p>
  <div class="a-cand-form">
    <input id="a-inst-eticheta" type="text" placeholder="Etichetă (opțional): pentru cine / ce dispozitiv" />
    <button id="a-inst-gen" class="btn btn--primary" type="button">Generează cod de instalare</button>
  </div>
  <ul class="a-cand-list" id="a-inst-list"></ul>

  <h2 class="a-h2">Photo Anatomy Annotator — instalare și standard demo</h2>
  <p class="a-anunt-info">Coduri de instalare <strong>PAA</strong> (separate de Breed Explorer) și standardul <strong>demonstrativ</strong> pentru aplicația de adnotare anatomică.</p>
  <div class="a-cand-form">
    <input id="a-paa-eticheta" type="text" placeholder="Etichetă (opțional)" />
    <button id="a-paa-gen" class="btn btn--primary" type="button">Generează cod de instalare (PAA)</button>
    <button id="a-paa-seed" class="btn btn--outline" type="button">Încarcă standardul demo</button>
  </div>
  <ul class="a-cand-list" id="a-paa-list"></ul>

  <h2 class="a-h2" id="interese">Interese pe rase — orientarea către lectori</h2>
  <p class="a-anunt-info">Candidații își aleg grupele și rasele care îi interesează (minim 2 grupe). Aici vezi profilul fiecăruia, primești o <strong>sugestie de lector</strong> după suprapunerea de grupe (la egalitate, cel cu mai puțini candidați) și repartizezi <strong>lectorul principal</strong>. Marchează grupele cu <strong>deficit de arbitri</strong> — candidații le văd evidențiate și sunt încurajați să aleagă larg.</p>

  <div class="a-int-deficit">
    <div class="a-int-deficit__lbl">Grupe cu deficit de arbitri:</div>
    <div id="a-int-def-boxes" class="a-int-defrow">Se încarcă…</div>
    <button id="a-int-def-save" class="btn btn--small btn--primary" type="button">Salvează deficitul</button>
    <span id="a-int-def-msg" class="a-int-msg"></span>
  </div>

  <div id="a-int-agg" class="a-int-agg" hidden></div>
  <div id="a-int-list" class="a-int-list">Se încarcă profilurile de interese…</div>

  <h2 class="a-h2">Spațiile lectorilor</h2>
  <ul class="a-list">
    {LECTORI.map((l) => (
      <li>
        <a href={`/cursuri/lector/${l.slug}/`}>{l.nume} →</a>
        <span class="a-meta">{l.materiale.length ? `${l.materiale.length} materiale` : "fără materiale încă"}</span>
      </li>
    ))}
  </ul>

  <h2 class="a-h2">Cum publici un curs nou</h2>
  <ol class="a-pasi">
    <li>Primești materialul de la lector (PDF, prezentare, document).</li>
    <li>Îl pui în folderul de lucru și îi spui lui Claude în ce spațiu de lector (și, opțional, în ce modul) să-l publice.</li>
    <li>Când modulul se predă, îl bifezi aici — candidații îl văd instant.</li>
  </ol>
</CursuriLayout>

<script is:inline>
  (async function () {
    const stareEl = document.getElementById("a-stare");
    const inputs = [...document.querySelectorAll("input[data-slug]")];
    const badge = (slug) => document.querySelector('[data-badge="' + slug + '"]');

    function aplica(stare) {
      inputs.forEach((inp) => {
        const on = !!stare[inp.dataset.slug];
        inp.checked = on;
        inp.disabled = false;
        const b = badge(inp.dataset.slug);
        b.textContent = on ? "Online" : "Ascuns";
        b.className = "a-modul__badge " + (on ? "is-on" : "is-off");
      });
    }

    try {
      const res = await fetch("/.netlify/functions/stare-cursuri");
      aplica(await res.json());
      stareEl.hidden = true;
    } catch (e) {
      stareEl.textContent = "Nu am putut încărca starea. Reîncarcă pagina.";
      return;
    }

    // ——— Anunțuri ———
    function codAdmin() {
      let c = null;
      try { c = localStorage.getItem("cfcrAccesCod"); } catch (e) {}
      return c || prompt("Confirmă codul de administrator:");
    }

    async function incarcaAnunturi() {
      const list = document.getElementById("a-anunt-list");
      list.textContent = "";
      let anunturi = [];
      try { anunturi = await (await fetch("/.netlify/functions/anunturi-cursuri")).json(); } catch (e) {}
      if (!anunturi.length) {
        const li = document.createElement("li");
        li.className = "a-anunt-empty";
        li.textContent = "Niciun anunț publicat.";
        list.appendChild(li);
        return;
      }
      anunturi.forEach((a) => {
        const li = document.createElement("li");
        const d = a.data ? new Date(a.data).toLocaleDateString("ro-RO", { day: "numeric", month: "long", year: "numeric" }) : "";
        const wrap = document.createElement("div");
        wrap.innerHTML = "<span class='a-anunt-date'>" + d + "</span>";
        const p = document.createElement("p");
        p.className = "a-anunt-txt";
        p.textContent = a.text;
        wrap.appendChild(p);
        const del = document.createElement("button");
        del.className = "btn btn--small btn--danger";
        del.textContent = "Șterge";
        del.addEventListener("click", async () => {
          if (!confirm("Ștergi acest anunț?")) return;
          del.disabled = true;
          try {
            const res = await fetch("/.netlify/functions/anunturi-cursuri", {
              method: "POST", headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ cod: codAdmin(), delete: a.key }),
            });
            if (!res.ok) throw new Error((await res.json()).eroare || "Eroare");
            incarcaAnunturi();
          } catch (err) { alert("Nu am putut șterge: " + err.message); del.disabled = false; }
        });
        li.appendChild(wrap);
        li.appendChild(del);
        list.appendChild(li);
      });
    }

    document.getElementById("a-anunt-add").addEventListener("click", async () => {
      const ta = document.getElementById("a-anunt-text");
      const text = ta.value.trim();
      if (!text) { ta.focus(); return; }
      const btn = document.getElementById("a-anunt-add");
      btn.disabled = true; btn.textContent = "Se publică…";
      try {
        const res = await fetch("/.netlify/functions/anunturi-cursuri", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ cod: codAdmin(), text }),
        });
        if (!res.ok) throw new Error((await res.json()).eroare || "Eroare");
        ta.value = "";
        incarcaAnunturi();
      } catch (err) { alert("Nu am putut publica: " + err.message); }
      finally { btn.disabled = false; btn.textContent = "Publică anunțul"; }
    });

    incarcaAnunturi();

    // ——— Buletinul Școlii (newsletter intern) ———
    async function buletinCere(payload) {
      const res = await fetch("/.netlify/functions/buletin-cursuri", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cod: codAdmin(), ...payload }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.eroare || "Eroare de server.");
      return data;
    }

    async function incarcaBuletine() {
      const list = document.getElementById("a-bul-list");
      list.innerHTML = "";
      try {
        const d = await buletinCere({ actiune: "lista" });
        if (!d.buletine.length) {
          const li = document.createElement("li");
          li.className = "a-cand-empty";
          li.textContent = "Niciun buletin publicat încă.";
          list.appendChild(li);
          return;
        }
        d.buletine.forEach((b) => {
          const li = document.createElement("li");
          const info = document.createElement("div");
          info.className = "a-cand-info";
          const t = document.createElement("strong");
          t.textContent = b.titlu;
          const meta = document.createElement("span");
          meta.className = "a-cand-meta";
          meta.textContent = fmtData(b.data, true) + " · " + b.text.slice(0, 120) + (b.text.length > 120 ? "…" : "");
          info.appendChild(t); info.appendChild(meta);
          const del = document.createElement("button");
          del.className = "btn btn--small btn--danger";
          del.textContent = "Șterge";
          del.addEventListener("click", async () => {
            if (!confirm("Ștergi buletinul „" + b.titlu + "” din arhivă? (E-mailurile deja trimise rămân trimise.)")) return;
            del.disabled = true;
            try { await buletinCere({ actiune: "sterge", key: b.key }); incarcaBuletine(); }
            catch (err) { alert("Nu am putut șterge: " + err.message); del.disabled = false; }
          });
          li.appendChild(info); li.appendChild(del);
          list.appendChild(li);
        });
      } catch (e) {
        const li = document.createElement("li");
        li.className = "a-cand-empty";
        li.textContent = "Nu am putut încărca buletinele.";
        list.appendChild(li);
      }
    }

    async function numaraAbonati() {
      const el = document.getElementById("a-bul-abonati");
      const det = document.getElementById("a-bul-abonati-det");
      const list = document.getElementById("a-bul-abonati-list");
      try {
        const d = await buletinCere({ actiune: "abonati" });
        if (!d.abonati.length) {
          el.textContent = "Nimeni nu s-a abonat încă pe e-mail — buletinul rămâne vizibil în platformă.";
          det.hidden = true;
          return;
        }
        el.textContent = "Abonați pe e-mail acum: " + d.abonati.length + ".";
        det.hidden = false;
        list.innerHTML = "";
        d.abonati.forEach((a) => {
          const li = document.createElement("li");
          const info = document.createElement("div");
          info.className = "a-cand-info";
          const em = document.createElement("strong");
          em.textContent = a.email;
          const meta = document.createElement("span");
          meta.className = "a-cand-meta";
          meta.textContent =
            (a.nume ? a.nume + (a.rol ? " (" + a.rol + ")" : "") + " · " : "") +
            (a.creat ? "abonat " + fmtData(a.creat, true) : "");
          info.appendChild(em); info.appendChild(meta);
          const del = document.createElement("button");
          del.className = "btn btn--small btn--danger";
          del.textContent = "Scoate";
          del.addEventListener("click", async () => {
            if (!confirm("Scoți adresa " + a.email + " de la buletin? Nu va mai primi e-mailuri.")) return;
            del.disabled = true;
            try { await buletinCere({ actiune: "dezaboneaza", email: a.email }); numaraAbonati(); }
            catch (e2) { alert("Nu am putut scoate adresa: " + e2.message); del.disabled = false; }
          });
          li.appendChild(info); li.appendChild(del);
          list.appendChild(li);
        });
      } catch (e) { el.textContent = ""; det.hidden = true; }
    }

    document.getElementById("a-bul-add").addEventListener("click", async () => {
      const inTitlu = document.getElementById("a-bul-titlu");
      const inText = document.getElementById("a-bul-text");
      const titlu = inTitlu.value.trim();
      const text = inText.value.trim();
      if (titlu.length < 3) { inTitlu.focus(); return; }
      if (text.length < 10) { inText.focus(); return; }
      if (!confirm("Publici buletinul „" + titlu + "”? Va apărea în platformă și va pleca pe e-mail către abonați.")) return;
      const btn = document.getElementById("a-bul-add");
      const fb = document.getElementById("a-bul-feedback");
      btn.disabled = true; btn.textContent = "Se publică…";
      try {
        const d = await buletinCere({ actiune: "publica", titlu, text });
        inTitlu.value = ""; inText.value = "";
        fb.hidden = false;
        fb.className = "a-cand-feedback is-ok";
        fb.textContent = "✓ Buletin publicat. E-mailuri trimise: " + (d.trimise || 0) +
          (d.esuate ? " · eșuate: " + d.esuate + " (vezi jurnalul funcției)" : "") + ".";
        incarcaBuletine();
      } catch (err) {
        fb.hidden = false;
        fb.className = "a-cand-feedback is-err";
        fb.textContent = "Nu am putut publica: " + err.message;
      }
      finally { btn.disabled = false; btn.textContent = "Publică buletinul"; }
    });

    incarcaBuletine();
    numaraAbonati();

    // ——— Candidați (coduri individuale) ———
    async function candidatiCere(payload) {
      const res = await fetch("/.netlify/functions/candidati-cursuri", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cod: codAdmin(), ...payload }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.eroare || "Eroare");
      return data;
    }

    function fmtData(iso, cuOra) {
      if (!iso) return "";
      const d = new Date(iso);
      if (isNaN(d)) return "";
      const opt = cuOra
        ? { day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" }
        : { day: "numeric", month: "long", year: "numeric" };
      return d.toLocaleString("ro-RO", opt);
    }

    async function incarcaCandidati(highlightId) {
      const list = document.getElementById("a-cand-list");
      const countEl = document.getElementById("a-cand-count");
      list.textContent = "";
      let candidati = [];
      try { candidati = await candidatiCere({ actiune: "lista" }); } catch (e) {
        countEl.hidden = true;
        const li = document.createElement("li");
        li.className = "a-cand-empty";
        li.textContent = "Nu am putut încărca lista candidaților.";
        list.appendChild(li);
        return;
      }
      if (!candidati.length) {
        countEl.hidden = true;
        const li = document.createElement("li");
        li.className = "a-cand-empty";
        li.textContent = "Niciun candidat adăugat încă.";
        list.appendChild(li);
        return;
      }
      // Cei mai recent înregistrați apar primii.
      candidati.sort((a, b) => String(b.creat || "").localeCompare(String(a.creat || "")));
      const intrati = candidati.filter((c) => c.prima_logare).length;
      countEl.hidden = false;
      countEl.textContent =
        candidati.length + (candidati.length === 1 ? " candidat înregistrat" : " candidați înregistrați") +
        " · " + intrati + " au intrat deja în platformă";
