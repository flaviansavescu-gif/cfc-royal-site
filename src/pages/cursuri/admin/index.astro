---
// /cursuri/admin/ — panoul administratorului (acces total la platformă).
// Accesibil DOAR cu codul de administrator. De aici se comută modulele
// online/ascuns pentru candidați (bifa are efect instant).
import CursuriLayout from "../../../layouts/CursuriLayout.astro";
import { LECTORI, MODULE, ADMIN_HASH } from "../../../data/cursuri";
---

<CursuriLayout title="Administrare" allow={[ADMIN_HASH]}>
  <p class="a-eyebrow">Administrare</p>
  <h1 class="a-title">Panoul platformei</h1>
  <p class="a-sub">Ai acces la toate zonele. Bifează un modul ca să devină vizibil candidaților — efectul e imediat; debifat, modulul apare „încuiat”.</p>

  <p class="a-actiuni">
    <a class="btn btn--primary" href="/cursuri/lector/flavian-savescu/">Spațiul meu de lector →</a>
    <a class="btn btn--outline" href="/cursuri/module/">Zona candidaților →</a>
    <a class="btn btn--outline" href="/cursuri/admin/rezultate/">📋 Registrul rezultatelor →</a>
    <a class="btn btn--outline" href="/cursuri/admin/progres/">📊 Progresul candidaților →</a>
    <a class="btn btn--outline" href="/cursuri/admin/analiza/">🧭 Sala de analiză (Judge Comparison Room) →</a>
    <a class="btn btn--outline" href="/cursuri/admin/anatomie/">📐 Exerciții de anatomie →</a>
    <a class="btn btn--outline" href="/cursuri/materiale/">📚 Biblioteca comună (toate cursurile) →</a>
    <a class="btn btn--outline" href="/breed-explorer/" target="_blank" rel="noopener">📖 CFCR Breed Standards Explorer ↗</a>
    <a class="btn btn--outline" href="/photo-annotator/" target="_blank" rel="noopener">📐 Photo Anatomy Annotator ↗</a>
    <a class="btn btn--outline" href="/cursuri/admin/asistente/">🎗️ Asistențe de ring →</a>
    <a class="btn btn--outline" href="/cursuri/admin/certificare/">🎓 Certificare (grupe + examen) →</a>
    <a class="btn btn--outline" href="/cursuri/teleprompter/" target="_blank" rel="noopener">🎬 Teleprompter ↗</a>
  </p>

  <h2 class="a-h2">Modulele candidaților — online / ascuns</h2>
  <p class="a-stare" id="a-stare">Se încarcă starea modulelor…</p>
  <ul class="a-module">
    {MODULE.map((m) => (
      <li class="a-modul">
        <label class="a-switch">
          <input type="checkbox" data-slug={m.slug} disabled />
          <span class="a-switch__track" aria-hidden="true"></span>
        </label>
        <a class="a-modul__link" href={`/cursuri/${m.slug}/`}>
          <strong>Modul {m.nr}</strong> — {m.titlu}
        </a>
        <span class="a-modul__badge" data-badge={m.slug}>…</span>
      </li>
    ))}
  </ul>

  <h2 class="a-h2">Anunțuri pentru candidați</h2>
  <p class="a-anunt-info">Anunțurile apar imediat pe tabloul candidaților („📢 Noutăți"). Cel mai nou apare primul.</p>
  <div class="a-anunt-form">
    <textarea id="a-anunt-text" rows="3" placeholder="Ex. Modulul 3 se predă joi, 18 iulie, ora 19:00, pe Zoom. Link: ..."></textarea>
    <button id="a-anunt-add" class="btn btn--primary" type="button">Publică anunțul</button>
  </div>
  <ul class="a-anunt-list" id="a-anunt-list"></ul>

  <h2 class="a-h2">Candidați — coduri individuale de acces</h2>
  <p class="a-anunt-info">Fiecare candidat primește codul lui personal. Progresul (testele promovate) se salvează pe cont, vizibil de pe orice dispozitiv. Adaugi un candidat, îi trimiți codul generat, iar el intră cu el pe platformă.</p>
  <div class="a-cand-form">
    <input id="a-cand-nume" type="text" placeholder="Numele complet al candidatului" />
    <button id="a-cand-add" class="btn btn--primary" type="button">Adaugă candidat</button>
  </div>
  <p class="a-cand-feedback" id="a-cand-feedback" role="status" hidden></p>
  <p class="a-cand-count" id="a-cand-count" hidden></p>
  <ul class="a-cand-list" id="a-cand-list"></ul>

  <h2 class="a-h2">Coduri de instalare — Breed Standards Explorer</h2>
  <p class="a-anunt-info">Aplicația se poate <strong>instala</strong> pe dispozitiv doar cu un cod de instalare — diferit de codul de acces în platformă. Generezi un cod și îl dai persoanei care instalează. Consultarea online rămâne liberă pentru candidați.</p>
  <div class="a-cand-form">
    <input id="a-inst-eticheta" type="text" placeholder="Etichetă (opțional): pentru cine / ce dispozitiv" />
    <button id="a-inst-gen" class="btn btn--primary" type="button">Generează cod de instalare</button>
  </div>
  <ul class="a-cand-list" id="a-inst-list"></ul>

  <h2 class="a-h2">Photo Anatomy Annotator — instalare și standard demo</h2>
  <p class="a-anunt-info">Coduri de instalare <strong>PAA</strong> (separate de Breed Explorer) și standardul <strong>demonstrativ</strong> pentru aplicația de adnotare anatomică.</p>
  <div class="a-cand-form">
    <input id="a-paa-eticheta" type="text" placeholder="Etichetă (opțional)" />
    <button id="a-paa-gen" class="btn btn--primary" type="button">Generează cod de instalare (PAA)</button>
    <button id="a-paa-seed" class="btn btn--outline" type="button">Încarcă standardul demo</button>
  </div>
  <ul class="a-cand-list" id="a-paa-list"></ul>

  <h2 class="a-h2">Spațiile lectorilor</h2>
  <ul class="a-list">
    {LECTORI.map((l) => (
      <li>
        <a href={`/cursuri/lector/${l.slug}/`}>{l.nume} →</a>
        <span class="a-meta">{l.materiale.length ? `${l.materiale.length} materiale` : "fără materiale încă"}</span>
      </li>
    ))}
  </ul>

  <h2 class="a-h2">Cum publici un curs nou</h2>
  <ol class="a-pasi">
    <li>Primești materialul de la lector (PDF, prezentare, document).</li>
    <li>Îl pui în folderul de lucru și îi spui lui Claude în ce spațiu de lector (și, opțional, în ce modul) să-l publice.</li>
    <li>Când modulul se predă, îl bifezi aici — candidații îl văd instant.</li>
  </ol>
</CursuriLayout>

<script is:inline>
  (async function () {
    const stareEl = document.getElementById("a-stare");
    const inputs = [...document.querySelectorAll("input[data-slug]")];
    const badge = (slug) => document.querySelector('[data-badge="' + slug + '"]');

    function aplica(stare) {
      inputs.forEach((inp) => {
        const on = !!stare[inp.dataset.slug];
        inp.checked = on;
        inp.disabled = false;
        const b = badge(inp.dataset.slug);
        b.textContent = on ? "Online" : "Ascuns";
        b.className = "a-modul__badge " + (on ? "is-on" : "is-off");
      });
    }

    try {
      const res = await fetch("/.netlify/functions/stare-cursuri");
      aplica(await res.json());
      stareEl.hidden = true;
    } catch (e) {
      stareEl.textContent = "Nu am putut încărca starea. Reîncarcă pagina.";
      return;
    }

    // ——— Anunțuri ———
    function codAdmin() {
      let c = null;
      try { c = localStorage.getItem("cfcrAccesCod"); } catch (e) {}
      return c || prompt("Confirmă codul de administrator:");
    }

    async function incarcaAnunturi() {
      const list = document.getElementById("a-anunt-list");
      list.textContent = "";
      let anunturi = [];
      try { anunturi = await (await fetch("/.netlify/functions/anunturi-cursuri")).json(); } catch (e) {}
      if (!anunturi.length) {
        const li = document.createElement("li");
        li.className = "a-anunt-empty";
        li.textContent = "Niciun anunț publicat.";
        list.appendChild(li);
        return;
      }
      anunturi.forEach((a) => {
        const li = document.createElement("li");
        const d = a.data ? new Date(a.data).toLocaleDateString("ro-RO", { day: "numeric", month: "long", year: "numeric" }) : "";
        const wrap = document.createElement("div");
        wrap.innerHTML = "<span class='a-anunt-date'>" + d + "</span>";
        const p = document.createElement("p");
        p.className = "a-anunt-txt";
        p.textContent = a.text;
        wrap.appendChild(p);
        const del = document.createElement("button");
        del.className = "btn btn--small btn--danger";
        del.textContent = "Șterge";
        del.addEventListener("click", async () => {
          if (!confirm("Ștergi acest anunț?")) return;
          del.disabled = true;
          try {
            const res = await fetch("/.netlify/functions/anunturi-cursuri", {
              method: "POST", headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ cod: codAdmin(), delete: a.key }),
            });
            if (!res.ok) throw new Error((await res.json()).eroare || "Eroare");
            incarcaAnunturi();
          } catch (err) { alert("Nu am putut șterge: " + err.message); del.disabled = false; }
        });
        li.appendChild(wrap);
        li.appendChild(del);
        list.appendChild(li);
      });
    }

    document.getElementById("a-anunt-add").addEventListener("click", async () => {
      const ta = document.getElementById("a-anunt-text");
      const text = ta.value.trim();
      if (!text) { ta.focus(); return; }
      const btn = document.getElementById("a-anunt-add");
      btn.disabled = true; btn.textContent = "Se publică…";
      try {
        const res = await fetch("/.netlify/functions/anunturi-cursuri", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ cod: codAdmin(), text }),
        });
        if (!res.ok) throw new Error((await res.json()).eroare || "Eroare");
        ta.value = "";
        incarcaAnunturi();
      } catch (err) { alert("Nu am putut publica: " + err.message); }
      finally { btn.disabled = false; btn.textContent = "Publică anunțul"; }
    });

    incarcaAnunturi();

    // ——— Candidați (coduri individuale) ———
    async function candidatiCere(payload) {
      const res = await fetch("/.netlify/functions/candidati-cursuri", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cod: codAdmin(), ...payload }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.eroare || "Eroare");
      return data;
    }

    function fmtData(iso, cuOra) {
      if (!iso) return "";
      const d = new Date(iso);
      if (isNaN(d)) return "";
      const opt = cuOra
        ? { day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" }
        : { day: "numeric", month: "long", year: "numeric" };
      return d.toLocaleString("ro-RO", opt);
    }

    async function incarcaCandidati(highlightId) {
      const list = document.getElementById("a-cand-list");
      const countEl = document.getElementById("a-cand-count");
      list.textContent = "";
      let candidati = [];
      try { candidati = await candidatiCere({ actiune: "lista" }); } catch (e) {
        countEl.hidden = true;
        const li = document.createElement("li");
        li.className = "a-cand-empty";
        li.textContent = "Nu am putut încărca lista candidaților.";
        list.appendChild(li);
        return;
      }
      if (!candidati.length) {
        countEl.hidden = true;
        const li = document.createElement("li");
        li.className = "a-cand-empty";
        li.textContent = "Niciun candidat adăugat încă.";
        list.appendChild(li);
        return;
      }
      // Cei mai recent înregistrați apar primii.
      candidati.sort((a, b) => String(b.creat || "").localeCompare(String(a.creat || "")));
      const intrati = candidati.filter((c) => c.prima_logare).length;
      countEl.hidden = false;
      countEl.textContent =
        candidati.length + (candidati.length === 1 ? " candidat înregistrat" : " candidați înregistrați") +
        " · " + intrati + " au intrat deja în platformă";
      candidati.forEach((c) => list.appendChild(randCandidat(c, c.id === highlightId)));
    }

    function randCandidat(c, evidentiaza) {
      const li = document.createElement("li");
      if (evidentiaza) li.className = "is-nou";
      const info = document.createElement("div");
      info.className = "a-cand-info";
      const nume = document.createElement("strong");
      nume.textContent = c.nume;
      const cod = document.createElement("code");
      cod.className = "a-cand-cod";
      cod.textContent = c.cod;
      info.appendChild(nume);
      info.appendChild(cod);

      // Evidența înscrierii: când a fost adăugat și dacă a intrat deja în platformă.
      const meta = document.createElement("span");
      meta.className = "a-cand-meta";
      const adaugat = c.creat ? "Înregistrat: " + fmtData(c.creat, false) : "";
      if (c.prima_logare) {
        meta.innerHTML =
          (adaugat ? "<span>" + adaugat + "</span>" : "") +
          "<span class='a-cand-intrat'>✓ A intrat: " + fmtData(c.prima_logare, true) + "</span>";
      } else {
        meta.innerHTML =
          (adaugat ? "<span>" + adaugat + "</span>" : "") +
          "<span class='a-cand-neintrat'>● Nu a intrat încă</span>";
      }
      info.appendChild(meta);

      const copy = document.createElement("button");
      copy.className = "btn btn--small btn--outline";
      copy.textContent = "Copiază codul";
      copy.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(c.cod); copy.textContent = "Copiat ✓"; setTimeout(() => (copy.textContent = "Copiază codul"), 1500); }
        catch (e) { alert("Cod: " + c.cod); }
      });

      const del = document.createElement("button");
      del.className = "btn btn--small btn--danger";
      del.textContent = "Șterge";
      del.addEventListener("click", async () => {
        if (!confirm("Ștergi candidatul „" + c.nume + "”? Codul și progresul lui se pierd.")) return;
        del.disabled = true;
        try { await candidatiCere({ actiune: "sterge", id: c.id }); incarcaCandidati(); }
        catch (err) { alert("Nu am putut șterge: " + err.message); del.disabled = false; }
      });

      li.appendChild(info);
      li.appendChild(copy);
      li.appendChild(del);
      return li;
    }

    function feedbackCandidat(candidat) {
      const fb = document.getElementById("a-cand-feedback");
      fb.className = "a-cand-feedback is-ok";
      fb.hidden = false;
      fb.innerHTML = "";
      const t = document.createElement("span");
      t.innerHTML = "✓ <strong>" + candidat.nume + "</strong> a fost înregistrat. Cod personal: ";
      const code = document.createElement("code");
      code.className = "a-cand-cod";
      code.textContent = candidat.cod;
      const copy = document.createElement("button");
      copy.type = "button";
      copy.className = "btn btn--small btn--outline";
      copy.textContent = "Copiază codul";
      copy.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(candidat.cod); copy.textContent = "Copiat ✓"; setTimeout(() => (copy.textContent = "Copiază codul"), 1500); }
        catch (e) { /* clipboard indisponibil — codul e vizibil oricum */ }
      });
      const hint = document.createElement("span");
      hint.className = "a-cand-feedback__hint";
      hint.textContent = "Trimite-i acest cod — cu el intră pe platformă. Îl vezi și mai jos, în listă.";
      fb.appendChild(t); fb.appendChild(code); fb.appendChild(copy); fb.appendChild(hint);
    }

    document.getElementById("a-cand-add").addEventListener("click", async () => {
      const inp = document.getElementById("a-cand-nume");
      const nume = inp.value.trim();
      if (nume.length < 3) { inp.focus(); return; }
      const btn = document.getElementById("a-cand-add");
      btn.disabled = true; btn.textContent = "Se adaugă…";
      try {
        const data = await candidatiCere({ actiune: "adauga", nume });
        inp.value = "";
        if (data.candidat) {
          feedbackCandidat(data.candidat);
          await incarcaCandidati(data.candidat.id);
        } else {
          await incarcaCandidati();
        }
      } catch (err) {
        const fb = document.getElementById("a-cand-feedback");
        fb.className = "a-cand-feedback is-err";
        fb.hidden = false;
        fb.textContent = "Nu am putut adăuga candidatul: " + err.message;
      }
      finally { btn.disabled = false; btn.textContent = "Adaugă candidat"; }
    });

    incarcaCandidati();

    // ——— Coduri de instalare (Breed Standards Explorer) ———
    async function instCere(payload) {
      const res = await fetch("/.netlify/functions/breed-instalare", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cod: codAdmin(), ...payload }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.eroare || "Eroare");
      return data;
    }
    async function incarcaInstalare() {
      const list = document.getElementById("a-inst-list");
      list.textContent = "";
      let coduri = [];
      try { coduri = await instCere({ actiune: "lista" }); } catch (e) {
        const li = document.createElement("li"); li.className = "a-cand-empty"; li.textContent = "Nu am putut încărca codurile de instalare."; list.appendChild(li); return;
      }
      if (!coduri.length) { const li = document.createElement("li"); li.className = "a-cand-empty"; li.textContent = "Niciun cod de instalare generat încă."; list.appendChild(li); return; }
      coduri.forEach((c) => list.appendChild(randInstalare(c)));
    }
    function randInstalare(c) {
      const li = document.createElement("li");
      const info = document.createElement("div"); info.className = "a-cand-info";
      const cod = document.createElement("code"); cod.className = "a-cand-cod"; cod.textContent = c.cod;
      info.appendChild(cod);
      if (c.eticheta) { const et = document.createElement("span"); et.className = "a-cand-meta"; et.innerHTML = "<span>" + c.eticheta.replace(/[&<>]/g, "") + "</span>"; info.appendChild(et); }
      const copy = document.createElement("button"); copy.className = "btn btn--small btn--outline"; copy.textContent = "Copiază";
      copy.addEventListener("click", async () => { try { await navigator.clipboard.writeText(c.cod); copy.textContent = "Copiat ✓"; setTimeout(() => (copy.textContent = "Copiază"), 1500); } catch (e) { alert("Cod: " + c.cod); } });
      const del = document.createElement("button"); del.className = "btn btn--small btn--danger"; del.textContent = "Revocă";
      del.addEventListener("click", async () => { if (!confirm("Revoci codul „" + c.cod + "”? Nu va mai permite instalarea.")) return; del.disabled = true; try { await instCere({ actiune: "revoca", id: c.id }); incarcaInstalare(); } catch (err) { alert("Nu am putut revoca: " + err.message); del.disabled = false; } });
      li.appendChild(info); li.appendChild(copy); li.appendChild(del);
      return li;
    }
    document.getElementById("a-inst-gen").addEventListener("click", async () => {
      const btn = document.getElementById("a-inst-gen"); btn.disabled = true; btn.textContent = "Se generează…";
      try {
        const d = await instCere({ actiune: "genereaza", eticheta: document.getElementById("a-inst-eticheta").value.trim() });
        document.getElementById("a-inst-eticheta").value = "";
        incarcaInstalare();
        if (d.cod) alert("Cod de instalare generat:\n\n" + d.cod.cod + "\n\nDă-l persoanei care instalează aplicația. Cu el, din butonul „Install app”, aplicația se poate instala pe dispozitiv.");
      } catch (err) { alert("Nu am putut genera: " + err.message); }
      finally { btn.disabled = false; btn.textContent = "Generează cod de instalare"; }
    });
    incarcaInstalare();

    // ——— Photo Anatomy Annotator: coduri PAA + seed standard demo ———
    async function paaCere(payload) {
      const res = await fetch("/.netlify/functions/paa-instalare", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ cod: codAdmin(), ...payload }) });
      const d = await res.json().catch(() => ({})); if (!res.ok) throw new Error(d.eroare || "Eroare"); return d;
    }
    async function incarcaPaa() {
      const list = document.getElementById("a-paa-list"); list.textContent = "";
      let coduri = []; try { coduri = await paaCere({ actiune: "lista" }); } catch (e) { const li = document.createElement("li"); li.className = "a-cand-empty"; li.textContent = "Nu am putut încărca codurile PAA."; list.appendChild(li); return; }
      if (!coduri.length) { const li = document.createElement("li"); li.className = "a-cand-empty"; li.textContent = "Niciun cod PAA generat încă."; list.appendChild(li); return; }
      coduri.forEach((c) => list.appendChild(randPaa(c)));
    }
    function randPaa(c) {
      const li = document.createElement("li"); const info = document.createElement("div"); info.className = "a-cand-info";
      const cod = document.createElement("code"); cod.className = "a-cand-cod"; cod.textContent = c.cod; info.appendChild(cod);
      if (c.eticheta) { const et = document.createElement("span"); et.className = "a-cand-meta"; et.innerHTML = "<span>" + c.eticheta.replace(/[&<>]/g, "") + "</span>"; info.appendChild(et); }
      const copy = document.createElement("button"); copy.className = "btn btn--small btn--outline"; copy.textContent = "Copiază"; copy.addEventListener("click", async () => { try { await navigator.clipboard.writeText(c.cod); copy.textContent = "Copiat ✓"; setTimeout(() => (copy.textContent = "Copiază"), 1500); } catch (e) { alert("Cod: " + c.cod); } });
      const del = document.createElement("button"); del.className = "btn btn--small btn--danger"; del.textContent = "Revocă"; del.addEventListener("click", async () => { if (!confirm("Revoci codul „" + c.cod + "”?")) return; del.disabled = true; try { await paaCere({ actiune: "revoca", id: c.id }); incarcaPaa(); } catch (err) { alert("Nu am putut revoca: " + err.message); del.disabled = false; } });
      li.appendChild(info); li.appendChild(copy); li.appendChild(del); return li;
    }
    document.getElementById("a-paa-gen").addEventListener("click", async () => {
      const btn = document.getElementById("a-paa-gen"); btn.disabled = true; btn.textContent = "Se generează…";
      try { const d = await paaCere({ actiune: "genereaza", eticheta: document.getElementById("a-paa-eticheta").value.trim() }); document.getElementById("a-paa-eticheta").value = ""; incarcaPaa(); if (d.cod) alert("Cod de instalare PAA:\n\n" + d.cod.cod + "\n\nDă-l persoanei care instalează Photo Anatomy Annotator."); }
      catch (err) { alert("Nu am putut genera: " + err.message); } finally { btn.disabled = false; btn.textContent = "Generează cod de instalare (PAA)"; }
    });
    document.getElementById("a-paa-seed").addEventListener("click", async () => {
      try { const res = await fetch("/.netlify/functions/paa-standarde", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ cod: codAdmin(), actiune: "seed-demo" }) }); const d = await res.json(); if (res.ok) alert(d.existent ? "Standardul demo există deja." : "Standardul demonstrativ a fost încărcat."); else alert(d.eroare || "Eroare"); }
      catch (e) { alert("Nu am putut încărca standardul demo."); }
    });
    incarcaPaa();

    inputs.forEach((inp) => {
      inp.addEventListener("change", async () => {
        const slug = inp.dataset.slug;
        const online = inp.checked;
        inp.disabled = true;
        let cod = null;
        try { cod = localStorage.getItem("cfcrAccesCod"); } catch (e) {}
        if (!cod) cod = prompt("Confirmă codul de administrator:");
        try {
          const res = await fetch("/.netlify/functions/stare-cursuri", {
