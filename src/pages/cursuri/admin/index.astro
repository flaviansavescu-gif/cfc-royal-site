    let INT_GRUPE = {}, INT_LECTORI = [];
    function chip(txt, cls) { const s = document.createElement("span"); s.className = "a-int-chip" + (cls ? " " + cls : ""); s.textContent = txt; return s; }
    function grupaScurt(g) { return (INT_GRUPE[g] || ("Grupa " + g)); }

    function randCandidatInteres(c, deficit) {
      const setDef = {}; (deficit || []).forEach((g) => (setDef[g] = 1));
      const card = document.createElement("div"); card.className = "a-int-card";
      const head = document.createElement("div"); head.className = "a-int-card__head";
      const nm = document.createElement("strong"); nm.textContent = c.nume || "(fără nume)"; head.appendChild(nm);
      const nG = (c.grupe || []).length;
      const br = chip(nG + (nG === 1 ? " grupă" : " grupe") + " · " + (c.rase || []).length + " rase", nG >= 4 ? "is-larg" : "is-focal");
      br.title = nG >= 4 ? "Interes larg — bun pentru autorizare extinsă" : "Interes focalizat — poate fi încurajat spre mai multe grupe";
      head.appendChild(br);
      card.appendChild(head);

      const gr = document.createElement("div"); gr.className = "a-int-grupe";
      (c.grupe || []).forEach((g) => { const ch = chip(grupaScurt(g), setDef[g] ? "is-def" : ""); if (setDef[g]) ch.title = "grupă cu deficit de arbitri"; gr.appendChild(ch); });
      card.appendChild(gr);

      if ((c.rase || []).length) {
        const rz = document.createElement("div"); rz.className = "a-int-rase";
        rz.textContent = "Rase: " + c.rase.map((r) => r.ro).join(", ");
        card.appendChild(rz);
      }
      if (c.nota) { const nt = document.createElement("div"); nt.className = "a-int-nota"; nt.textContent = "„" + c.nota + "”"; card.appendChild(nt); }

      const asg = document.createElement("div"); asg.className = "a-int-assign";
      const sg = document.createElement("span"); sg.className = "a-int-sug"; sg.textContent = "Sugestie: ";
      (c.sugestii || []).forEach((s) => { const ch = chip(s.nume + " (" + s.overlap + ")" + (s.allBreed ? " ·AB" : ""), "is-sug"); sg.appendChild(ch); });
      asg.appendChild(sg);

      const sel = document.createElement("select"); sel.className = "a-int-sel";
      const opt0 = document.createElement("option"); opt0.value = ""; opt0.textContent = "— nerepartizat —"; sel.appendChild(opt0);
      INT_LECTORI.forEach((l) => { const o = document.createElement("option"); o.value = l.slug; o.textContent = l.nume + (l.allBreed ? " (All Breed)" : " (gr. " + l.grupe.join(",") + ")"); sel.appendChild(o); });
      sel.value = c.alocare ? c.alocare.lectorSlug : "";
      const st = document.createElement("span"); st.className = "a-int-alocst";
      st.textContent = c.alocare ? "repartizat: " + c.alocare.lectorNume : "";
      sel.addEventListener("change", async () => {
        sel.disabled = true;
        try {
          const d = await interCere({ actiune: "aloca", tinta: c.cid, lectorSlug: sel.value });
          c.alocare = d.alocare;
          st.textContent = d.alocare ? "repartizat: " + d.alocare.lectorNume : "";
          st.classList.add("is-ok"); setTimeout(() => st.classList.remove("is-ok"), 1200);
        } catch (err) { alert("Nu am putut repartiza: " + err.message); sel.value = c.alocare ? c.alocare.lectorSlug : ""; }
        finally { sel.disabled = false; }
      });
      const wrap = document.createElement("label"); wrap.className = "a-int-selwrap"; wrap.appendChild(document.createTextNode("Lector principal: ")); wrap.appendChild(sel);
      asg.appendChild(wrap); asg.appendChild(st);
      card.appendChild(asg);
      return card;
    }

    function randAgregare(d) {
      const box = document.getElementById("a-int-agg");
      box.textContent = "";
      const cg = d.cerereGrupe || {}, cr = d.cerereRase || {};
      const grupeSort = Object.keys(cg).map(Number).sort((a, b) => cg[b] - cg[a]);
      const raseSort = Object.keys(cr).sort((a, b) => cr[b] - cr[a]).slice(0, 12);
      if (!grupeSort.length && !raseSort.length) { box.hidden = true; return; }
      box.hidden = false;
      const h = document.createElement("div"); h.className = "a-int-agg__t"; h.textContent = "Cerere agregată (pentru prioritatea Breed Explorer)"; box.appendChild(h);
      if (grupeSort.length) {
        const row = document.createElement("div"); row.className = "a-int-agg__row";
        grupeSort.forEach((g) => row.appendChild(chip(grupaScurt(g) + " — " + cg[g])));
        box.appendChild(row);
      }
      if (raseSort.length) {
        const row = document.createElement("div"); row.className = "a-int-agg__row";
        raseSort.forEach((k) => { const ro = k.split("|").slice(1).join("|"); row.appendChild(chip(ro + " — " + cr[k], "is-rasa")); });
        box.appendChild(row);
      }
    }

    function randDeficitBoxes(deficit) {
      const box = document.getElementById("a-int-def-boxes"); box.textContent = "";
      const setDef = {}; (deficit || []).forEach((g) => (setDef[g] = 1));
      for (let g = 1; g <= 10; g++) {
        const lab = document.createElement("label"); lab.className = "a-int-defbox";
        const cb = document.createElement("input"); cb.type = "checkbox"; cb.value = String(g); cb.checked = !!setDef[g]; cb.className = "a-int-defcb";
        lab.appendChild(cb); lab.appendChild(document.createTextNode(" Gr. " + g));
        box.appendChild(lab);
      }
    }

    async function incarcaInterese() {
      const list = document.getElementById("a-int-list");
      let d;
      try { d = await interCere({ actiune: "toate" }); }
      catch (e) { list.textContent = "Nu am putut încărca profilurile: " + e.message; return; }
      INT_GRUPE = d.grupe || {}; INT_LECTORI = d.lectori || [];
      randDeficitBoxes(d.deficit);
      randAgregare(d);
      list.textContent = "";
      if (!d.candidati.length) { list.textContent = "Niciun candidat nu și-a exprimat încă interesele."; return; }
      d.candidati.forEach((c) => list.appendChild(randCandidatInteres(c, d.deficit)));
    }
    document.getElementById("a-int-def-save").addEventListener("click", async () => {
      const btn = document.getElementById("a-int-def-save"), msg = document.getElementById("a-int-def-msg");
      const grupe = Array.prototype.slice.call(document.querySelectorAll(".a-int-defcb")).filter((c) => c.checked).map((c) => parseInt(c.value, 10));
      btn.disabled = true; msg.textContent = "Se salvează…"; msg.className = "a-int-msg";
      try { await interCere({ actiune: "deficit", grupe }); msg.textContent = "✓ salvat"; msg.className = "a-int-msg is-ok"; incarcaInterese(); }
      catch (err) { msg.textContent = err.message; msg.className = "a-int-msg is-err"; }
      finally { btn.disabled = false; }
    });
    incarcaInterese();

    inputs.forEach((inp) => {
      inp.addEventListener("change", async () => {
        const slug = inp.dataset.slug;
        const online = inp.checked;
        inp.disabled = true;
        let cod = null;
        try { cod = localStorage.getItem("cfcrAccesCod"); } catch (e) {}
        if (!cod) cod = prompt("Confirmă codul de administrator:");
        try {
          const res = await fetch("/.netlify/functions/stare-cursuri", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: slug, online, cod }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.eroare || "Eroare");
          aplica(data.stare);
        } catch (err) {
          alert("Nu am putut salva: " + err.message);
          inp.checked = !online; // revenim
          inp.disabled = false;
        }
      });
    });
  })();
</script>

