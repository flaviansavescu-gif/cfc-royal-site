---
// /cursuri/analiza/sesiune/?s=<id> — sala de analiză a cursantului (formular individual).
import CursuriLayout from "../../../layouts/CursuriLayout.astro";
---

<CursuriLayout title="Analiză" candidat>
  <p class="j-actiuni"><a class="btn btn--outline btn--small" href="/cursuri/analiza/">← Sesiunile mele</a></p>
  <p class="j-stare" id="j-stare">Se încarcă sesiunea…</p>

  <div id="j-wrap" hidden>
    <p class="j-eyebrow">Judge Comparison Room</p>
    <h1 class="j-title" id="j-titlu"></h1>
    <p class="j-meta" id="j-meta"></p>
    <p class="j-desc" id="j-desc"></p>

    <div class="j-grid">
      <section class="j-resurse">
        <h2 class="j-h2">Resursă</h2>
        <div id="j-imagini" class="j-imagini"></div>
        <div class="j-obj" id="j-obj" hidden><h3>Obiective</h3><p id="j-obj-text"></p></div>
        <div class="j-timer" id="j-timer" hidden>⏱️ Timp de lucru: <strong id="j-timer-val">00:00</strong> <span id="j-timer-lim"></span></div>
      </section>

      <form class="j-form" id="j-form">
        <h2 class="j-h2">Evaluarea ta</h2>

        <label class="j-field"><span>Impresie generală</span>
          <textarea id="f-general" rows="3" placeholder="Impresia de ansamblu, tipicitate, echilibru…"></textarea></label>

        <label class="j-field"><span>Calități</span>
          <textarea id="f-calitati" rows="2" placeholder="Puncte forte observate…"></textarea></label>

        <fieldset class="j-fieldset">
          <legend>Defecte identificate</legend>
          <div id="f-defecte"></div>
          <button type="button" class="btn btn--small" id="f-defect-add">+ Adaugă defect</button>
        </fieldset>

        <fieldset class="j-fieldset" id="f-obs-wrap">
          <legend>Observații pe criterii (rubrică)</legend>
          <div id="f-observatii"></div>
        </fieldset>

        <label class="j-field"><span>Calificativ propus</span>
          <select id="f-calificativ">
            <option value="">— alege —</option>
          </select></label>

        <fieldset class="j-fieldset" id="f-clasament-wrap" hidden>
          <legend>Clasament (locul fiecărui exemplar)</legend>
          <div id="f-clasament"></div>
        </fieldset>

        <label class="j-field"><span>Justificarea deciziei</span>
          <textarea id="f-justificare" rows="4" placeholder="Argumentează calificativul și clasamentul, cu referire la standard…"></textarea></label>

        <p class="j-form__msg" id="f-msg" role="status" hidden></p>
        <div class="j-form__actiuni" id="f-actiuni">
          <button type="button" class="btn" id="f-schita">Salvează schița</button>
          <button type="submit" class="btn btn--primary" id="f-trimite">Trimite evaluarea</button>
        </div>
        <p class="j-form__lock" id="f-lock" hidden>Ai trimis această evaluare. Nu mai poate fi modificată.</p>
      </form>
    </div>
  </div>
</CursuriLayout>

<script is:inline>
  (async function () {
    const $ = (id) => document.getElementById(id);
    const params = new URLSearchParams(location.search);
    const id = params.get("s");
    let cid = null;
    try { cid = JSON.parse(localStorage.getItem("cfcrCandidat") || "null")?.id || null; } catch (e) {}
    const CALIF = ["Excellent", "Very Good", "Good", "Sufficient", "Insufficient", "Disqualified", "Not Judgeable"];
    const GRAV = [["minor", "Minor"], ["grav", "Grav"], ["eliminator", "Eliminator"]];
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    if (!id || !cid) { $("j-stare").textContent = "Sesiune sau cont invalid."; return; }

    async function api(fn, payload) {
      const res = await fetch("/.netlify/functions/" + fn, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.eroare || "Eroare");
      return d;
    }

    let sesiune, raspuns, trimis = false;
    try {
      const d = await api("jcr-sesiuni", { actiune: "detalii-cursant", cid, id });
      sesiune = d.sesiune; raspuns = d.raspuns;
    } catch (err) { $("j-stare").textContent = "Nu am putut deschide sesiunea: " + err.message; return; }
    trimis = raspuns && raspuns.status === "submitted";

    $("j-stare").hidden = true; $("j-wrap").hidden = false;
    $("j-titlu").textContent = sesiune.titlu;
    $("j-meta").textContent = [sesiune.rasa, sesiune.grupa, sesiune.nivel, sesiune.wdfStandard ? "Standard WDF " + (sesiune.wdfStandard.versiune || "") : ""].filter(Boolean).join(" · ");
    if (sesiune.descriere) $("j-desc").textContent = sesiune.descriere;
    if (sesiune.obiective) { $("j-obj").hidden = false; $("j-obj-text").textContent = sesiune.obiective; }

    // imagini (fetch gated)
    for (const im of sesiune.imagini || []) {
      const holder = document.createElement("div"); holder.className = "j-img";
      holder.textContent = "Se încarcă imaginea…";
      $("j-imagini").appendChild(holder);
      try {
        const d = await api("jcr-resurse", { actiune: "imagine", cid, id, mediaId: im.mediaId });
        holder.innerHTML = ""; const img = document.createElement("img"); img.src = d.dataUrl; img.alt = im.alt || "Resursă de analiză"; img.loading = "lazy";
        holder.appendChild(img);
      } catch (e) { holder.textContent = "Imaginea nu a putut fi încărcată."; }
    }

    // calificativ
    CALIF.forEach((c) => { const o = document.createElement("option"); o.value = c; o.textContent = c; $("f-calificativ").appendChild(o); });

    // observații pe criterii (rubrică)
    const obsInputs = {};
    if ((sesiune.criterii || []).length) {
      sesiune.criterii.forEach((c) => {
        const row = document.createElement("label"); row.className = "j-field";
        row.innerHTML = "<span>" + esc(c.eticheta) + (c.zona ? " <em>(" + esc(c.zona) + ")</em>" : "") + "</span>";
        const ta = document.createElement("textarea"); ta.rows = 2; ta.dataset.criteriu = c.id;
        row.appendChild(ta); $("f-observatii").appendChild(row); obsInputs[c.id] = ta;
      });
    } else { $("f-obs-wrap").hidden = true; }

    // clasament (dacă ≥2 exemplare)
    const rankInputs = {};
    if ((sesiune.exemplare || []).length >= 2) {
      $("f-clasament-wrap").hidden = false;
      sesiune.exemplare.forEach((e, i) => {
        const row = document.createElement("label"); row.className = "j-rank";
        row.innerHTML = "<span>" + esc(e.eticheta || ("Exemplar " + (i + 1))) + "</span>";
        const inp = document.createElement("input"); inp.type = "number"; inp.min = "1"; inp.max = String(sesiune.exemplare.length); inp.dataset.ex = e.id;
        row.appendChild(inp); $("f-clasament").appendChild(row); rankInputs[e.id] = inp;
      });
    }

    // defecte (rânduri dinamice)
    function randDefect(d) {
      const row = document.createElement("div"); row.className = "j-defect";
      row.innerHTML =
        '<input class="d-cod" placeholder="Cod defect (ex. muscatura)" />' +
        '<select class="d-grav">' + GRAV.map((g) => '<option value="' + g[0] + '">' + g[1] + '</option>').join("") + '</select>' +
        '<input class="d-zona" placeholder="Zonă (opțional)" />' +
        '<button type="button" class="btn btn--small btn--danger d-del">✕</button>';
      if (d) { row.querySelector(".d-cod").value = d.cod || ""; row.querySelector(".d-grav").value = d.gravitate || "minor"; row.querySelector(".d-zona").value = d.zona || ""; }
      row.querySelector(".d-del").addEventListener("click", () => row.remove());
      $("f-defecte").appendChild(row);
    }
    $("f-defect-add").addEventListener("click", () => randDefect());

    // pre-populează din schița existentă
    if (raspuns) {
      $("f-general").value = raspuns.observatiiGenerale || "";
      $("f-calitati").value = raspuns.calitati || "";
      $("f-calificativ").value = raspuns.calificativ || "";
      $("f-justificare").value = raspuns.justificare || "";
      (raspuns.defecte || []).forEach(randDefect);
      (raspuns.observatii || []).forEach((o) => { if (obsInputs[o.criteriuId]) obsInputs[o.criteriuId].value = o.text || ""; });
      (raspuns.clasament || []).forEach((exId, i) => { if (rankInputs[exId]) rankInputs[exId].value = i + 1; });
    }
    if (!(raspuns && raspuns.defecte && raspuns.defecte.length)) randDefect();

    // cronometru informativ
    let secunde = (raspuns && raspuns.timpLucratSec) || 0;
    if (sesiune.status === "published" && !trimis) {
      $("j-timer").hidden = false;
      if (sesiune.timpLimitaMin) $("j-timer-lim").textContent = "(recomandat: " + sesiune.timpLimitaMin + " min — informativ)";
      setInterval(() => { secunde++; $("j-timer-val").textContent = String(Math.floor(secunde / 60)).padStart(2, "0") + ":" + String(secunde % 60).padStart(2, "0"); }, 1000);
    }

    function culege() {
      const defecte = [...document.querySelectorAll(".j-defect")].map((r) => ({ cod: r.querySelector(".d-cod").value.trim(), gravitate: r.querySelector(".d-grav").value, zona: r.querySelector(".d-zona").value.trim() })).filter((d) => d.cod);
      const observatii = Object.entries(obsInputs).map(([cid2, ta]) => ({ criteriuId: cid2, text: ta.value.trim() })).filter((o) => o.text);
      const clasament = Object.entries(rankInputs).map(([exId, inp]) => ({ exId, r: +inp.value || 999 })).sort((a, b) => a.r - b.r).filter((x) => x.r < 999).map((x) => x.exId);
      return {
        observatiiGenerale: $("f-general").value, calitati: $("f-calitati").value,
        defecte, observatii, clasament, calificativ: $("f-calificativ").value,
        justificare: $("f-justificare").value, timpLucratSec: secunde,
      };
    }

    function blocheaza() {
      $("f-actiuni").hidden = true; $("f-lock").hidden = false;
      $("j-form").querySelectorAll("input,select,textarea,button").forEach((el) => (el.disabled = true));
    }
    if (trimis || sesiune.status !== "published") blocheaza();

    async function salveaza(actiune) {
      const msg = $("f-msg"); msg.hidden = true;
      try {
        const d = await api("jcr-raspuns", { actiune, cid, id, raspuns: culege() });
        raspuns = d.raspuns;
        msg.className = "j-form__msg is-ok"; msg.hidden = false;
        msg.textContent = actiune === "trimite" ? "✓ Evaluarea a fost trimisă." : "✓ Schița a fost salvată.";
        if (actiune === "trimite") { trimis = true; blocheaza(); }
      } catch (err) { msg.className = "j-form__msg is-err"; msg.hidden = false; msg.textContent = err.message; }
    }
    $("f-schita").addEventListener("click", () => salveaza("schita"));
    $("j-form").addEventListener("submit", (e) => { e.preventDefault(); if (confirm("Trimiți evaluarea? După trimitere nu mai poate fi modificată.")) salveaza("trimite"); });
  })();
</script>

<style>
  .j-eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; color: var(--color-accent-dark); margin: 0; }
  .j-title { font-family: var(--font-serif); color: var(--color-primary); margin: 0.35rem 0 0.35rem; }
  .j-meta { font-size: 0.9rem; color: var(--color-text-muted); margin: 0 0 0.5rem; }
  .j-desc { color: var(--color-text); max-width: 48rem; }
  .j-actiuni { margin: 0 0 1rem; }
  .j-stare { color: var(--color-text-muted); font-style: italic; }
  .j-h2 { font-family: var(--font-serif); color: var(--color-primary); font-size: 1.2rem; border-bottom: 2px solid var(--color-accent); padding-bottom: 0.3rem; margin: 0 0 1rem; }
  .j-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.5rem; align-items: start; }
  @media (max-width: 820px) { .j-grid { grid-template-columns: 1fr; } }
  .j-resurse { position: sticky; top: 1rem; }
  .j-imagini { display: grid; gap: 0.75rem; }
  .j-img { background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--radius); min-height: 8rem; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); overflow: hidden; }
  .j-img img { width: 100%; height: auto; display: block; }
  .j-obj { margin-top: 1rem; background: var(--color-surface-alt); border-radius: var(--radius); padding: 0.75rem 1rem; }
  .j-obj h3 { margin: 0 0 0.3rem; font-size: 0.95rem; color: var(--color-primary); }
  .j-obj p { margin: 0; font-size: 0.9rem; }
  .j-timer { margin-top: 1rem; font-size: 0.9rem; color: var(--color-accent-dark); }
  .j-form { display: flex; flex-direction: column; gap: 1rem; }
  .j-field { display: flex; flex-direction: column; gap: 0.3rem; }
  .j-field > span { font-weight: 600; font-size: 0.9rem; }
  .j-field textarea, .j-field select, .j-defect input, .j-defect select, .j-rank input {
    padding: 0.55rem 0.7rem; border: 1px solid var(--color-border); border-radius: var(--radius); font: inherit; width: 100%;
  }
  .j-fieldset { border: 1px solid var(--color-border); border-radius: var(--radius); padding: 0.9rem; }
  .j-fieldset legend { font-weight: 700; font-size: 0.9rem; padding: 0 0.4rem; color: var(--color-primary); }
  .j-defect { display: grid; grid-template-columns: 1fr auto 1fr auto; gap: 0.5rem; margin-bottom: 0.5rem; align-items: center; }
  @media (max-width: 560px) { .j-defect { grid-template-columns: 1fr 1fr; } }
  .j-rank { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.4rem; }
  .j-rank input { width: 5rem; }
  .j-form__actiuni { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .j-form__msg { padding: 0.6rem 0.9rem; border-radius: var(--radius); }
  .j-form__msg.is-ok { background: #eaf5ec; border: 1px solid #b6dcbf; color: #1f5130; }
  .j-form__msg.is-err { background: #fbeaec; border: 1px solid #e2b6bd; color: #8c1d2f; }
  .j-form__lock { color: var(--color-text-muted); font-style: italic; }
  .btn--small { font-size: 0.85rem; padding: 0.4rem 0.8rem; }
  .btn--danger { color: #8c1d2f; }
</style>
