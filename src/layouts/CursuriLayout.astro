---
// CursuriLayout.astro — învelișul platformei de cursuri (Școala de Arbitraj).
// Separat de BaseLayout: fără meniul site-ului, fără indexare (noindex + pagefind-ignore).
//
// POARTA DE ACCES: pagina se deschide pe baza ROLULUI stabilit de server la intrare
// (funcția `acces-cursuri`). NU mai punem amprente de coduri în HTML — erau publice și
// permiteau spargerea offline a unui cod scurt. Rolul nu e secret, deci poate sta în pagină.
//
// Autoritatea reală rămâne, ca până acum, pe server: fiecare funcție își verifică
// singură codul. Poarta de aici doar îndrumă utilizatorul spre zona lui.
//
// `allow` acceptă: "admin" · "lector" (oricare) · "lector:<slug>" · "arbitru" (membru al
// Colegiului care nu e lector — acces de studiu) · "acces" (codul comun).
// Administratorul intră peste tot, fără să fie trecut explicit.
import "../styles/global.css";
// Cadrul (antet · coloană centrată · subsol) e comun cu Registrul genealogic — vezi panou.css.
import "../styles/panou.css";

interface Props {
  title: string;
  /** Rolurile care deblochează pagina. Lipsă = pagină publică (ex. intrarea). */
  allow?: string[];
  /** Pagină deschisă candidaților (orice cod individual valid) — și administratorului. */
  candidat?: boolean;
}
const { title, allow, candidat } = Astro.props;
const allowList = allow ?? [];
const candidatOk = !!candidat;
const protejat = allowList.length > 0 || candidatOk;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1F4D3A" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <title>{title} — Școala de Arbitraj CFC-Royal</title>
    {protejat && (
      <script is:inline define:vars={{ allow: allowList, candidatOk }}>
        // Poartă de acces: fără rolul potrivit, înapoi la intrare.
        try {
          let ok = false;
          let r = null;
          try { r = JSON.parse(localStorage.getItem("cfcrRol") || "null"); } catch (e) {}

          // Rolurile cu drepturi de administrare expiră după 12 ore, ca în registru și
          // ca sesiunea managerului. Candidații și arbitrii NU: ei doar învață și își
          // văd propriul dosar, iar un termen scurt i-ar goni de la studiu. La expirare
          // se șterge doar rolul — codul se scrie din nou și gata.
          if (r && (r.rol === "admin" || r.rol === "lector")) {
            const la = Date.parse(localStorage.getItem("cfcrRolLa") || "");
            if (!Number.isFinite(la) || Date.now() - la > 12 * 3600e3) {
              localStorage.removeItem("cfcrRol");
              localStorage.removeItem("cfcrRolLa");
              localStorage.removeItem("cfcrAccesCod");
              r = null;
            }
          }

          if (r && r.rol) {
            if (r.rol === "admin") ok = true;                                   // adminul intră peste tot
            else if (r.rol === "lector") {
              ok = allow.includes("lector") || allow.includes("lector:" + r.slug);
            } else if (r.rol === "arbitru") {
              ok = allow.includes("arbitru");
            } else if (r.rol === "acces") {
              ok = candidatOk || allow.includes("acces");
            }
          }
          // Candidat cu cod individual.
          let plecatLaReintra = false;
          if (!ok && candidatOk) {
            let cj = null;
            try { cj = JSON.parse(localStorage.getItem("cfcrCandidat") || "null"); } catch (e) {}
            if (cj && cj.id) {
              if (cj.cod) {
                ok = true;
              } else {
                // Sesiune de candidat mai veche, dinainte ca intrarea să rețină și codul:
                // fără el, testele nu se mai pot corecta, iar fiecare încercare consumă din
                // limita de încercări. O curățăm și trimitem omul să reintre cu codul actual.
                localStorage.removeItem("cfcrCandidat");
                location.replace("/cursuri/?motiv=sesiune");
                plecatLaReintra = true;
              }
            }
          }
          if (!ok && !plecatLaReintra) location.replace("/cursuri/");

          // ——— Poarta Codului Etic (23.08.2026) ———
          // Candidații, arbitrii și lectorii intră în formare DOAR cu versiunea curentă
          // a Codului asumată. Rămân libere: pagina de asumare însăși, examenul (pentru
          // dreptul de contestație — acțiunile de formare sunt oricum refuzate de server),
          // buletinul și actele deja emise. Adminul și codul comun nu au dosar personal.
          // FAIL-OPEN: dacă starea nu se poate citi, nu blocăm din browser — poarta
          // adevărată e pe server, la fiecare acțiune de formare.
          if (ok) {
            const LIBERE = ["/cursuri/cod-etic/", "/cursuri/examen/", "/cursuri/buletin/", "/cursuri/act/"];
            const aici = location.pathname.endsWith("/") ? location.pathname : location.pathname + "/";
            const eAdmin = r && r.rol === "admin";
            let dejaOk = null;
            try { dejaOk = sessionStorage.getItem("cfcrEticOk"); } catch (e) {}
            if (!eAdmin && !dejaOk && !LIBERE.some((p) => aici.startsWith(p))) {
              const acr = {};
              try { const cj = JSON.parse(localStorage.getItem("cfcrCandidat") || "null"); if (cj && cj.cod) acr.cid = cj.cod; } catch (e) {}
              try { const c = localStorage.getItem("cfcrAccesCod"); if (c) acr.cod = c; } catch (e) {}
              fetch("/.netlify/functions/cod-etic", {
                method: "POST", headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ...acr, actiune: "stare" }),
              })
                .then((rr) => rr.json())
                .then((d) => {
                  if (d.anonim || d.asumat) {
                    try { sessionStorage.setItem("cfcrEticOk", d.versiune || "da"); } catch (e) {}
                    return;
                  }
                  location.replace("/cursuri/cod-etic/?de=" + encodeURIComponent(location.pathname));
                })
                .catch(() => {});
            }
          }
        } catch (e) {
          location.replace("/cursuri/");
        }
      </script>
    )}
  </head>
  <body data-pagefind-ignore>
    {/* A DOUA CHEIE, pusă într-un singur loc.
        Platforma are peste douăzeci de locuri care trimit codul către funcții, în
        paisprezece pagini. Adăugarea jetonului în fiecare ar fi însemnat douăzeci de
        ocazii de a greși — și chiar am greșit de două ori azi, în felul ăsta.
        Aici, orice cerere care duce un `cod` primește automat și `dispozitiv`.
        Registrul face acelaşi lucru pe față, în fiecare pagină: acolo sunt cinci locuri,
        aici sunt douăzeci. */}
    <script is:inline>
      (function () {
        const original = window.fetch;
        let plecam = false;

        // SESIUNE MOARTĂ = IEȘIRE. Când codul păstrat local a fost între timp schimbat
        // sau revocat, fiecare cerere ar primi 401, iar limitarea de încercări le-ar
        // număra pe toate — până blochează adresa omului, cu tot cu codul lui NOU.
        // La prima acreditare respinsă pe codul din localStorage, ștergem sesiunea și
        // ducem omul la formular. Doar pentru codul PĂSTRAT: cine tastează un cod greșit
        // în formularul de intrare nu are ce sesiune să piardă.
        // Codul păstrat local, oricare ar fi felul intrării: fie codul de acces
        // (admin/lector/cod comun), fie codul unui candidat cu cod individual. Fără
        // ramura candidatului, un candidat cu cod schimbat/revocat primea 401 la fiecare
        // trimitere de test, la nesfârșit — și fiecare 401 îi număra o încercare la
        // limitator, până îi bloca IP-ul (cu tot cu codul lui nou).
        function codPastrat() {
          const acces = localStorage.getItem("cfcrAccesCod");
          if (acces) return acces;
          try { const c = JSON.parse(localStorage.getItem("cfcrCandidat") || "null"); if (c && c.cod) return c.cod; } catch (e) {}
          return null;
        }
        function sesiuneMoarta(codTrimis, raspuns, text) {
          if (raspuns.status !== 401 && raspuns.status !== 403) return false;
          if (raspuns.status === 403 && text.indexOf("Dispozitiv nerecunoscut") === -1) return false;
          const pastrat = codPastrat();
          return !!pastrat && codTrimis === pastrat;
        }

        window.fetch = async function (intrare, optiuni) {
          let codTrimis = null;
          let cerere = [intrare, optiuni];
          try {
            const o = optiuni || {};
            const adresa = typeof intrare === "string" ? intrare : (intrare && intrare.url) || "";
            // Doar cererile noastre, doar cele cu corp text care poartă un cod.
            if (adresa.indexOf("/.netlify/functions/") !== -1 && typeof o.body === "string") {
              const d = JSON.parse(o.body);
              if (d && typeof d === "object" && d.cod) {
                codTrimis = d.cod;
                if (!d.dispozitiv) {
                  d.dispozitiv = localStorage.getItem("cfcrScoalaDispozitiv") || "";
                  cerere = [intrare, Object.assign({}, o, { body: JSON.stringify(d) })];
                }
              }
            }
          } catch (e) { /* corp care nu e JSON: îl lăsăm exact cum a venit */ }

          const raspuns = await original(cerere[0], cerere[1]);
          try {
            if (!plecam && codTrimis) {
              const text = raspuns.status === 403 ? await raspuns.clone().text() : "";
              if (sesiuneMoarta(codTrimis, raspuns, text)) {
                plecam = true;
                try {
                  localStorage.removeItem("cfcrRol");
                  localStorage.removeItem("cfcrRolLa");
                  localStorage.removeItem("cfcrAccesCod");
                  localStorage.removeItem("cfcrCandidat");
                } catch (e) {}
                location.replace("/cursuri/?motiv=sesiune");
              }
            }
          } catch (e) { /* orice greșeală aici nu are voie să strice răspunsul */ }
          return raspuns;
        };
      })();
    </script>

    <script is:inline>
      // ——— Materialele de curs: linkuri care trec prin poartă ———
      //
      // Suporturile lectorilor nu mai stau în `public/`: se puteau descărca de oricine le
      // nimerea adresa, deși paginile astea au poartă de rol. Acum le dă funcția
      // `material-curs`, după verificarea codului — iar linkul din pagină arată la fel,
      // dar duce prin ea.
      //
      // Fereastra se deschide ÎNAINTE de cerere, nu după: un `window.open` de după un
      // `await` e blocat de browsere ca fereastră nesolicitată, iar omul ar apăsa pe un
      // link care nu face nimic.
      (function () {
        function codPlatforma() {
          try {
            var a = localStorage.getItem("cfcrAccesCod");
            if (a) return { cod: a };
            var c = JSON.parse(localStorage.getItem("cfcrCandidat") || "null");
            if (c && c.cod) return { cid: c.cod };
          } catch (e) {}
          return null;
        }

        window.deschideMaterialCurs = async function (cale, fereastra) {
          var acr = codPlatforma();
          if (!acr) { location.href = "/cursuri/?motiv=sesiune"; return; }
          try {
            var r = await fetch("/.netlify/functions/material-curs", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(Object.assign({ actiune: "fisier", fisier: cale }, acr)),
            });
            if (!r.ok) throw new Error("stare " + r.status);
            var blob = await r.blob();
            var adresa = URL.createObjectURL(blob);
            if (fereastra) fereastra.location = adresa;
            else window.open(adresa, "_blank", "noopener");
            // Eliberăm adresa după ce fereastra a apucat s-o citească.
            setTimeout(function () { URL.revokeObjectURL(adresa); }, 60000);
          } catch (e) {
            if (fereastra) try { fereastra.close(); } catch (e2) {}
            alert("Materialul nu s-a putut deschide acum. Reîncearcă peste câteva momente.");
          }
        };

        document.addEventListener("click", function (ev) {
          var a = ev.target && ev.target.closest ? ev.target.closest('a[href^="/cursuri-materiale/"]') : null;
          if (!a) return;
          ev.preventDefault();
          var f = window.open("", "_blank");
          window.deschideMaterialCurs(a.getAttribute("href"), f);
        });
      })();
    </script>
    <header class="c-header">
      <div class="c-header__inner">
        <a class="c-brand" href="/cursuri/">
          <img src="/images/centrul-competentelor.webp" alt="Centrul de Dezvoltare a Competențelor Chinologice" width="56" height="60" loading="eager" />
          <span class="c-brand__text">
            <strong>Școala de Arbitraj</strong>
            <span>Centrul de Dezvoltare a Competențelor Chinologice · CFC-Royal</span>
          </span>
        </a>
        <div class="c-header__actions">
          <a class="c-sitelink" href="/ro/">← Site-ul asociației</a>
          {protejat && (
            <button class="c-logout" id="c-logout" type="button">Ieșire</button>
          )}
        </div>
      </div>
    </header>

    <main class="c-main">
      <slot />
    </main>

    <footer class="c-footer">
      <p>© Asociația Club Federal Chinologic – Royal · membru World Dog Federation · <a href="/ro/">cfc-royal.ro</a></p>
    </footer>

    {protejat && (
      <script is:inline>
        document.getElementById("c-logout")?.addEventListener("click", () => {
          try {
            try { sessionStorage.removeItem("cfcrEticOk"); } catch (e) {}
            localStorage.removeItem("cfcrRol");
            localStorage.removeItem("cfcrRolLa");
            localStorage.removeItem("cfcrAcces"); // cheie veche (curățare)
            localStorage.removeItem("cfcrAccesCod");
            localStorage.removeItem("cfcrCandidat");
            // Și a doua cheie: „Ieșire" pe un calculator străin trebuie să șteargă tot.
            localStorage.removeItem("cfcrScoalaDispozitiv");
          } catch (e) {}
          location.href = "/cursuri/";
        });
      </script>
    )}
  </body>
</html>
